<%- include('../partials/head') %>
<%- include('../partials/header-modules') %>
<%- include('../partials/module-subnav', { activePage: page.slug }) %>
<main class="entity-page module-master-list-page">
  <section class="entity-toolbar module-master-toolbar app-container">
    <div class="entity-title"><span><%= module.label %></span><b>/</b><strong><%= page.label %></strong></div>
    <label class="toolbar-search module-master-search">
      <%- include('../partials/icon', { name: 'search' }) %>
      <input id="module-search" type="search" placeholder="Cari data..." aria-label="Cari <%= page.label %>">
    </label>
    <div class="toolbar-spacer"></div>
    <%- include('../partials/view-switcher') %>
    <button id="module-export" class="btn btn-export" type="button">Export CSV</button>
    <% if (page.createRoute) { %>
      <a class="btn btn-primary brand-button" href="<%= page.createRoute %>"><%- include('../partials/icon', { name: 'plus' }) %> Tambah Baru</a>
    <% } %>
  </section>
  <% if (!page.apiReady) { %>
    <section class="api-notice mx-4 mt-3"><span>Belum tersedia</span><div><b>API <%= page.label %> belum tersedia</b></div></section>
  <% } %>
  <div id="module-alert" class="alert alert-warning mx-4 mt-3 d-none" role="alert"></div>
  <section id="module-list-root" class="table-shell entity-table-shell module-master-table">
    <div class="list-table-view">
      <table id="module-table" class="table align-middle w-100">
        <thead><tr><% page.columns.forEach(column => { %><th><%= column.label %></th><% }) %><th>AKSI</th></tr></thead>
      </table>
    </div>
    <div class="list-gallery is-hidden" aria-live="polite"></div>
  </section>
</main>
<div class="modal fade" id="module-detail-modal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5">Detail <%= page.label %></h2><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body" id="module-detail-body"></div></div></div></div>
<script id="module-page-config" type="application/json"><%- JSON.stringify({ module: module.slug, moduleLabel: module.label, ...page }).replace(/</g, '\\u003c') %></script>
<%- include('../partials/footer') %>
