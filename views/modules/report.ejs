<%- include('../partials/head') %>
<%- include('../partials/header-modules') %>
<%- include('../partials/module-subnav', { activePage: page.slug }) %>
<main class="entity-page report-page module-report-page">
  <section class="entity-toolbar report-master-toolbar app-container">
    <div class="enterprise-page-heading"><span><%= module.label %></span><h1><%= page.label %></h1><p><%= page.description %></p></div>
    <label class="toolbar-search report-master-search"><%- include('../partials/icon', { name: 'search' }) %><input id="report-search" type="search" placeholder="Cari nomor, part, customer, lot..."></label>
    <% if (page.reportMode === 'production-machine') { %>
      <label class="report-toolbar-field"><span>Bulan</span><input id="report-month" type="month" value="<%= new Date().toISOString().slice(0, 7) %>"></label>
      <label class="report-toolbar-field"><span>Mesin</span><select id="report-machine"><option value="">Semua mesin</option></select></label>
    <% } %>
    <div class="toolbar-spacer"></div>
    <%- include('../partials/view-switcher') %>
    <div class="dropdown enterprise-more-actions">
      <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">More Actions</button>
      <div class="dropdown-menu dropdown-menu-end"><button id="report-refresh" class="dropdown-item" type="button">Refresh</button><button id="report-export" class="dropdown-item" type="button">Export CSV</button></div>
    </div>
    <button class="btn btn-primary brand-button" type="button" onclick="window.print()">Cetak</button>
  </section>
  <% if (!page.apiReady) { %><section class="api-notice mx-4 mt-3"><span>Belum tersedia</span><div><b>Endpoint laporan belum tersedia</b></div></section><% } %>
  <div id="report-alert" class="alert alert-warning mx-4 mt-3 d-none" role="alert"></div>
  <div class="report-content app-container">
    <section class="report-stat-grid">
      <% for (let index = 0; index < 4; index += 1) { %>
        <article><small id="report-label-<%= index %>">Memuat</small><strong id="report-value-<%= index %>">—</strong><span id="report-note-<%= index %>">Data terkini</span></article>
      <% } %>
    </section>
    <section class="report-panels report-panels--p2">
      <article><div><h2>Analitik &amp; Perbandingan</h2><p><%= page.reportMode === 'production-machine' ? 'Perbandingan output, good, NG, dan downtime per mesin.' : 'Ringkasan berdasarkan filter aktif.' %></p></div><div id="report-chart"></div></article>
      <article class="report-insight-panel"><div><h2><%= page.reportMode === 'production-machine' ? 'Ringkasan Produksi' : 'Audit Coverage' %></h2><p><%= page.reportMode === 'production-machine' ? 'Gross time dikurangi seluruh downtime menjadi net process time.' : 'Readiness, missing cost, aging, atau gap data tanpa mengubah transaksi existing.' %></p></div><div id="report-insights" class="report-insights"><span>Memuat insight...</span></div></article>
    </section>
  </div>
  <% if (page.reportMode === 'inventory-traceability') { %>
  <section class="table-shell entity-table-shell report-detail-card inventory-trace-card">
    <header class="ops-card-head app-container"><div><h2>Traceability Stock per FG COMP</h2><p>Ready FG ditampilkan terpisah dari child FG, WIP proses, material, dan purchase part sesuai MBOM bertingkat aktif.</p></div><div class="d-flex align-items-center gap-2"><span id="inventory-trace-count" class="ops-live-label"><i></i> Memuat</span><button id="inventory-trace-export" class="btn btn-outline-secondary btn-sm" type="button">Export Traceability</button></div></header>
    <div class="list-table-view">
      <table class="table align-middle w-100 report-detail-table inventory-trace-table"><thead><tr><th>FG COMP</th><th>MBOM</th><th>Ready FG</th><th>Child FG</th><th>WIP</th><th>Material / Part</th><th>Status</th><th>Trace</th></tr></thead><tbody id="inventory-trace-rows"><tr><td colspan="8" class="text-center p-4">Memuat traceability...</td></tr></tbody></table>
    </div>
  </section>
  <% } %>
  <section id="report-list-root" class="table-shell entity-table-shell report-detail-card report-master-table">
    <header class="ops-card-head app-container"><div><h2>Detail <%= page.label %></h2><p>Data dapat dicari, dicetak, dan diekspor untuk rekonsiliasi.</p></div><span id="report-count" class="ops-live-label"><i></i> Memuat</span></header>
    <div class="list-table-view">
      <table class="table align-middle w-100 report-detail-table"><thead><tr><% (page.reportColumns || []).forEach(column => { %><th><%= column.label %></th><% }) %></tr></thead><tbody id="report-rows"><tr><td colspan="<%= Math.max((page.reportColumns || []).length, 1) %>" class="text-center p-4">Memuat laporan...</td></tr></tbody></table>
    </div>
    <div class="list-gallery is-hidden" aria-live="polite"></div>
  </section>
</main>
<script id="module-page-config" type="application/json"><%- JSON.stringify({ module: module.slug, ...page }).replace(/</g, '\\u003c') %></script>
<%- include('../partials/footer') %>
