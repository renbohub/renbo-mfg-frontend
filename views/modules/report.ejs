<%- include('../partials/head') %>
<%- include('../partials/header-modules') %>
<%- include('../partials/module-subnav', { activePage: page.slug }) %>
<main class="entity-page report-page module-report-page">
  <section class="entity-toolbar report-master-toolbar app-container">
    <div class="enterprise-page-heading"><span><%= module.label %></span><h1><%= page.label %></h1><p><%= page.description %></p></div>
    <label class="toolbar-search report-master-search"><%- include('../partials/icon', { name: 'search' }) %><input id="report-search" type="search" placeholder="<%= page.reportMode === 'inventory-traceability' ? 'Cari FG, child part, material, atau proses...' : 'Cari nomor, part, customer, lot...' %>"></label>
    <% if (page.reportMode === 'production-machine') { %>
      <label class="report-toolbar-field"><span>Bulan</span><input id="report-month" type="month" value="<%= new Date().toISOString().slice(0, 7) %>"></label>
      <label class="report-toolbar-field"><span>Mesin</span><select id="report-machine"><option value="">Semua mesin</option></select></label>
    <% } %>
    <div class="toolbar-spacer"></div>
    <%- include('../partials/view-switcher') %>
    <div class="dropdown enterprise-more-actions">
      <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">More Actions</button>
      <div class="dropdown-menu dropdown-menu-end"><button id="report-refresh" class="dropdown-item" type="button">Refresh</button><button id="report-export" class="dropdown-item" type="button">Export CSV</button></div>
    </div>
    <button class="btn btn-primary brand-button" type="button" onclick="window.print()">Cetak</button>
  </section>
  <% if (!page.apiReady) { %><section class="api-notice mx-4 mt-3"><span>Belum tersedia</span><div><b>Endpoint laporan belum tersedia</b></div></section><% } %>
  <div id="report-alert" class="alert alert-warning mx-4 mt-3 d-none" role="alert"></div>
  <div class="report-content app-container">
    <section class="report-stat-grid">
      <% for (let index = 0; index < 4; index += 1) { %>
        <article><small id="report-label-<%= index %>">Memuat</small><strong id="report-value-<%= index %>">—</strong><span id="report-note-<%= index %>">Data terkini</span></article>
      <% } %>
    </section>
    <section class="report-panels report-panels--p2">
      <article><div><h2>Analitik &amp; Perbandingan</h2><p><%= page.reportMode === 'production-machine' ? 'Perbandingan output, good, NG, dan downtime per mesin.' : 'Ringkasan berdasarkan filter aktif.' %></p></div><div id="report-chart"></div></article>
      <article class="report-insight-panel"><div><h2><%= page.reportMode === 'production-machine' ? 'Ringkasan Produksi' : 'Audit Coverage' %></h2><p><%= page.reportMode === 'production-machine' ? 'Gross time dikurangi seluruh downtime menjadi net process time.' : 'Readiness, missing cost, aging, atau gap data tanpa mengubah transaksi existing.' %></p></div><div id="report-insights" class="report-insights"><span>Memuat insight...</span></div></article>
    </section>
  </div>
  <section id="report-list-root" class="table-shell entity-table-shell report-detail-card report-master-table">
    <header class="ops-card-head app-container"><div><h2>Detail <%= page.label %></h2><p><%= page.reportMode === 'inventory-traceability' ? 'Pilih FG untuk melihat resume stok seluruh child part, WIP, material, dan purchase part dari BOM aktif.' : 'Data dapat dicari, dicetak, dan diekspor untuk rekonsiliasi.' %></p></div><span id="report-count" class="ops-live-label"><i></i> Memuat</span></header>
    <% if (page.reportMode === 'inventory-traceability') { %>
    <div class="inventory-detail-controls app-container">
      <label class="inventory-detail-field inventory-detail-field--fg"><span>Finished Goods (FG)</span><select id="inventory-fg-select"><option value="">Pilih FG...</option></select></label>
      <label class="inventory-detail-field"><span>Cari detail</span><input id="inventory-detail-search" type="search" placeholder="Part code, part number, material, proses..."></label>
      <label class="inventory-detail-field"><span>Grouping</span><select id="inventory-detail-group"><option value="stockType">Stock Type</option><option value="process">Process</option><option value="level">Level BOM</option><option value="none">Tanpa grouping</option></select></label>
      <div class="inventory-detail-export-actions" aria-label="Export Inventory Report">
        <button id="inventory-detail-xlsx" class="btn btn-outline-success" type="button" disabled>XLSX Lengkap</button>
        <button id="inventory-detail-pdf" class="btn btn-outline-danger" type="button" disabled>PDF Detail</button>
        <button id="inventory-matrix-open" class="btn btn-primary" type="button" disabled>Report Matrix</button>
      </div>
    </div>
    <div id="inventory-fg-resume" class="inventory-fg-resume app-container d-none"></div>
    <% } %>
    <div class="list-table-view">
      <% if (page.reportMode === 'inventory-traceability') { %>
      <table class="table align-middle w-100 report-detail-table inventory-detail-table" data-enterprise-export="off"><thead><tr><th>Stock Type</th><th>Process Terkait</th><th>Part Code (BOM)</th><th>Part No. / Nama</th><th>Material Type / Spec</th><th>Level</th><th>Kebutuhan / FG</th><th>GW / PCS</th><th>On Hand KG</th><th>On Hand PCS</th><th>Reserved KG</th><th>Reserved PCS</th><th>Available KG</th><th>Available PCS</th><th>Status</th></tr></thead><tbody id="report-rows"><tr><td colspan="15" class="text-center p-4">Pilih FG untuk menampilkan detail inventory.</td></tr></tbody></table>
      <% } else { %>
      <table class="table align-middle w-100 report-detail-table"><thead><tr><% (page.reportColumns || []).forEach(column => { %><th><%= column.label %></th><% }) %></tr></thead><tbody id="report-rows"><tr><td colspan="<%= Math.max((page.reportColumns || []).length, 1) %>" class="text-center p-4">Memuat laporan...</td></tr></tbody></table>
      <% } %>
    </div>
    <div class="list-gallery is-hidden" aria-live="polite"></div>
  </section>
  <% if (page.reportMode === 'inventory-traceability') { %>
  <dialog id="inventory-matrix-dialog" class="inventory-matrix-dialog">
    <div class="inventory-matrix-dialog-head"><div><small>MANAGEMENT STOCK SNAPSHOT</small><h2 id="inventory-matrix-title">Inventory Matrix</h2><p id="inventory-matrix-subtitle"></p></div><button id="inventory-matrix-close" type="button" aria-label="Tutup">&times;</button></div>
    <div class="inventory-matrix-table-wrap"><table class="inventory-matrix-table" data-enterprise-export="off"><thead id="inventory-matrix-head"></thead><tbody id="inventory-matrix-body"></tbody></table></div>
    <footer><small>Raw material memakai KG dan ekuivalen PCS. Stock Reserved = reservasi fisik; Stock Allocation = pegging barang yang sudah diterima; Purchase Allocation = reserve MOQ yang masih pada purchase suggestion.</small><div><button id="inventory-matrix-xlsx" class="btn btn-outline-success" type="button">Download XLSX Matrix</button><button id="inventory-matrix-pdf" class="btn btn-danger" type="button">Download PDF Matrix</button></div></footer>
  </dialog>
  <style>
    .inventory-matrix-table { width: max-content; min-width: 100%; table-layout: auto; }
    .inventory-matrix-table th, .inventory-matrix-table td { min-width: 88px; white-space: nowrap; }
    .inventory-matrix-table th:first-child, .inventory-matrix-table td:first-child { width: auto; min-width: 150px; }
    .inventory-matrix-table th:nth-child(2), .inventory-matrix-table td:nth-child(2) { min-width: 150px; text-align: left; }
    .inventory-matrix-table th:nth-child(3), .inventory-matrix-table td:nth-child(3) { min-width: 140px; text-align: left; }
  </style>
  <% } %>
</main>
<script id="module-page-config" type="application/json"><%- JSON.stringify({ module: module.slug, ...page }).replace(/</g, '\\u003c') %></script>
<%- include('../partials/footer') %>
