<%- include('../partials/head') %>
<%- include('../partials/header-modules') %>
<%- include('../partials/bom-subnav', { activeBomTab: 'list', recordKey: '' }) %>
<main class="bom-figma-page">
  <section class="bom-figma-toolbar app-container">
    <nav class="bom-crumb"><span>Master Data</span><i>/</i><b>BOM List</b></nav>
    <label class="bom-figma-search"><span class="bom-search-kind">BOM⌄</span><span class="bom-search-divider"></span><%- include('../partials/icon', { name: 'search' }) %><input id="bom-search" type="search" placeholder="Cari data..."></label>
    <button class="bom-toolbar-button" type="button">☷ <span>Filter</span></button>
    <div class="bom-toolbar-spacer"></div>
    <div class="bom-view-toggles" aria-label="Pilihan tampilan"><button class="active" type="button" data-bom-view="table" title="Table">☷</button><button type="button" data-bom-view="kanban" title="Kanban">▦</button><button type="button" data-bom-view="gallery" title="Gallery">▤</button></div>
