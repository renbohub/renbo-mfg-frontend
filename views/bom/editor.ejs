<%- include('../partials/head') %>
<%- include('../partials/header-modules') %>
<%- include('../partials/module-subnav', { activePage: page.slug }) %>
<%- include('../partials/bom-subnav', { activeBomTab: 'generator', recordKey }) %>
<main class="bom-editor-page transaction-form-page" data-mode="<%= mode %>">
  <div class="app-container">
    <%
      const bomModeLabel = mode === 'create' ? 'BOM Generator' : mode === 'draft' ? 'Draft BOM' : mode === 'edit' ? 'Edit BOM' : 'Detail BOM';
      let bomEditorActions = mode === 'view' ? `<a class="btn btn-primary bom-primary" href="/modules/manufacturing-bom/bill-of-materials/${encodeURIComponent(recordKey)}/edit">Edit dengan Canvas</a>` : `<span id="bom-draft-status" class="bom-draft-status ${mode === 'draft' ? '' : 'd-none'}">${mode === 'draft' ? 'Draft tersimpan' : ''}</span><button id="bom-auto-layout" class="btn btn-outline-secondary" type="button">Auto Layout</button>${mode === 'create' ? '<button id="bom-make-draft" class="btn btn-primary bom-primary" type="button"><span>Make Draft</span><i class="spinner-border spinner-border-sm d-none"></i></button>' : ''}<button id="bom-save" class="btn btn-success ${mode === 'create' ? 'd-none' : ''}" type="button"><span>${mode === 'draft' ? 'Approve BOM' : 'Simpan BOM'}</span><i class="spinner-border spinner-border-sm d-none"></i></button>`;
    %>
    <%- include('../partials/document-shell', { documentShell: { variant: 'planning', eyebrow: `Manufacturing BOM · ${bomModeLabel}`, number: mode === 'create' ? 'NEW' : recordKey, title: mode === 'create' ? 'BOM Baru' : bomModeLabel, titleId: 'bom-page-title', subtitle: 'Bangun struktur komponen dan routing tanpa mengubah kalkulasi BOM.', actions: bomEditorActions, backHref: '/modules/manufacturing-bom/bill-of-materials', breadcrumbHtml: '<a href="/modules/manufacturing-bom/bill-of-materials">BOM List</a><span>/</span><strong>Canvas</strong>' } }) %>
  </div>
  <div id="bom-alert" class="alert alert-danger d-none mx-4 mt-3"></div>
  <section class="bom-header-form app-container">
    <div class="bom-header-field bom-header-product"><label>Produk Utama <em>*</em></label><select id="bom-root-part" class="form-select" data-enterprise-lookup="parts" data-value-key="id" data-label-key="partName" data-lookup-placeholder="Pilih produk utama" <%= mode === 'view' ? 'disabled' : '' %>><option value="">Memuat master part...</option></select></div>
    <div class="bom-header-field"><label>Base UOM</label><select id="bom-root-uom" class="form-select" data-enterprise-lookup="uom" data-value-key="uomCode" data-label-key="uomName" data-lookup-placeholder="Pilih UOM" <%= mode === 'view' ? 'disabled' : '' %>><option value="">Pilih UOM</option></select></div>
    <div class="bom-header-field"><label>Revisi</label><input id="bom-revision" class="form-control" type="number" min="1" value="1" <%= mode === 'view' || mode === 'edit' ? 'readonly' : '' %>></div>
    <% if (mode === 'edit') { %><div class="bom-header-field"><label>Cara Simpan</label><select id="bom-revision-mode" class="form-select"><option value="newRevision">Buat revisi baru</option><option value="correction">Koreksi revisi ini</option></select></div><div class="bom-header-field"><label>Catatan Revisi</label><input id="bom-revision-note" class="form-control" placeholder="Alasan perubahan struktur"></div><% } %>
    <div class="bom-header-field"><label>Effective Date</label><input id="bom-effective" class="form-control" type="date" <%= mode === 'view' ? 'disabled' : '' %>></div>
    <div class="bom-header-field"><label>Expiry Date</label><input id="bom-expiry" class="form-control" type="date" <%= mode === 'view' ? 'disabled' : '' %>></div>
    <button id="bom-toggle-notes" class="bom-notes-button" type="button">Catatan</button>
    <textarea id="bom-notes" class="form-control bom-header-notes d-none" rows="2" placeholder="Catatan BOM..." <%= mode === 'view' ? 'disabled' : '' %>></textarea>
  </section>
  <section class="bom-workspace">
    <aside class="bom-palette">
      <a class="bom-new-canvas" href="/modules/manufacturing-bom/bill-of-materials/new">＋ Buat BOM Baru</a>
      <div class="bom-library-label">BOM LIST</div>
      <div id="bom-recent-list" class="bom-recent-list"><div class="bom-panel-empty">Memuat BOM...</div></div>
      <div class="bom-library-label bom-part-library-label">DRAFT CANVAS</div>
      <div id="bom-draft-list" class="bom-recent-list"><div class="bom-panel-empty">Memuat draft...</div></div>
      <div class="bom-library-label bom-part-library-label">PART LIBRARY</div>
      <label class="bom-palette-search"><%- include('../partials/icon', { name: 'search' }) %><input id="bom-part-search" type="search" placeholder="Cari part..."></label>
      <div id="bom-part-palette" class="bom-part-list"><div class="bom-panel-empty">Memuat master part...</div></div>
    </aside>
    <div class="bom-canvas-shell">
      <div class="bom-canvas-tools"><span class="bom-pan-hint" title="Klik dan geser area kosong canvas">↔ Geser</span><button id="bom-zoom-out" type="button">−</button><span id="bom-zoom-label">100%</span><button id="bom-zoom-in" type="button">＋</button><button id="bom-fit" type="button">Fit</button></div>
      <div id="bom-canvas-viewport" class="bom-canvas-viewport" aria-label="Canvas BOM. Klik dan geser area kosong untuk memindahkan tampilan.">
        <div id="bom-canvas" class="bom-canvas"><svg id="bom-connectors" class="bom-connectors" aria-hidden="true"></svg><div id="bom-root-node" class="bom-node bom-root-node"><small>PRODUK UTAMA</small><b>Pilih produk utama</b><span class="bom-node-part-number">Part No: —</span><span>Root BOM</span></div><div id="bom-empty-canvas" class="bom-empty-canvas"><b>Mulai bangun struktur BOM</b><p>Klik part dari panel kiri atau gunakan tombol tambah pada node.</p></div></div>
      </div>
    </div>
    <aside id="bom-inspector" class="bom-inspector">
      <div class="bom-panel-heading"><h2>Inspector</h2><p id="bom-inspector-caption">Pilih node untuk mengubah detail.</p></div>
      <div id="bom-inspector-empty" class="bom-panel-empty">Belum ada node dipilih.</div>
      <form id="bom-inspector-form" class="d-none" onsubmit="return false">
        <% if (mode !== 'view') { %><section class="bom-inspector-add"><label>Tambah ke Canvas</label><div><button type="button" data-inspector-add="fg">＋ FG</button><button type="button" data-inspector-add="child">＋ Child Part</button><button type="button" data-inspector-add="purchase">＋ Purchase Part</button><button type="button" data-inspector-add="material">＋ Raw Material</button></div></section><% } %>
        <label>Part</label><select id="node-part" class="form-select" data-enterprise-lookup="parts" data-value-key="id" data-label-key="partName" data-lookup-placeholder="Pilih part"></select>
        <div class="bom-inspector-grid"><div><label>Qty</label><input id="node-qty" class="form-control" type="number" min="0.000001" step="0.000001"></div><div><label>UOM</label><select id="node-uom" class="form-select" data-enterprise-lookup="uom" data-value-key="uomCode" data-label-key="uomName" data-lookup-placeholder="Pilih UOM"></select></div></div>
        <label>Parent</label><select id="node-parent" class="form-select"></select>
        <label>Category</label><select id="node-category" class="form-select"><option>Purchase</option><option>inHouse</option><option>Vendor</option></select>
        <label>Assembly Policy</label><select id="node-policy" class="form-select"><option>DEFAULT</option><option>INLINE</option><option>SUB_ASSEMBLY</option></select>
        <div class="bom-inspector-grid"><div><label>Lead Time</label><input id="node-lead-time" class="form-control" type="number" min="0" step="0.01"></div><div><label>Satuan</label><select id="node-lead-time-unit" class="form-select"><option value="SECOND">Detik</option><option value="MINUTE">Menit</option><option value="HOUR">Jam</option><option value="DAY">Hari (8 jam kerja)</option></select></div></div>
        <section id="node-material-consumption" class="bom-material-consumption d-none">
          <div class="bom-material-heading"><div><small>RAW MATERIAL CONSUMPTION</small><b id="node-material-name">Material belum terhubung</b></div><a id="node-material-link" href="/master-data/materials">Master Material</a></div>
          <div class="bom-material-spec-grid"><label>Form Default<select id="node-material-form" class="form-select"><option value="">Pilih form</option></select></label><label>Skema Aktif<select id="node-material-scheme" class="form-select"><option value="DEFAULT">Default</option><option value="ALTERNATIVE">Alternatif</option></select></label><label>T (mm)<input id="node-material-thickness" class="form-control" readonly></label><label>W (mm)<input id="node-material-width" class="form-control" readonly></label><label>P / Pitch (mm)<input id="node-material-pitch" class="form-control" type="number" min="0" step="0.001"></label><label>Cavity<input id="node-material-cavity" class="form-control" type="number" min="1" step="1"></label><label>Density (kg/mm³)<input id="node-material-density" class="form-control" readonly></label><label>Gross Weight (kg/pcs)<input id="node-gross-weight" class="form-control" readonly></label><label>Form Alternatif<select id="node-material-alt-form" class="form-select"><option value="">Tidak digunakan</option></select></label><label>Pitch Alternatif<input id="node-material-alt-pitch" class="form-control" type="number" min="0" step="0.001"></label><label>Cavity Alternatif<input id="node-material-alt-cavity" class="form-control" type="number" min="1" step="1"></label><label>Gross Alternatif<input id="node-material-alt-gross" class="form-control" readonly></label></div>
          <small id="node-material-formula">Gross = T × W × P × Density ÷ Cavity</small>
        </section>
        <label>Catatan</label><textarea id="node-notes" class="form-control" rows="3"></textarea>
        <section class="bom-node-processes"><div class="bom-process-title"><label>Routing Proses</label><button id="node-add-process" type="button">＋ Proses</button></div><div id="node-process-list" class="bom-node-process-list"></div></section>
        <% if (mode !== 'view') { %><div class="bom-inspector-actions"><button id="node-insert-before" class="btn btn-outline-primary" type="button" title="Tambah proses/child tepat sebelum part terpilih">＋ Child di Atas</button><button id="node-add-child" class="btn btn-outline-primary" type="button">＋ Child</button><button id="node-delete" class="btn btn-outline-danger" type="button">Hapus Node</button></div><% } %>
      </form>
    </aside>
  </section>
  <div class="app-container"><%- include('../partials/document-comments', { documentComments: { recordKey: mode === 'create' ? null : recordKey, showPending: mode === 'create', title: 'Komentar BOM', variant: 'receipt' } }) %></div>
</main>
<dialog id="bom-add-kind-dialog" class="bom-add-kind-dialog">
  <div class="bom-dialog-heading"><div><small>TAMBAH KE CANVAS</small><h2>Pilih Jenis Part</h2></div><button type="button" data-close-add-menu>×</button></div>
  <div class="bom-add-kind-grid"><button type="button" data-add-kind="fg">＋ FG</button><button type="button" data-add-kind="child">＋ Child Part</button><button type="button" data-add-kind="purchase">＋ Purchase Part</button><button type="button" data-add-kind="material">＋ Raw Material</button></div>
</dialog>
<dialog id="bom-part-dialog" class="bom-part-dialog">
  <form id="bom-part-create-form" method="dialog">
    <div class="bom-dialog-heading"><div><small id="bom-part-kind-label">PART BARU</small><h2 id="bom-part-dialog-title">Tambah Child Part</h2></div><button type="button" data-close-dialog>×</button></div>
    <p class="bom-dialog-code-hint">Part masih ditahan di draft canvas. Part Code final dibuat dari <a href="/master-data/numbering-rules">Pengaturan Penomoran</a> saat BOM di-approve.</p>
    <p id="quick-sequence-source" class="bom-dialog-code-hint">Sequence mengikuti family Produk Utama atau FG non-component.</p>
    <section class="bom-existing-part"><label>Ambil dari Master Part</label><div><select id="quick-existing-part" class="form-select" data-enterprise-lookup="parts" data-value-key="id" data-label-key="partName" data-lookup-placeholder="Pilih part existing"><option value="">Pilih part existing</option></select><button id="quick-add-existing" type="button" class="btn btn-outline-primary">Tambah Existing</button></div><small id="quick-existing-hint">Daftar difilter mengikuti tipe part dan customer parent.</small></section>
    <div class="bom-dialog-divider"><span>atau buat part baru</span></div>
    <label>Nama Part <em>*</em></label><input id="quick-part-name" class="form-control" required>
    <label>Part Number</label><input id="quick-part-number" class="form-control">
    <div class="bom-dialog-grid"><div><label>Customer Code</label><select id="quick-customer-code" class="form-select" data-enterprise-lookup="customer-codes" data-value-key="customerCode" data-label-key="customerName" data-lookup-placeholder="Pilih customer"><option value="">Pilih customer</option></select></div><div><label>Revisi</label><input id="quick-part-revision" class="form-control" value="00"></div></div>
    <div class="bom-dialog-grid"><div id="quick-part-type-wrap"><label>Tipe Part</label><select id="quick-part-type" class="form-select"><option value="STANDARD">Non Component</option><option value="COMP">Component</option></select></div><div id="quick-part-level-wrap"><label>Urutan Proses</label><input id="quick-part-level" class="form-control" type="number" min="1" value="1"><small>Pada BOM baru dihitung ulang otomatis berdasarkan seluruh level canvas saat Simpan.</small></div></div>
    <div id="quick-material-wrap" class="d-none"><label>Link Master Material <em>*</em></label><select id="quick-material-id" class="form-select" data-enterprise-lookup="materials" data-value-key="id" data-label-key="materialName" data-lookup-placeholder="Pilih master material"><option value="">Pilih master material</option></select><small>Part code raw material menjadi identitas inventory; T, W, density dan harga mengambil dari material ini.</small></div>
    <label id="quick-position-mode-wrap">Posisi Nomor Proses</label><select id="quick-position-mode" class="form-select"><option value="MAIN">Proses utama (010/020/030)</option><option value="INSERT">Sisipan setelah proses (011/015 sesuai aturan)</option></select>
    <label id="quick-has-drawing-wrap" class="bom-dialog-check"><input id="quick-has-drawing" type="checkbox"> Ada drawing / standar khusus</label>
    <label>Base UOM</label><select id="quick-part-uom" class="form-select" data-enterprise-lookup="uom" data-value-key="uomCode" data-label-key="uomName" data-lookup-placeholder="Pilih UOM"><option value="">Pilih UOM</option></select>
    <div id="bom-part-create-error" class="alert alert-danger d-none mt-3"></div>
    <div class="bom-dialog-actions"><button type="button" class="btn btn-outline-secondary" data-close-dialog>Batal</button><button id="bom-part-create-submit" type="submit" class="btn btn-primary">Tambah ke Draft Canvas</button></div>
  </form>
</dialog>
<script id="bom-editor-config" type="application/json"><%- JSON.stringify({ mode, recordKey }).replace(/</g, '\\u003c') %></script>
<%- include('../partials/footer') %>
