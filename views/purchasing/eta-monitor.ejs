<%- include('../partials/head') %>
<link rel="stylesheet" href="/css/purchase-suggestion-compact-ui.css">
<link rel="stylesheet" href="/css/purchasing-eta.css?v=20260907-modes-1">
<link rel="stylesheet" href="/css/eta-request-sheet.css?v=20260916-1">
<link rel="stylesheet" href="/css/customer-supplies.css?v=20260916-eta">
<%- include('../partials/header-modules') %>
<%- include('../partials/module-subnav', { activePage: 'eta-monitor' }) %>
<main class="eta-page app-container">
  <header class="eta-heading"><div><small>PURCHASING · KONFIRMASI PARTNER</small><h1>Permintaan & Konfirmasi ETA</h1><p id="eta-heading-copy">Permintaan dari PPIC Lab · konfirmasi supplier, vendor, dan material customer.</p></div><div class="eta-actions"><a class="eta-button" href="/modules/planning-ppic/preparation">PPIC Lab</a><button id="eta-refresh" class="eta-button" type="button">↻ Refresh status</button></div></header>
  <div id="eta-error" class="eta-error" role="alert" hidden></div>
  <div id="eta-success" class="eta-success" role="status" hidden></div>
  <div class="eta-filters eta-workspace-select"><label>Bulan kebutuhan<input id="eta-month" type="month" value="<%= initialMonth %>"></label><label>Tampilan<select id="eta-mode" data-searchable-disabled><option value="ppic">Permintaan PPIC Lab</option><option value="mps">MPS workspace</option><option value="supplier">Purchase Suggestion / PO</option><option value="vendor">Dokumen proses vendor</option><option value="customer">Dokumen suplai customer</option></select></label><label id="eta-mps-wrap" class="eta-mps-select" hidden>MPS hasil perhitungan<select id="eta-mps" data-searchable-disabled><option value="">Memuat MPS…</option></select></label><label id="eta-source-wrap" hidden>Sumber dokumen<select id="eta-source" data-searchable-disabled></select></label></div>
  <div id="eta-documents" class="eta-documents" aria-live="polite"></div>
  <section id="eta-method-panel" class="eta-method-panel" aria-label="Metode ETA MPS" hidden></section>
  <section class="eta-panel">
    <div id="eta-partners" class="eta-tabs" role="group" aria-label="Jenis suplai"><button type="button" data-eta-partner="" aria-pressed="true">Semua</button><button type="button" data-eta-partner="supplier" aria-pressed="false">Supplier</button><button type="button" data-eta-partner="vendor" aria-pressed="false">Vendor</button><button type="button" data-eta-partner="customer" aria-pressed="false">Customer</button><button type="button" data-eta-partner="checksheet" aria-pressed="false">Checksheet</button></div>
    <div class="eta-filters"><label id="eta-category-wrap">Kategori<select id="eta-category" data-searchable-disabled><option value="">Semua kategori</option><option value="MATERIAL">Material</option><option value="PURCHASE_PART">Purchase Part</option><option value="UNIVERSAL_PART">Universal Part</option><option value="VENDOR">Proses vendor</option><option value="CUSTOMER">Suplai customer</option><option value="OTHER">Lainnya / belum dikategorikan</option></select></label><label>Status ETA<select id="eta-status" data-searchable-disabled><option value="">Semua status</option><option value="MISSING">Belum ada ETA</option><option value="LATE">Terlambat / lewat target</option><option value="BOM">Perkiraan By BOM</option><option value="PLANNED">Belum dikonfirmasi</option><option value="CONFIRMED">ETA terkonfirmasi</option><option value="RECEIVED">Sudah diterima</option></select></label><label class="eta-search">Cari<input id="eta-search" type="search" placeholder="Material, part no, supplier, dokumen…"></label></div>
    <div class="eta-kpis" aria-label="Ringkasan ETA"><article><span>Jadwal / baris</span><strong id="eta-count">—</strong></article><article><span>Belum ada ETA</span><strong id="eta-missing">—</strong></article><article><span>Terlambat</span><strong id="eta-late">—</strong></article><article><span>Perlu tindak lanjut</span><strong id="eta-pending">—</strong></article></div>
    <div class="eta-work-actions"><label><input id="eta-unresolved" type="checkbox"> Fokus yang perlu ditindaklanjuti</label><button id="eta-start" class="eta-button primary" type="button" disabled>Mulai konfirmasi</button></div>
    <p id="eta-note" class="eta-note">ETA rencana bukan konfirmasi. Penerimaan belum berarti lolos QC.</p>
    <section id="eta-request-sheet" hidden aria-label="Tabel permintaan ETA PPIC Lab">
      <div class="eta-sheet-tools"><label>Kelompok jadwal<select id="eta-sheet-group" data-searchable-disabled><option value="day">Per tanggal</option><option value="week">Per minggu</option><option value="month">Per bulan</option><option value="item">Per item</option></select></label><span id="eta-selected">Pilih baris untuk konfirmasi</span><button id="eta-save-selected" type="button" class="eta-button primary" disabled>Konfirmasi terpilih</button><button id="eta-merge-selected" type="button" class="eta-button" disabled>Gabung jadwal</button></div>
      <p class="eta-sheet-hint">Edit sel langsung · Tab / Enter pindah sel · Tempel beberapa sel dari Excel · MOQ dan gabung jadwal untuk supplier/vendor. Material customer dikonfirmasi per kiriman.</p>
      <div class="eta-sheet-scroll" tabindex="0" role="region" aria-label="Spreadsheet permintaan ETA"><table class="eta-sheet" data-enterprise-table="off"><thead><tr><th><input id="eta-sheet-all" type="checkbox" aria-label="Pilih semua jadwal yang tampil"></th><th>Material / Part</th><th>Part No</th><th>Tanggal perlu</th><th>Qty perlu</th><th>UOM</th><th>MOQ</th><th>Qty confirm</th><th>LT hari</th><th>ETA tiba / kembali</th><th>Siap QC</th><th>Bentuk</th><th>Lebar mm</th><th>Panjang mm</th><th>Status / Gabungan</th><th></th></tr></thead><tbody id="eta-sheet-body"></tbody></table></div>
      <p id="eta-sheet-range" class="eta-sheet-hint"></p>
    </section>
    <div id="eta-legacy-table" class="eta-table-wrap"><table class="eta-table ps-compact-table" data-enterprise-table="off"><thead><tr><th>Material / Part</th><th>Part No</th><th>Supplier / Vendor / Customer</th><th>Siap Produksi<br>Target Tiba</th><th>Lead Time</th><th>ETA Tiba / Kembali</th><th>Siap Setelah QC</th><th class="qty">Qty Jadwal</th><th class="qty">Diterima</th><th>Status ETA</th><th>Dokumen</th><th>Aksi</th></tr></thead><tbody id="eta-body" aria-live="polite"><tr><td colspan="12">Memuat ETA…</td></tr></tbody></table></div>
    <footer id="eta-legacy-pagination" class="eta-pagination"><span id="eta-range"></span><div><button id="eta-prev" class="eta-button" type="button">Sebelumnya</button><span id="eta-page"></span><button id="eta-next" class="eta-button" type="button">Berikutnya</button></div></footer>
  </section>
  <details id="eta-customer-operations" class="eta-customer-operations" hidden><summary>Kiriman, penerimaan & stok customer</summary><%- include('../partials/eta-customer-operations') %></details>
  <dialog id="eta-dialog" class="eta-confirmation-dialog" aria-labelledby="eta-dialog-title"><header class="eta-heading"><div><small>PURCHASING CONFIRMATION</small><h2 id="eta-dialog-title">Rincian ETA</h2></div><button id="eta-close" class="eta-button" type="button" aria-label="Tutup rincian ETA">×</button></header><div id="eta-detail"></div></dialog>
  <dialog id="eta-batch-dialog" aria-labelledby="eta-batch-title"><header class="eta-heading"><h2 id="eta-batch-title">Konfirmasi jadwal</h2><button id="eta-batch-close" class="eta-button" type="button" aria-label="Tutup konfirmasi jadwal">×</button></header><div id="eta-batch-content"></div></dialog>
</main>
<script src="/js/eta-request-sheet.js?v=20260916-2"></script>
<script src="/js/customer-supplies.js?v=20260916-eta"></script>
<%- include('../partials/footer') %>
