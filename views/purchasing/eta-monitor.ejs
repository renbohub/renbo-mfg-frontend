<%- include('../partials/head') %>
<link rel="stylesheet" href="/css/purchase-suggestion-compact-ui.css">
<link rel="stylesheet" href="/css/purchasing-eta.css?v=20260907-modes-1">
<%- include('../partials/header-modules') %>
<%- include('../partials/module-subnav', { activePage: 'eta-monitor' }) %>
<main class="eta-page app-container">
  <header class="eta-heading"><div><small>PURCHASING · MPS WORKSPACE</small><h1>Pusat Konfirmasi ETA</h1><p>Pilih MPS hasil perhitungan, lalu catat komitmen Supplier, Vendor, dan Customer.</p></div><div class="eta-actions"><a class="eta-button" href="/modules/planning-ppic/mps">Checksheet MPS</a><button id="eta-refresh" class="eta-button" type="button">↻ Refresh status</button></div></header>
  <div id="eta-error" class="eta-error" role="alert" hidden></div>
  <div id="eta-success" class="eta-success" role="status" hidden></div>
  <div class="eta-filters eta-workspace-select"><label>Bulan MPS / kebutuhan<input id="eta-month" type="month" value="<%= initialMonth %>"></label><label id="eta-mps-wrap" class="eta-mps-select">MPS hasil perhitungan<select id="eta-mps" data-searchable-disabled><option value="">Memuat MPS…</option></select></label><details class="eta-legacy"><summary>Dokumen lanjutan (opsional)</summary><label>Tampilan<select id="eta-mode" data-searchable-disabled><option value="mps">MPS workspace</option><option value="supplier">Purchase Suggestion / PO</option><option value="vendor">Dokumen proses vendor</option><option value="customer">Dokumen suplai customer</option></select></label></details><label id="eta-source-wrap" hidden>Sumber dokumen<select id="eta-source" data-searchable-disabled></select></label></div>
  <div id="eta-documents" class="eta-documents" aria-live="polite"></div>
  <section id="eta-method-panel" class="eta-method-panel" aria-label="Metode ETA MPS" hidden></section>
  <section class="eta-panel">
    <div id="eta-partners" class="eta-tabs" role="group" aria-label="Jenis suplai"><button type="button" data-eta-partner="" aria-pressed="true">Semua</button><button type="button" data-eta-partner="supplier" aria-pressed="false">Supplier</button><button type="button" data-eta-partner="vendor" aria-pressed="false">Vendor</button><button type="button" data-eta-partner="customer" aria-pressed="false">Customer</button><button type="button" data-eta-partner="checksheet" aria-pressed="false">Checksheet</button></div>
    <div class="eta-filters"><label id="eta-category-wrap">Kategori<select id="eta-category" data-searchable-disabled><option value="">Semua kategori</option><option value="MATERIAL">Material</option><option value="PURCHASE_PART">Purchase Part</option><option value="UNIVERSAL_PART">Universal Part</option><option value="VENDOR">Proses vendor</option><option value="CUSTOMER">Suplai customer</option><option value="OTHER">Lainnya / belum dikategorikan</option></select></label><label>Status ETA<select id="eta-status" data-searchable-disabled><option value="">Semua status</option><option value="MISSING">Belum ada ETA</option><option value="LATE">Terlambat / lewat target</option><option value="BOM">Perkiraan By BOM</option><option value="PLANNED">Belum dikonfirmasi</option><option value="CONFIRMED">ETA terkonfirmasi</option><option value="RECEIVED">Sudah diterima</option></select></label><label class="eta-search">Cari<input id="eta-search" type="search" placeholder="Material, part no, supplier, dokumen…"></label></div>
    <div class="eta-kpis" aria-label="Ringkasan ETA"><article><span>Jadwal / baris</span><strong id="eta-count">—</strong></article><article><span>Belum ada ETA</span><strong id="eta-missing">—</strong></article><article><span>Terlambat</span><strong id="eta-late">—</strong></article><article><span>Perlu tindak lanjut</span><strong id="eta-pending">—</strong></article></div>
    <div class="eta-work-actions"><label><input id="eta-unresolved" type="checkbox" checked> Fokus yang perlu ditindaklanjuti</label><button id="eta-start" class="eta-button primary" type="button" disabled>Mulai konfirmasi</button></div>
    <p id="eta-note" class="eta-note">ETA rencana bukan konfirmasi. Penerimaan belum berarti lolos QC.</p>
    <div class="eta-table-wrap"><table class="eta-table ps-compact-table" data-enterprise-table="off"><thead><tr><th>Material / Part</th><th>Part No</th><th>Supplier / Vendor / Customer</th><th>Siap Produksi<br>Target Tiba</th><th>Lead Time</th><th>ETA Tiba / Kembali</th><th>Siap Setelah QC</th><th class="qty">Qty Jadwal</th><th class="qty">Diterima</th><th>Status ETA</th><th>Dokumen</th><th>Aksi</th></tr></thead><tbody id="eta-body" aria-live="polite"><tr><td colspan="12">Memuat ETA…</td></tr></tbody></table></div>
    <footer class="eta-pagination"><span id="eta-range"></span><div><button id="eta-prev" class="eta-button" type="button">Sebelumnya</button><span id="eta-page"></span><button id="eta-next" class="eta-button" type="button">Berikutnya</button></div></footer>
  </section>
  <dialog id="eta-dialog" class="eta-confirmation-dialog" aria-labelledby="eta-dialog-title"><header class="eta-heading"><div><small>PURCHASING CONFIRMATION</small><h2 id="eta-dialog-title">Rincian ETA</h2></div><button id="eta-close" class="eta-button" type="button" aria-label="Tutup rincian ETA">×</button></header><div id="eta-detail"></div></dialog>
</main>
<%- include('../partials/footer') %>
