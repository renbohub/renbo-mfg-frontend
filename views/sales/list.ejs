<%- include('../partials/head') %>
<%- include('../partials/header-modules') %>
<%- include('../partials/sales-subnav') %>
<%
  const salesStatuses = page.salesType === 'quotation'
    ? ['Draft', 'Submitted', 'Approved', 'Accepted', 'Rejected']
    : page.salesType === 'sales-order'
      ? ['Draft', 'In Approval', 'Confirmed', 'In Progress', 'Completed', 'Cancelled', 'Superseded']
      : ['Draft', 'Submitted', 'Confirmed', 'Partial Product', 'Consumed', 'Closed', 'Obsolete', 'Superseded'];
%>
<main class="entity-page sales-list-page">
  <section class="entity-toolbar sales-master-toolbar app-container">
    <div class="enterprise-page-heading"><span>Sales</span><h1><%= page.label %></h1><p><%= page.description %></p></div>
    <label class="toolbar-search sales-master-search">
      <%- include('../partials/icon', { name: 'search' }) %>
      <input id="sales-search" type="search" placeholder="Cari nomor atau customer..." aria-label="Cari <%= page.label %>">
    </label>
    <select id="sales-status-filter" class="form-select sales-status-filter" aria-label="Filter status">
      <option value="">Semua status</option>
      <% salesStatuses.forEach(status => { %><option value="<%= status %>"><%= status %></option><% }) %>
    </select>
    <div class="toolbar-spacer"></div>
    <%- include('../partials/view-switcher') %>
    <button id="sales-export" class="btn btn-export" type="button">Export CSV</button>
    <% if (page.salesType === 'forecast') { %><button id="forecast-template-download" type="button" class="btn btn-outline-primary">Unduh Template Forecast</button><a href="/master-data/excel-imports" class="btn btn-outline-secondary">Impor Excel</a><% } %>
    <a class="btn btn-primary brand-button" href="/modules/sales/<%= page.slug %>/new">
      <%- include('../partials/icon', { name: 'plus' }) %> Tambah Baru
    </a>
  </section>
  <div id="sales-alert" class="alert alert-warning mx-4 mt-3 d-none" role="alert"></div>
  <section id="sales-list-root" class="table-shell entity-table-shell sales-master-table">
    <div class="list-table-view">
      <table id="sales-table" class="table align-middle w-100">
        <thead><tr>
          <% page.columns.forEach(column => { %><th><%= column.label %></th><% }) %><th>AKSI</th>
        </tr></thead>
      </table>
    </div>
    <div class="list-gallery is-hidden" aria-live="polite"></div>
  </section>
</main>
<script id="sales-page-config" type="application/json"><%- JSON.stringify({ ...page }).replace(/</g, '\\u003c') %></script>
<%- include('../partials/footer') %>
