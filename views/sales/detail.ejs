<%- include('../partials/head') %>
<%- include('../partials/header-modules') %>
<%- include('../partials/sales-subnav') %>
<main class="entity-detail-page app-container sales-page sales-detail-page">
  <div class="detail-heading">
    <div>
      <a href="/modules/sales/<%= page.slug %>"><%= page.label %></a>
      <span>/</span>
      <strong id="document-breadcrumb"><%= recordKey %></strong>
    </div>
    <div class="detail-actions sales-actions">
      <% if (page.salesType === 'forecast') { %><button id="submit-forecast" data-action="submit" class="btn btn-success d-none">Submit Forecast</button><button id="approve-forecast" data-action="approve" class="btn btn-success d-none">Approve Forecast</button><button id="forecast-planning-tool" class="btn btn-primary">Tarik Planning</button><% } %>
      <button id="make-to-so" class="btn btn-success d-none">Make to SO</button>
      <button id="confirm-sales-order" class="btn btn-success d-none">Confirm SO</button>
      <div class="dropdown enterprise-more-actions sales-more-actions">
        <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">More Actions</button>
        <div class="dropdown-menu dropdown-menu-end">
          <% if (page.salesType === 'forecast') { %><button id="revise-forecast" class="dropdown-item d-none" type="button">Buat Revisi</button><% } %>
          <% if (page.salesType === 'sales-order') { %><button id="revise-sales-order" class="dropdown-item d-none" type="button">Buat Revisi</button><% } %>
          <a id="edit-document" class="dropdown-item" href="/modules/sales/<%= page.slug %>/<%= encodeURIComponent(recordKey) %>/edit">Edit Dokumen</a>
          <button id="delete-document" class="dropdown-item dropdown-item-danger" type="button">Hapus Dokumen</button>
        </div>
      </div>
    </div>
  </div>
  <section class="sales-detail-identity">
    <div class="sales-heading-line">
      <h1 id="document-number"><%= recordKey %></h1>
      <span id="document-status" class="sales-badge">...</span>
    </div>
    <p id="document-caption">Memuat detail <%= page.label %>...</p>
  </section>
  <div id="sales-alert" class="alert d-none" role="alert"></div>
  <div class="sales-detail-layout">
    <div>
      <section class="sales-card"><div class="sales-card-head"><div><h2>Informasi Dokumen</h2><p>Ringkasan transaksi dan customer</p></div></div><div id="detail-info" class="sales-info-grid"></div></section>
      <section class="sales-card"><div class="sales-card-head"><div><h2>Detail Item</h2><p id="detail-items-caption">Part dan kuantitas dokumen</p></div></div><div class="table-responsive"><table class="table sales-detail-table"><thead id="detail-head"></thead><tbody id="detail-body"></tbody></table></div><div id="detail-summary" class="sales-summary"></div></section>
      <% if (page.salesType === 'forecast') { %><section class="sales-card"><div class="sales-card-head"><div><h2>Forecast vs Actual SO</h2><p>Per customer, part FG, dan bulan forecast.</p></div></div><div class="table-responsive"><table class="table sales-detail-table"><thead><tr><th>Bulan</th><th>Part</th><th>Bucket</th><th>Forecast</th><th>Actual SO</th><th>Selisih</th><th>Forecast Rp</th><th>SO Rp</th></tr></thead><tbody id="forecast-demand-summary"><tr><td colspan="8" class="text-muted text-center">Memuat ringkasan demand…</td></tr></tbody></table></div></section><% } %>
      <section class="sales-card"><div class="sales-card-head"><h2>Catatan</h2></div><p id="detail-notes" class="sales-notes">-</p></section>
    </div>
    <aside>
      <section class="sales-card"><div class="sales-card-head"><h2>Alur Dokumen</h2></div><div id="workflow" class="sales-workflow"></div></section>
      <section class="sales-card"><div class="sales-card-head"><h2>Relasi</h2></div><div id="relationships" class="sales-relationships"></div></section>
      <% if (page.salesType === 'forecast') { %><section class="sales-card"><div class="sales-card-head"><div><h2>Planning Chain</h2><p>Forecast → MPS → MRP → Production Plan → PR</p></div></div><div id="forecast-planning-tool-status" class="sales-notes">Memuat status planning...</div></section><% } %>
    </aside>
  </div>
</main>
<script id="sales-page-config" type="application/json"><%- JSON.stringify({ ...page, recordKey }).replace(/</g, '\\u003c') %></script>
<%- include('../partials/footer') %>
