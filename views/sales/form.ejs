<%- include('../partials/head') %>
<%- include('../partials/header-modules') %>
<%- include('../partials/sales-subnav') %>
<main class="entity-form-page sales-document-page">
  <div class="form-page-heading app-container">
    <div>
      <a href="/modules/sales/<%= page.slug %>"><%= page.label %></a>
      <span>/</span>
      <strong><%= mode === 'edit' ? 'Edit' : 'Buat Baru' %></strong>
    </div>
    <h1><%= mode === 'edit' ? 'Edit' : 'Buat' %> <%= page.label %></h1>
    <p id="form-subtitle"><%= page.description %></p>
  </div>
  <form id="sales-form" class="entity-form-card sales-document-form" novalidate>
    <div id="sales-alert" class="alert d-none" role="alert"></div>
    <section class="sales-card sales-form-section">
      <div class="sales-card-head">
        <div><h2>Informasi Dokumen</h2><p>Data utama dan referensi transaksi</p></div>
        <span id="document-status" class="sales-badge draft">Draft</span>
      </div>
      <div id="header-fields" class="sales-form-grid"></div>
    </section>
    <section class="sales-card sales-form-section">
      <div class="sales-card-head">
        <div><h2 id="items-title">Item</h2><p id="items-help">Tambahkan part dan kuantitas</p></div>
        <button id="add-line" class="btn btn-outline-primary" type="button">
          <%- include('../partials/icon', { name: 'plus' }) %> Tambah Item
        </button>
      </div>
      <div class="table-responsive">
        <table class="table sales-items">
          <thead id="items-head"></thead>
          <tbody id="items-body"></tbody>
        </table>
      </div>
      <div id="document-summary" class="sales-summary"></div>
    </section>
    <section class="sales-card sales-form-section">
      <div class="sales-card-head">
        <div><h2>Catatan</h2><p>Informasi tambahan untuk dokumen ini</p></div>
      </div>
      <textarea id="notes" class="form-control" rows="4" placeholder="Tambahkan catatan..."></textarea>
    </section>
    <div class="form-actions sales-form-actions">
      <a class="btn btn-outline-secondary" href="/modules/sales/<%= page.slug %>">Batal</a>
      <button id="save-document" class="btn btn-primary brand-button" type="submit">Simpan</button>
    </div>
  </form>
</main>
<script id="sales-page-config" type="application/json"><%- JSON.stringify({ ...page, mode, recordKey }).replace(/</g, '\\u003c') %></script>
<%- include('../partials/footer') %>
