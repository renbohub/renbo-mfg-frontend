<%- include('../partials/head') %>
<%- include('../partials/header-modules') %>
<%- include('../partials/module-subnav', { activePage: page.slug }) %>
<main class="ops-page operations-detail-page app-container <%= module.slug === 'purchasing' ? 'purchasing-detail-page' : '' %> <%= module.slug === 'purchasing' && page.slug === 'purchase-order' ? 'purchase-order-detail-page' : '' %> <%= module.slug === 'purchasing' && page.slug === 'purchase-suggestions' ? 'purchase-suggestion-page' : '' %> <%= module.slug === 'production' ? 'production-detail-page' : '' %> <%= module.slug === 'incoming' && page.slug === 'incoming-inspections' ? 'incoming-inspection-page' : '' %>">
  <nav class="module-breadcrumb"><a href="/modules">Modul</a><span>/</span><a href="/modules/<%= module.slug %>"><%= module.label %></a><span>/</span><a href="/modules/<%= module.slug %>/<%= page.slug %>"><%= page.label %></a><span>/</span><b><%= recordKey %></b></nav>
  <section class="ops-detail-titlebar">
    <div><p class="ops-eyebrow"><%= page.label %></p><h1 id="ops-detail-title"><%= recordKey %></h1><p id="ops-detail-subtitle">Memuat detail dokumen...</p></div>
    <div id="ops-detail-actions" class="ops-title-actions">
      <% if (module.slug === 'purchasing' && page.slug === 'purchase-requisitions') { %><a id="pr-edit-link" class="btn btn-outline-primary" href="/modules/purchasing/purchase-requisitions/<%= encodeURIComponent(recordKey) %>/edit<%= purchaseCategory ? '?category=' + purchaseCategory : '' %>">Edit PR</a><% } %>
      <% if (module.slug === 'purchasing' && page.slug === 'purchase-order') { %><a class="btn btn-outline-primary" href="/modules/purchasing/purchase-order/<%= encodeURIComponent(recordKey) %>/edit">Edit PO</a><% } %>
      <% if (module.slug === 'purchasing' && page.slug === 'purchase-invoices') { %><a class="btn btn-outline-primary" href="/modules/purchasing/purchase-invoices/<%= encodeURIComponent(recordKey) %>/edit">Edit Invoice</a><% } %>
      <% if (module.slug === 'production' && page.slug === 'production-logs') { %><a id="production-log-edit-link" class="btn btn-outline-primary" href="/modules/production/production-logs/<%= encodeURIComponent(recordKey) %>/edit">Edit Log</a><% } %>
      <% if (module.slug === 'production' && page.slug === 'daily-production-schedules') { %><a id="daily-plan-edit-link" class="btn btn-outline-primary d-none" href="/modules/production/daily-production-schedules/<%= encodeURIComponent(recordKey) %>/edit">Revisi DPP</a><% } %>
      <% if (module.slug === 'production' && page.createRoute && !['production-logs', 'daily-production-schedules'].includes(page.slug)) { %><a class="btn btn-outline-primary" href="/modules/production/<%= page.slug %>/<%= encodeURIComponent(recordKey) %>/edit">Edit</a><% } %>
      <a class="btn btn-outline-secondary" href="/modules/<%= module.slug %>/<%= page.slug %><%= purchaseCategory ? '?category=' + purchaseCategory : '' %>">← Kembali</a>
    </div>
  </section>
  <div id="ops-detail-alert" class="alert d-none" role="alert"></div>
  <section id="ops-detail-loading" class="ops-detail-loading">Memuat detail <%= page.label %>...</section>
  <div id="ops-detail-shell" class="ops-detail-layout d-none">
    <div class="ops-detail-main">
      <section class="ops-detail-card"><header><h2>Informasi Dokumen</h2><span id="ops-detail-status"></span></header><div id="ops-detail-fields" class="ops-detail-fields"></div></section>
      <div id="ops-detail-collections"></div>
    </div>
    <aside class="ops-detail-aside">
      <section class="ops-detail-card"><h2>Workflow & Aksi</h2><p class="ops-help">Aksi yang tampil disesuaikan dengan status dokumen dan aturan backend.</p><div id="ops-workflow-actions" class="ops-workflow-actions"></div></section>
      <section class="ops-detail-card"><h2>Kontrol Dokumen</h2><div id="ops-document-meta" class="ops-document-meta"></div></section>
    </aside>
  </div>
</main>
<script id="ops-detail-config" type="application/json"><%- JSON.stringify({ module: module.slug, moduleLabel: module.label, page, recordKey, purchaseCategory }).replace(/</g, '\\u003c') %></script>
<%- include('../partials/footer') %>
