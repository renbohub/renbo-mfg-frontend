<%- include('../partials/head') %>
<%- include('../partials/header-modules') %>
<%- include('../partials/module-subnav', { activePage: page.slug }) %>
<% const isPurchaseRequisition = module.slug === 'purchasing' && page.slug === 'purchase-requisitions'; %>
<% if (isPurchaseRequisition) { %><link rel="stylesheet" href="/css/pr-category-filter.css?v=20260907-1"><% } %>
<% const isDailyWorkQueue = module.slug === 'production' && page.slug === 'daily-production-schedules'; %>
<main class="entity-page operations-master-list-page <%= isDailyWorkQueue ? 'daily-work-command-page' : '' %>">
  <section class="entity-toolbar operations-master-toolbar app-container">
    <div class="entity-title"><span><%= module.label %></span><b>/</b><strong><%= page.label %></strong></div>
    <label class="toolbar-search operations-master-search">
      <%- include('../partials/icon', { name: 'search' }) %>
      <input id="ops-search" type="search" placeholder="Cari nomor, part, lokasi, atau status..." aria-label="Cari <%= page.label %>">
    </label>
    <div class="toolbar-spacer"></div>
    <% if (module.slug === 'purchasing') { %><button class="btn btn-outline-primary" type="button" data-ai-capability="purchasing.get_material_shortage" data-ai-context='{"pageCode":"<%= page.slug %>"}' data-ai-prompt="Tampilkan material shortage dan PO yang terlambat terhadap required arrival date.">AI Material Risk</button><% } %>
    <%- include('../partials/view-switcher', isDailyWorkQueue ? { viewModes: ['gallery', 'table', 'kanban', 'gantt'], viewLabels: { gallery: 'Work Cards', table: 'Table', kanban: 'Status Board', gantt: 'Weekly Gantt' } } : {}) %>
    <button id="ops-refresh" type="button" class="btn btn-outline-secondary">Refresh</button>
    <button id="ops-export" type="button" class="btn btn-export">Export CSV</button>
    <% if (isPurchaseRequisition) { %>
      <a href="/modules/purchasing/purchase-requisitions/new<%= purchaseCategory ? '?category=' + purchaseCategory : '' %>" class="btn btn-primary brand-button"><%- include('../partials/icon', { name: 'plus' }) %> Tambah Baru</a>
      <% if (purchaseCategory === 'vendor-process') { %><a href="/modules/planning-ppic/monthly-production-plans" class="btn btn-outline-primary">Buka Monthly Plan →</a><% } %>
    <% } else if (page.createRoute) { %>
      <a href="<%= page.createRoute %>" class="btn btn-primary brand-button"><%- include('../partials/icon', { name: 'plus' }) %> Tambah Baru</a>
    <% } %>
  </section>
  <% if (isDailyWorkQueue) { %>
    <section class="daily-work-intro app-container">
      <div><span>PRODUCTION CONTROL</span><h1>Daily Production Schedule</h1><p>Prioritaskan schedule berdasarkan tanggal, shift, mesin, dan status eksekusi.</p></div>
      <div class="daily-work-clock"><small>TANGGAL KERJA</small><strong id="daily-work-date-label">-</strong><span id="daily-work-active-filter">Hari ini</span></div>
    </section>
    <section class="daily-work-filters app-container" aria-label="Filter Daily Production Schedule">
      <div class="daily-work-quick" role="group" aria-label="Periode kerja">
        <button type="button" data-work-scope="today" class="active">Hari Ini</button>
        <button type="button" data-work-scope="tomorrow">Besok</button>
        <button type="button" data-work-scope="overdue">Terlambat</button>
        <button type="button" data-work-scope="all">Semua</button>
      </div>
      <label><span>Tanggal</span><input id="ops-filter-schedule-date" class="form-control form-control-sm" type="date"></label>
      <label><span>Shift</span><select id="ops-filter-shift" class="form-select form-select-sm"><option value="">Semua Shift</option><option value="1">Shift 1</option><option value="1A">Shift 1A</option><option value="1B">Shift 1B</option><option value="2">Shift 2</option><option value="2A">Shift 2A</option><option value="2B">Shift 2B</option><option value="3">Shift 3</option><option value="3A">Shift 3A</option><option value="3B">Shift 3B</option><option value="3C">Shift 3C</option></select></label>
      <label><span>Mesin</span><select id="ops-filter-machine" class="form-select form-select-sm"><option value="">Semua Mesin</option></select></label>
      <label><span>Line</span><select id="ops-filter-line" class="form-select form-select-sm"><option value="">Semua Line</option></select></label>
      <label><span>Status</span><select id="ops-filter-status" class="form-select form-select-sm"><option value="">Semua Status</option><option value="Draft">Belum Dipersiapkan</option><option value="Released">Siap Dikerjakan</option><option value="In Progress">Sedang Dikerjakan</option><option value="Completed">Selesai</option><option value="Cancelled">Dibatalkan</option></select></label>
      <button id="ops-filter-reset" type="button" class="btn btn-sm btn-outline-secondary">Reset</button>
    </section>
    <section class="daily-work-summary app-container" aria-label="Ringkasan Daily Production Schedule">
      <% ['WO', 'DR', 'RUN', '%'].forEach((icon, index) => { %><article><i><%= icon %></i><div><small id="ops-stat-label-<%= index %>">-</small><strong id="ops-stat-value-<%= index %>">0</strong><span id="ops-stat-note-<%= index %>">-</span></div></article><% }) %>
    </section>
    <section id="daily-machine-tables" class="daily-machine-tables app-container" aria-live="polite"><div class="daily-machine-empty">Memuat Daily Production Schedule per mesin...</div></section>
  <% } %>
  <% if (module.slug === 'planning-ppic' && page.slug === 'monthly-production-plans') { %>
    <section class="app-container d-flex flex-wrap align-items-end gap-3 py-3 border-bottom bg-white" aria-label="Filter kalender Production Plan">
      <div class="me-auto"><small class="text-uppercase text-muted">Calendar filter</small><h1 class="h5 mb-1">Production Plan Horizon</h1><p class="mb-0 text-muted">Plan tampil jika horizon produksinya menyentuh bulan terpilih; bulan bukan identitas dokumen.</p></div>
      <label><span class="d-block small text-muted mb-1">Bulan kalender</span><input id="ops-filter-horizon-month" class="form-control form-control-sm" type="month" value="<%= typeof initialHorizonMonth === 'string' ? initialHorizonMonth : '' %>"></label>
      <button id="ops-filter-reset" type="button" class="btn btn-sm btn-outline-secondary">Semua Horizon</button>
    </section>
  <% } %>
  <% if (module.slug === 'inventory') { %>
    <section class="app-container d-flex flex-wrap align-items-center gap-2 py-3 border-bottom bg-white" aria-label="Warehouse operational filters">
      <% if (page.slug !== 'warehouses') { %>
        <select id="ops-filter-warehouse" class="form-select form-select-sm" style="max-width:240px"><option value="">Semua Warehouse</option></select>
      <% } else { %>
        <select id="ops-filter-type" class="form-select form-select-sm" style="max-width:190px"><option value="">Semua Tipe</option><option value="Main">Main</option><option value="Sub">Sub</option><option value="Transit">Transit</option><option value="Quarantine">Quarantine</option></select>
        <select id="ops-filter-active" class="form-select form-select-sm" style="max-width:190px"><option value="">Semua Status</option><option value="true">Active</option><option value="false">Inactive</option></select>
      <% } %>
      <% if (page.slug === 'stock-balances') { %>
        <select id="ops-filter-stock-type" class="form-select form-select-sm" style="max-width:210px"><option value="">Semua Stock Type</option><option value="Material">Material</option><option value="Purchase Part">Purchase Part</option><option value="WIP">WIP</option><option value="Finished Goods">Finished Goods</option></select>
        <select id="ops-filter-low-stock" class="form-select form-select-sm" style="max-width:190px"><option value="">Semua Level</option><option value="true">Low Stock Only</option></select>
      <% } %>
      <% if (page.slug === 'stock-opname') { %>
        <select id="ops-filter-status" class="form-select form-select-sm" style="max-width:220px"><option value="">Semua Status</option><option value="DRAFT">Draft</option><option value="COUNTING">Counting</option><option value="WAITING_APPROVAL">Waiting Approval</option><option value="APPROVED">Approved</option><option value="ADJUSTED">Adjusted</option><option value="CLOSED">Closed</option><option value="CANCELLED">Cancelled</option></select>
      <% } %>
      <% if (page.slug === 'stock-reservations') { %>
        <select id="ops-filter-status" class="form-select form-select-sm" style="max-width:220px"><option value="">Semua Status</option><option value="Active">Active</option><option value="Released">Released</option><option value="Cancelled">Cancelled</option></select>
        <select id="ops-filter-type" class="form-select form-select-sm" style="max-width:220px"><option value="">Semua Sumber</option><option value="PART_ALLOCATION">Manual ke Part Number</option><option value="SO">Sales Order</option><option value="MANUFACTURING_ORDER">Manufacturing Order</option><option value="MPS">MPS</option></select>
      <% } %>
      <button id="ops-filter-reset" type="button" class="btn btn-sm btn-outline-secondary">Reset Filter</button>
    </section>
  <% } %>

  <% if (isPurchaseRequisition) { %>
    <%- include('../partials/pr-category-filter', { purchaseCategory }) %>
  <% } %>

  <div id="ops-alert" class="alert alert-warning mx-4 mt-3 d-none" role="alert"></div>
  <section id="ops-list-root" class="table-shell entity-table-shell operations-master-table">
    <div class="list-table-view">
      <table id="ops-table" class="table align-middle w-100">
        <thead><tr><% page.columns.forEach(column => { %><th><%= column.label %></th><% }) %><th>AKSI</th></tr></thead>
      </table>
    </div>
    <div class="list-gallery is-hidden" aria-live="polite"></div>
  </section>
</main>
<script id="ops-page-config" type="application/json"><%- JSON.stringify({ module: module.slug, moduleLabel: module.label, moduleColor: module.color, page, purchaseCategory: typeof purchaseCategory === 'undefined' ? null : purchaseCategory, initialHorizonMonth: typeof initialHorizonMonth === 'undefined' ? '' : initialHorizonMonth }).replace(/</g, '\\u003c') %></script>
<%- include('../partials/footer') %>
