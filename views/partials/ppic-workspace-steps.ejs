<nav class="ppw-stages" aria-label="Tahapan planning"><% [['L03','Delivery Schedule'],['L04','MPS / FG Schedule'],['L06','MRP'],['L07','Monthly Production Plan'],['L08','Daily Draft']].forEach(([id,label],index) => { const target=ppicWorkspaceRegistry.pages.find(page=>page.id===id); %><a data-ppw-link href="<%= ppicWorkspaceRegistry.href(target,ppicWorkspaceFilters) %>" class="<%= ppicWorkspacePage.id===id?'active':'' %>"><span><%= String(index+1).padStart(2,'0') %></span><%= label %></a><% }) %></nav>
