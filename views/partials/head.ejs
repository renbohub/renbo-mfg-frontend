  <script>
    (() => {
      const theme = localStorage.getItem('nexgen-ui-theme');
      const language = localStorage.getItem('nexgen-ui-language');
      document.documentElement.dataset.theme = theme === 'dark' ? 'dark' : 'light';
      document.documentElement.lang = ['id', 'en', 'ja'].includes(language) ? language : 'id';
    })();
  </script>
