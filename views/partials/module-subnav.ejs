<% if (typeof ppicWorkspacePage !== 'undefined' && ppicWorkspacePage) { %>
<%- include('ppic-domain-nav') %>
<% } else { %>
<%
  const requestedActivePage = typeof activePage !== 'undefined'
    ? activePage
    : typeof activePpicTab !== 'undefined'
      ? activePpicTab
      : typeof page !== 'undefined' && page
        ? page.slug
        : '';
  const modulePageAliases = {
    mrp: 'material-requirements-planning',
    mps: 'master-production-schedule',
    'monthly-plan': 'monthly-production-plans'
  };
  const normalizedActivePage = modulePageAliases[requestedActivePage] || requestedActivePage;
  const navigationIconRules = [
    { match: /dashboard|control-tower/, icon: 'grid' },
    { match: /tutorial/, icon: 'book' },
    { match: /report|trend|costing/, icon: 'chart' },
    { match: /schedule|plan|planning|forecast|capacity/, icon: 'calendar' },
    { match: /purchase|requisition|suggestion/, icon: 'cart' },
    { match: /shipment|delivery|supplier/, icon: 'truck' },
    { match: /receipt|incoming|putaway/, icon: 'inbox' },
    { match: /warehouse|inventory|stock|wip/, icon: 'warehouse' },
    { match: /quality|inspection|disposition|qc/, icon: 'check-circle' },
    { match: /material|bom/, icon: 'layers' },
    { match: /routing|process|work-center/, icon: 'route' },
    { match: /production|manufacturing|work-order/, icon: 'factory' },
    { match: /quotation|sales-order|invoice/, icon: 'file' },
    { match: /picking|packing/, icon: 'box' },
    { match: /movement|transfer|issue/, icon: 'activity' }
  ];
  const navigationIcon = item => item.icon
    || navigationIconRules.find(rule => rule.match.test(item.slug))?.icon
    || (item.kind === 'report' ? 'chart' : item.kind === 'dashboard' ? 'grid' : 'file');
  const ppicWorkbenchNav = module.slug === 'planning-ppic' ? {
    'master-production-schedule': { label: 'Rolling MPS', href: '/modules/planning-ppic/mps/workbench' },
    'mps-recovery': { label: 'MPS Recovery', href: '/modules/planning-ppic/mps/recovery-kanban' },
    'material-requirements-planning': { label: 'MRP Planning Runs', href: '/modules/planning-ppic/mrp' },
    'monthly-production-plans': { label: 'Production Plans', href: '/modules/planning-ppic/monthly-production-plans' },
  } : {};
  let moduleNavigationItems = (module.pages || []).filter(item => !item.navHidden).map(item => ({
    slug: item.slug,
    label: ppicWorkbenchNav[item.slug]?.label || item.label,
    href: ppicWorkbenchNav[item.slug]?.href || '/modules/' + module.slug + '/' + item.slug,
    apiReady: item.apiReady !== false,
    icon: navigationIcon(item)
  }));
  if (module.slug === 'planning-ppic') moduleNavigationItems = [
    ['preparation', null, 'Preparation PPIC', '/modules/planning-ppic/preparation'],
    ['demand-planning', 'annual', 'Demand Tahunan', '/modules/planning-ppic/demand-planning'],
    ['production-actuals', 'actual', 'Pemantauan Aktual Produksi', '/modules/planning-ppic/production-actuals'],
    ['monthly-delivery', 'delivery', 'Jadwal Delivery Bulanan', '/modules/planning-ppic/monthly-delivery'],
    ['master-production-schedule', 'fg', 'Jadwal Produksi FG Bulanan', '/modules/planning-ppic/mps/workbench'],
    ['material-requirements-planning', 'material', 'Rencana Kebutuhan Material (MRP)', '/modules/planning-ppic/mrp'],
    ['monthly-production-plans', 'monthly', 'Rencana Produksi Bulanan', '/modules/planning-ppic/monthly-production-plans'],
    ['daily-production-plans', 'daily', 'Jadwal Produksi Harian', '/modules/planning-ppic/daily-production-plans']
  ].map(([slug, i18n, label, href]) => ({ slug, i18n, label, href, icon: 'calendar', apiReady: true }));
%>
<% if (module.slug === 'planning-ppic') { %>
<script src="/js/ppic-language.js?v=20260910-layout-1"></script>
<script src="/js/ppic-calendar-model.js?v=20260909-r3"></script>
<link rel="stylesheet" href="/css/ppic-calendar.css?v=20260909-r3">
<% if (normalizedActivePage !== 'preparation') { %>
<link rel="stylesheet" href="/css/ppic-plan-review.css?v=20260909-r3">
<script defer src="/js/ppic-plan-review.js?v=20260909-r3"></script>
<script defer src="/js/ppic-proposals.js?v=20260910-layout-1"></script>
<% } %>
<% } %>
<nav class="module-subnav module-subnav--<%= module.color %> <%= module.slug === 'planning-ppic' ? 'ppic-workspace-nav' : '' %>" aria-label="Menu <%= module.label %>">
  <div class="app-container module-subnav-inner">
    <% moduleNavigationItems.forEach((item, index) => { %>
      <% if (module.slug === 'planning-ppic' && index === 0) { %><div class="ppic-nav-utilities"><% } %>
      <% if (module.slug === 'planning-ppic' && index === 3) { %></div><% } %>
      <a
        class="<%= normalizedActivePage === item.slug ? 'active' : '' %> <%= !item.apiReady ? 'disabled' : '' %> <%= module.slug === 'planning-ppic' ? (index < 3 ? 'ppic-nav-utility' : 'ppic-nav-stage') : '' %>"
        href="<%= item.apiReady ? item.href : '#' %>"
        <% if (normalizedActivePage === item.slug) { %>aria-current="page"<% } %>
        <%= !item.apiReady ? 'aria-disabled="true" title="Endpoint belum tersedia"' : '' %>
      ><% if (module.slug === 'planning-ppic' && index >= 3) { %><span class="ppic-nav-number" aria-hidden="true"><%= String(index - 2).padStart(2, '0') %></span><% } else { %><span class="module-subnav-icon"><%- include('icon', { name: item.icon }) %></span><% } %><span <% if (item.i18n) { %>data-ppic-i18n="<%= item.i18n %>"<% } %>><%= item.label %></span></a>
    <% }) %>
  </div>
</nav>
<% } %>
