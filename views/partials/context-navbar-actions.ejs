<div class="context-navbar-actions simple-navbar-tools" aria-label="Aktivitas dan bantuan">
  <% if (typeof demoClockUnavailable !== 'undefined' && demoClockUnavailable) { %>
    <button class="navbar-demo-badge" type="button" title="Tanggal aplikasi tidak tersedia" aria-label="Tanggal aplikasi tidak tersedia, buka pengaturan tanggal" data-bs-toggle="modal" data-bs-target="#demo-date-modal">Tanggal ?</button>
  <% } else if (typeof demoDate !== 'undefined' && demoDate) { %>
    <button class="navbar-demo-badge" type="button" title="Tanggal Demo: <%= demoDate %>" aria-label="Tanggal Demo <%= demoDate %>, ubah tanggal" data-bs-toggle="modal" data-bs-target="#demo-date-modal">Demo <span aria-hidden="true">·</span> <%= new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'short', timeZone: 'UTC' }).format(new Date(demoDate + 'T00:00:00Z')) %></button>
  <% } %>
  <button class="context-nav-button navbar-inbox-button" type="button" title="Aktivitas, alarm, dan komentar" aria-label="Buka aktivitas, alarm, dan komentar" data-context-open="errors" data-bs-toggle="offcanvas" data-bs-target="#page-context-panel">
    <%- include('icon', { name: 'bell' }) %>
    <span class="context-nav-badge d-none" data-context-nav-count="errors" aria-label="Jumlah alarm dan error">0</span>
  </button>
  <button class="context-nav-button ai-nav-trigger navbar-ai-button" type="button" title="AI Assistant" aria-label="Buka AI Assistant" data-ai-assistant-open>AI</button>
</div>
