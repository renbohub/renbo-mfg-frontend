<%- include('../partials/head') %>
<%- include('../partials/header-modules') %>
<nav class="ppic-subnav" aria-label="Navigasi PPIC"><div class="app-container ppic-subnav-inner">
  <a href="/modules/planning-ppic/mrp/general">MRP General</a><a class="<%= activePpicTab === 'mrp' ? 'active' : '' %>" href="/modules/planning-ppic/mrp">MRP Header</a><a href="/modules/planning-ppic/mps/general">MPS General</a><a class="<%= activePpicTab === 'mps' ? 'active' : '' %>" href="/modules/planning-ppic/mps">MPS Header</a><a class="<%= activePpicTab === 'monthly-plan' ? 'active' : '' %>" href="/modules/planning-ppic/monthly-plan">Monthly Plan</a><a class="<%= activePpicTab === 'consume-forecast' ? 'active' : '' %>" href="/modules/planning-ppic/consume-forecast">Consume Forecast</a><a class="<%= activePpicTab === 'capacity-planning' ? 'active' : '' %>" href="/modules/planning-ppic/capacity-planning">Capacity Planning</a>
</div></nav>
<main class="ppic-page">
  <section class="ppic-toolbar app-container">
    <div class="ppic-breadcrumb"><span>PPIC</span><i>/</i><b id="ppic-breadcrumb"><%= title %></b></div>
    <div class="ppic-controls"><label class="ppic-search">⌕ <input id="ppic-search" type="search" placeholder="Cari data PPIC..."></label><button id="ppic-filter" class="btn btn-outline-secondary">Filter</button></div>
    <div class="ppic-actions"><button id="ppic-export" class="btn btn-outline-secondary">Export</button><button id="ppic-primary" class="btn btn-primary brand-button"></button></div>
  </section>
  <section class="ppic-content app-container">
    <div id="ppic-alert" class="alert d-none"></div>
    <div class="ppic-heading"><h1 id="ppic-title"></h1><p id="ppic-subtitle"></p></div>
    <section class="ppic-table-card"><div class="table-responsive"><table class="table ppic-table"><thead id="ppic-head"></thead><tbody id="ppic-rows"></tbody></table></div><div id="ppic-footer" class="ppic-footer"></div></section>
  </section>
</main>
<script id="ppic-page-config" type="application/json"><%- JSON.stringify({ activeTab: activePpicTab }).replace(/</g, '\\u003c') %></script>
<%- include('../partials/footer') %>
