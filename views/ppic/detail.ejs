<%- include('../partials/head') %>
<%- include('../partials/header-modules') %>
<%- include('../partials/module-subnav', { activePage: activePpicTab }) %>
<main class="ppic-page ppic-detail-page">
  <section class="ppic-detail-toolbar">
    <div class="app-container ppic-detail-toolbar-inner">
      <div>
        <div class="ppic-breadcrumb"><a href="/modules/planning-ppic">PPIC</a><i>/</i><a href="/modules/planning-ppic/<%= activePpicTab %>"><%= title.replace(' Detail','') %></a><i>/</i><b id="ppic-detail-key"><%= recordKey %></b></div>
        <h1 id="ppic-detail-title"><%= title %></h1>
      </div>
      <div id="ppic-detail-actions" class="ppic-detail-actions"></div>
    </div>
  </section>
  <section class="app-container ppic-detail-content">
    <div id="ppic-detail-alert" class="alert d-none"></div>
    <div id="ppic-detail-loading" class="ppic-detail-loading">Memuat detail perencanaan...</div>
    <div id="ppic-detail-shell" class="ppic-detail-layout d-none">
      <aside class="ppic-workflow-card">
        <h2>Approval Workflow</h2>
        <div id="ppic-workflow" class="ppic-workflow"></div>
        <div id="ppic-workflow-actions" class="ppic-workflow-actions"></div>
        <div class="ppic-status-summary"><h3>Status Summary</h3><div id="ppic-status-path"></div></div>
      </aside>
      <div class="ppic-detail-main">
        <section class="ppic-detail-card">
          <h2 id="ppic-info-title">Informasi Dokumen</h2>
          <div id="ppic-info-grid" class="ppic-detail-info"></div>
        </section>
        <section class="ppic-detail-card">
          <div class="ppic-table-card-head"><h2 id="ppic-table-title">Detail</h2><div id="ppic-table-filters" class="ppic-table-filters"></div></div>
          <div id="ppic-detail-table-wrap" class="table-responsive"><table id="ppic-detail-table" class="table ppic-detail-table"><thead id="ppic-detail-head"></thead><tbody id="ppic-detail-rows"></tbody></table></div>
        </section>
        <div id="ppic-delivery-form-parking" class="d-none">
          <form id="ppic-delivery-plan-form" class="capacity-filter-card d-none">
            <label>Part / Child<select id="ppic-delivery-detail" required></select></label>
            <input id="ppic-delivery-target-type" type="hidden" value="CUSTOMER">
            <label>Customer<select id="ppic-delivery-target" required></select><small id="ppic-delivery-target-help" class="d-block text-muted"></small><a id="ppic-delivery-target-master-link" class="d-none small" href="/master-data/customers">Tambah di Master Customer →</a></label>
            <label>Tanggal Delivery<input id="ppic-delivery-date" type="date" required></label>
            <label>Qty Phase<input id="ppic-delivery-qty" type="number" min="0.001" step="0.001" required></label>
            <label>Catatan<input id="ppic-delivery-notes" type="text" placeholder="Contoh: Phase 1 urgent"></label>
            <div class="d-flex align-items-end gap-2"><button class="btn btn-primary" type="submit">Simpan Phase</button><button class="btn btn-outline-secondary" type="button" data-action="cancel-delivery-phase">Batal</button></div>
          </form>
        </div>
        <section id="ppic-procurement-card" class="ppic-detail-card d-none">
          <div class="ppic-table-card-head">
            <div><h2>MRP → Purchase Suggestion</h2><p class="ppic-section-help">Tinjau kebutuhan pembelian hasil MRP. Purchasing memeriksa supplier, MOQ, lead time, dan jadwal delivery sebelum membuat PR.</p></div>
            <div class="ppic-procurement-actions"><button type="button" class="btn btn-primary ppic-action-primary" data-action="make-purchase-suggestion">Buat Purchase Suggestion</button></div>
          </div>
          <div class="table-responsive"><table class="table ppic-detail-table ppic-procurement-table"><thead><tr><th><input id="ppic-procurement-check-all" type="checkbox" aria-label="Pilih semua planned order"></th><th>Planned Order</th><th>Material / Part</th><th>Demand / Sisa</th><th>Qty Rekomendasi</th><th>UOM</th><th>Tindak Lanjut</th><th>Purchase Suggestion</th></tr></thead><tbody id="ppic-procurement-rows"></tbody></table></div>
          <div id="ppic-procurement-summary" class="ppic-procurement-summary"></div>
        </section>
        <section class="ppic-detail-card">
          <h2 id="ppic-summary-title">Ringkasan Perencanaan</h2>
          <div id="ppic-summary-grid" class="ppic-detail-summary"></div>
          <p id="ppic-detail-notes" class="ppic-detail-notes d-none"></p>
          <div id="ppic-readiness-list" class="ppic-readiness-list d-none"></div>
        </section>
      </div>
    </div>
  </section>
</main>
<script id="ppic-detail-config" type="application/json"><%- JSON.stringify({ activeTab: activePpicTab, recordKey }).replace(/</g, '\\u003c') %></script>
<%- include('../partials/footer') %>
