<%- include('../partials/head') %>
<%- include('../partials/header-modules') %>
<%- include('../partials/module-subnav', { activePage: activePpicTab }) %>
<main class="ppic-page capacity-page">
  <section class="capacity-toolbar app-container">
    <div><div class="ppic-breadcrumb"><span>PPIC</span><i>/</i><b>Capacity Planning</b></div><h1>Capacity Planning</h1></div>
    <div class="capacity-toolbar-actions"><button class="btn btn-outline-primary" type="button" data-ai-capability="ppic.get_capacity_risk" data-ai-context='{"pageCode":"capacity-planning"}' data-ai-prompt="Analisis capacity risk bulan dan plan yang sedang dipilih.">AI Capacity Analysis</button><button id="capacity-open-monthly-plan" class="btn btn-outline-primary" type="button">Buka Monthly Plan</button><button id="capacity-adopt-simulation" class="btn btn-success d-none" type="button">Tetapkan sebagai Current Use</button><button id="capacity-sync-dpp" class="btn btn-outline-primary d-none" type="button">Generate / Revisi DPP</button><button id="capacity-recommend" class="btn btn-outline-primary d-none" type="button">Buat Rekomendasi</button><button id="capacity-refresh" class="btn btn-primary brand-button" type="button">Refresh</button><button id="capacity-override" class="btn btn-outline-warning d-none" type="button">Override Shortage</button></div>
  </section>
  <%- include('../partials/ppic-workflow-strip', { currentStage: 'CAPACITY', monthControl: 'capacity-month', dateControl: '' }) %>
  <section class="app-container capacity-content">
    <div id="capacity-alert" class="alert d-none"></div>
    <section class="capacity-filter-card capacity-commandbar">
      <div class="capacity-commandbar-primary">
        <div class="capacity-mode-tabs d-none" role="tablist" aria-label="Mode capacity planning"><button type="button" data-capacity-mode="PRODUCTION">Current Use</button><button type="button" data-capacity-mode="SIMULATION">Simulation</button></div>
        <label>Monthly Production Plan<select id="capacity-plan"><option value="">Pilih Monthly Production Plan</option></select></label>
        <label>Bulan<input id="capacity-month" type="month" title="Ganti horizon bulan tanpa reload halaman"></label>
        <label id="capacity-scenario-label" class="d-none">Capacity Setup<select id="capacity-scenario"><option value="normal">Normal</option><option value="max">Maximum</option><option value="custom">Custom Aktif</option></select></label>
        <button id="capacity-open-scenario" class="btn btn-outline-secondary capacity-setting-button d-none" type="button">Kelola Preset</button>
        <%- include('../partials/view-switcher', { viewModes: ['heatmap', 'gantt', 'calendar', 'table'], viewLabels: true, viewClass: 'capacity-view-switcher' }) %>
      </div>
      <details id="capacity-advanced-filters" class="capacity-commandbar-advanced">
        <summary>Filter lanjutan &amp; horizon tanggal</summary>
        <div class="capacity-commandbar-advanced-grid"><label>Mulai<input id="capacity-start" type="date"></label><label>Sampai<input id="capacity-end" type="date"></label><div class="capacity-commandbar-spacer"></div></div>
      </details>
    </section>
    <div id="capacity-production-guide" class="capacity-production-guide"><b>Sumber jadwal:</b><span id="capacity-production-guide-steps">Qty, tanggal, mesin, proses vendor, dan urutan mengikuti allocation tersimpan pada Monthly Production Plan.</span><small id="capacity-production-guide-lock">Capacity Planning hanya mengatur jam kerja, jumlah shift, dan overtime per mesin–tanggal. Perubahan allocation dilakukan di Monthly Production Plan.</small></div>
    <div class="capacity-runtime-fields" aria-hidden="true"><select id="capacity-shifts"><option value="1">1 shift</option><option value="2" selected>2 shift</option><option value="3">3 shift</option></select><input id="capacity-hours" type="number" value="8"><input id="capacity-efficiency" type="number" value="85"><input id="capacity-overtime" type="number" value="0"><select id="capacity-saturday"><option value="false">Libur</option><option value="true">Kerja</option></select><select id="capacity-sunday"><option value="false">Libur</option><option value="true">Kerja</option></select></div>
    <dialog id="capacity-scenario-dialog" class="capacity-dialog capacity-scenario-dialog"><div class="capacity-dialog-shell"><header class="capacity-dialog-head"><div><small>MONTHLY SIMULATION PRESET</small><h2>Preset Capacity Bulanan</h2><p>Satu bulan dapat memiliki beberapa preset. Kalender dan allocation setiap preset tetap terisolasi sampai diterapkan ke Production.</p></div><button class="capacity-dialog-close" type="button" data-close-dialog="capacity-scenario-dialog" aria-label="Tutup">×</button></header><div class="capacity-dialog-body capacity-preset-layout">
      <form id="capacity-preset-form" class="capacity-preset-form"><input id="capacity-preset-id" type="hidden">
        <div class="capacity-preset-heading"><div><small>PRESET DEFINITION</small><h3 id="capacity-preset-form-title">Buat Preset Baru</h3></div><span id="capacity-preset-state" class="capacity-count">Belum disimpan</span></div>
        <div class="capacity-preset-fields">
          <label>Nama Preset<input id="capacity-preset-name" required maxlength="100" placeholder="Contoh: Agustus Delivery Ketat"></label>
          <label>Bulan<input id="capacity-preset-month" type="month" required></label>
          <label>Default Shift / Hari<select id="capacity-preset-shift-count"><option value="1">1 Shift</option><option value="2" selected>2 Shift</option><option value="3">3 Shift</option></select></label>
          <label>Efficiency %<input id="capacity-preset-efficiency" type="number" min="1" max="100" value="85" required></label>
          <label>Sabtu<select id="capacity-preset-saturday"><option value="false">Libur</option><option value="true">Kerja</option></select></label>
          <label>Minggu<select id="capacity-preset-sunday"><option value="false">Libur</option><option value="true">Kerja</option></select></label>
        </div>
        <fieldset class="capacity-shift-window-fieldset"><legend>Jam kerja default untuk semua hari</legend><div class="capacity-shift-window-grid">
          <% for (let shift = 1; shift <= 3; shift += 1) { %><label data-preset-shift="<%= shift %>"><b>Shift <%= shift %></b><span><input id="capacity-preset-shift-<%= shift %>-start" type="time" value="<%= shift === 1 ? '08:00' : shift === 2 ? '16:00' : '00:00' %>"><i>–</i><input id="capacity-preset-shift-<%= shift %>-end" type="time" value="<%= shift === 1 ? '16:00' : shift === 2 ? '00:00' : '08:00' %>"></span></label><% } %>
        </div></fieldset>
        <div class="capacity-preset-fields"><label>Overtime Mulai<input id="capacity-preset-ot-start" type="time"></label><label>Overtime Selesai<input id="capacity-preset-ot-end" type="time"></label></div>
        <fieldset class="capacity-algorithm-fieldset"><legend>Auto-allocation berbasis delivery schedule</legend><label><input id="capacity-preset-parallel" type="checkbox" checked> Izinkan parallel lane</label><label><input id="capacity-preset-extra-shift" type="checkbox" checked> Izinkan tambah shift saat due date berisiko</label><label><input id="capacity-preset-auto-ot" type="checkbox" checked> Izinkan overtime saat phase belum tercukupi</label></fieldset>
        <p class="capacity-preset-note"><b id="capacity-preset-daily-count">0 daily override</b> · Klik tanggal pada heatmap/calendar untuk mengubah kapasitas hari tertentu di preset aktif.</p>
        <footer><button id="capacity-preset-new" class="btn btn-outline-secondary" type="button">Form Baru</button><button id="capacity-preset-save-new" class="btn btn-outline-primary" type="submit">Simpan Preset Baru</button><button id="capacity-preset-update" class="btn btn-primary d-none" type="button">Update Preset Aktif</button></footer>
      </form>
      <aside class="capacity-preset-library"><header><div><small>PRESET LIBRARY</small><h3 id="capacity-preset-library-title">Preset Bulan Aktif</h3></div><span id="capacity-preset-count" class="capacity-count">0 preset</span></header><div id="capacity-preset-list" class="capacity-preset-list"></div></aside>
    </div></div></dialog>
    <dialog id="capacity-flow-dialog" class="capacity-dialog capacity-flow-dialog"><div class="capacity-dialog-shell">
      <header class="capacity-dialog-head"><div><small>PROCESS FLOW ALGORITHM</small><h2>Aturan Aliran & Penempatan Proses</h2><p>Form ini mengatur penempatan dan hubungan antarproses produksi, bukan menghitung kapasitas harian.</p></div><button class="capacity-dialog-close" type="button" data-close-dialog="capacity-flow-dialog" aria-label="Tutup">×</button></header>
      <div class="capacity-dialog-body capacity-flow-layout">
        <form id="capacity-flow-form" class="capacity-flow-form">
          <div class="capacity-flow-identity">
            <label>Nama Aturan<input id="capacity-flow-name" required maxlength="100" placeholder="Contoh: Transfer batch produksi Agustus"></label>
            <label>Preset Auto Recommendation<select id="capacity-flow-profile"><option value="SHIFT_CAPACITY_TRANSFER">Lot Penuh, Split Jika Tidak Muat</option><option value="FULL_COMPLETION_SEQUENCE">Selesai Penuh Berurutan</option><option value="CUSTOM">Custom Algorithm</option></select><small>Preset pertama memprioritaskan satu allocation penuh dan baru membagi quantity bila kapasitas slot tidak cukup.</small></label>
            <label id="capacity-flow-method-wrap">Metode Aliran<select id="capacity-flow-method"><option value="FULL_SEQUENTIAL">Full Sequential</option><option value="SPLIT_PHASE">Split Phase</option><option value="SPLIT_BATCH">Split Batch</option><option value="CONTINUOUS_FLOW">Continuous Flow</option></select></label>
          </div>
          <details class="capacity-flow-section" open><summary><span>01</span><div><b>Flow & Transfer</b><small>Urutan mulai, pelepasan quantity, dan jeda antarproses.</small></div></summary><div class="capacity-flow-section-body">
            <div class="capacity-flow-fields" data-flow-fields="FULL_SEQUENTIAL"><label>Proses berikutnya mulai<select id="capacity-flow-sequential-start"><option value="IMMEDIATE">Langsung</option><option value="NEXT_SHIFT">Shift berikutnya</option><option value="NEXT_DAY">Hari berikutnya</option></select></label></div>
            <div class="capacity-flow-fields d-none" data-flow-fields="SPLIT_PHASE"><label>Jumlah Phase<input id="capacity-flow-phase-count" type="number" min="2" max="50" value="2"></label><label>Pembagian<select id="capacity-flow-phase-distribution"><option value="EQUAL">Sama rata</option><option value="PERCENTAGE">Persentase</option></select></label><label id="capacity-flow-phase-percentages-wrap" class="d-none">Persentase per phase<input id="capacity-flow-phase-percentages" placeholder="50, 30, 20"><small>Total harus 100%.</small></label></div>
            <div class="capacity-flow-fields d-none" data-flow-fields="SPLIT_BATCH"><label>Transfer batch quantity<input id="capacity-flow-transfer-batch" type="number" min="0.001" step="0.001" placeholder="Contoh: 100"></label><label>Minimum batch sebelum proses berikutnya mulai<input id="capacity-flow-min-release-batch" type="number" min="0" step="0.001" placeholder="Contoh: 50"></label></div>
            <div class="capacity-flow-fields d-none" data-flow-fields="CONTINUOUS_FLOW"><label>Minimum WIP<input id="capacity-flow-continuous-min-wip" type="number" min="0" step="0.001"></label><label>Maximum WIP<input id="capacity-flow-continuous-max-wip" type="number" min="0" step="0.001"></label></div>
            <div class="capacity-flow-subgroup"><h4>Jeda Antarproses</h4><div class="capacity-flow-fields"><label>Metode jeda<select id="capacity-flow-delay-mode"><option value="NONE">Tidak ada</option><option value="FIXED">Durasi tetap</option><option value="ROUTING_PROCESS">Berdasarkan routing process</option></select></label><label id="capacity-flow-delay-value-wrap" class="d-none">Nilai<input id="capacity-flow-delay-value" type="number" min="0" step="0.01"></label><label id="capacity-flow-delay-unit-wrap" class="d-none">Unit<select id="capacity-flow-delay-unit"><option value="MINUTE">Menit</option><option value="HOUR">Jam</option><option value="DAY">Hari</option></select></label></div></div>
            <fieldset class="capacity-flow-checks"><legend>Syarat Release</legend><label><input type="checkbox" name="capacity-release" value="QUANTITY_REACHED"> Quantity tercapai</label><label><input type="checkbox" name="capacity-release" value="QC_RELEASE"> QC release</label><label><input type="checkbox" name="capacity-release" value="MATERIAL_MOVED"> Material sudah dipindahkan</label><label><input type="checkbox" name="capacity-release" value="PREVIOUS_PROCESS_CLOSED"> Proses sebelumnya closed</label></fieldset>
          </div></details>
          <details class="capacity-flow-section"><summary><span>02</span><div><b>Timing & WIP</b><small>Batas WIP serta perpindahan lintas shift dan hari.</small></div></summary><div class="capacity-flow-section-body">
            <div class="capacity-flow-subgroup capacity-flow-delivery-target"><h4>Target Penyelesaian FG</h4><div class="capacity-flow-fields"><label>FG selesai sebelum delivery<input id="capacity-flow-fg-days-before" type="number" min="0" max="365" step="1" value="0"><small>Isi 0 jika selesai pada hari delivery, atau jumlah hari spare yang diinginkan.</small></label></div></div>
            <div class="capacity-flow-fields"><label>Minimum WIP<input id="capacity-flow-wip-min" type="number" min="0" step="0.001"></label><label>Maximum WIP<input id="capacity-flow-wip-max" type="number" min="0" step="0.001"></label><label>Saat maksimum tercapai<select id="capacity-flow-wip-maximum-action"><option value="WARNING">Warning</option><option value="STOP_PREVIOUS">Stop proses sebelumnya</option></select></label></div>
            <fieldset class="capacity-flow-checks"><legend>Shift dan Hari</legend><label><input id="capacity-flow-cross-shift" type="checkbox"> Boleh lintas shift</label><label><input id="capacity-flow-overnight-wip" type="checkbox"> Boleh menyimpan WIP semalaman</label></fieldset>
            <div class="capacity-flow-fields"><label>Mulai proses berikutnya<select id="capacity-flow-shift-next-start"><option value="IMMEDIATE">Segera</option><option value="SHIFT_START">Awal shift</option><option value="NEXT_DAY">Hari berikutnya</option></select></label></div>
          </div></details>
          <details class="capacity-flow-section"><summary><span>03</span><div><b>Machine & Lot</b><small>Strategi pemilihan mesin, pemecahan lot, dan traceability.</small></div></summary><div class="capacity-flow-section-body">
            <div class="capacity-flow-subgroup"><h4>Penempatan Mesin</h4><div class="capacity-flow-fields"><label>Strategi mesin<select id="capacity-flow-machine-placement"><option value="PRIMARY">Mesin utama</option><option value="ALTERNATIVE">Mesin alternatif</option><option value="FASTEST_AVAILABLE">Mesin paling cepat tersedia</option></select></label><label>Maksimum jumlah mesin<input id="capacity-flow-max-machines" type="number" min="1" max="50" value="1"></label></div><label class="capacity-flow-switch"><input id="capacity-flow-split-machines" type="checkbox"><span></span>Boleh split mesin</label></div>
            <div class="capacity-flow-subgroup"><h4>Aturan Lot</h4><div class="capacity-flow-fields"><label>Kebijakan lot<select id="capacity-flow-lot-policy"><option value="KEEP_TOGETHER">Lot tetap bersama</option><option value="ALLOW_SPLIT">Lot boleh dipecah</option><option value="ALLOW_MERGE">Lot boleh digabung</option></select></label><label id="capacity-flow-min-split-wrap" class="d-none">Minimum split quantity<input id="capacity-flow-min-split" type="number" min="0" step="0.001"></label></div><label class="capacity-flow-switch"><input id="capacity-flow-traceability" type="checkbox" checked><span></span>Pertahankan traceability material lot</label></div>
          </div></details>
          <details class="capacity-flow-section"><summary><span>04</span><div><b>Quality & Control</b><small>Setup, quality gate, penanganan NG, dan prioritas output.</small></div></summary><div class="capacity-flow-section-body">
            <div class="capacity-flow-fields"><label>Setup dilakukan<select id="capacity-flow-setup-trigger"><option value="PRODUCTION_START">Awal produksi</option><option value="EACH_PHASE">Setiap phase</option><option value="EACH_BATCH">Setiap batch</option><option value="MACHINE_CHANGE">Pindah mesin</option></select></label><label>Quality gate<select id="capacity-flow-quality-gate"><option value="NONE">Tidak ada</option><option value="SAMPLE">Sample</option><option value="FULL_BATCH">Full batch</option><option value="APPROVAL">Approval</option></select></label></div>
            <label class="capacity-flow-switch"><input id="capacity-flow-skip-same-tooling" type="checkbox"><span></span>Lewati setup jika tooling sama</label>
            <div class="capacity-flow-subgroup"><h4>NG dan Alokasi Output</h4><div class="capacity-flow-fields"><label>Good quantity<select id="capacity-flow-good-action"><option value="CONTINUE">Langsung lanjut</option><option value="WAIT_REPAIR">Tunggu repair</option><option value="WAIT_ALL_COMPLETE">Tunggu semua selesai</option></select></label><label>Prioritas output<select id="capacity-flow-output-priority"><option value="NEAREST_DELIVERY">Delivery terdekat</option><option value="FIFO">FIFO</option><option value="CUSTOMER_PRIORITY">Customer priority</option><option value="PROPORTIONAL">Proporsional</option><option value="MANUAL">Manual</option></select></label></div></div>
          </div></details>
          <footer class="capacity-flow-actions"><button id="capacity-flow-preview" class="btn btn-outline-secondary" type="button">Preview Flow</button><div><button id="capacity-flow-save-draft" class="btn btn-outline-primary" type="button">Save Draft</button><button id="capacity-flow-save-active" class="btn btn-primary" type="submit">Save Algorithm</button></div></footer>
        </form>
        <aside class="capacity-flow-summary"><div class="capacity-flow-summary-sticky"><small>RULE SUMMARY</small><div class="capacity-flow-summary-head"><h3 id="capacity-flow-summary-name">Aturan Aliran Produksi</h3><span id="capacity-flow-plan-badge">Pilih MPP</span></div><p id="capacity-flow-summary-text">Pilih metode aliran untuk melihat ringkasan aturan dalam kalimat sederhana.</p><div id="capacity-flow-summary-points" class="capacity-flow-summary-points"></div><div class="capacity-flow-preview"><b>Preview hubungan proses</b><div id="capacity-flow-preview-canvas"><span>Proses 10</span><i>→</i><span>Proses 20</span><i>→</i><span>Proses 30</span></div></div><div id="capacity-flow-save-state" class="capacity-flow-save-state">Belum ada perubahan tersimpan.</div></div></aside>
      </div>
    </div></dialog>
    <section class="capacity-stat-grid">
      <article><small>Mesin Aktif</small><strong id="capacity-stat-machines">-</strong><span id="capacity-stat-machines-note">Master machine</span><button class="capacity-stat-action" type="button" data-capacity-stat-target="readiness" aria-label="Buka detail kesiapan master data"></button></article>
      <article><small>Available Capacity</small><strong id="capacity-stat-available">-</strong><span>Jam pada horizon</span><button class="capacity-stat-action" type="button" data-capacity-stat-target="schedule" aria-label="Buka detail jadwal kapasitas"></button></article>
      <article><small>Planned Load</small><strong id="capacity-stat-load">-</strong><span id="capacity-stat-utilization">Utilization -</span><button class="capacity-stat-action" type="button" data-capacity-stat-target="process" aria-label="Buka ringkasan process loading"></button></article>
      <article><small>Overload / Unscheduled</small><strong id="capacity-stat-overload">-</strong><span id="capacity-stat-readiness">Master readiness</span><button class="capacity-stat-action" type="button" data-capacity-attention-open="all" aria-label="Buka antrian masalah kapasitas"></button></article>
    </section>
    <section class="capacity-card capacity-attention-card" aria-labelledby="capacity-attention-title"><div class="capacity-card-head capacity-attention-head"><div><h2 id="capacity-attention-title">Perlu Ditangani</h2><p>Masalah paling penting ditampilkan lebih dulu. Buka detail hanya saat diperlukan.</p></div><div class="capacity-attention-tabs" role="tablist"><button class="active" type="button" data-capacity-attention="all">Semua Risiko <span id="capacity-attention-count-all">0</span></button><button type="button" data-capacity-attention="overload">Overload <span id="capacity-attention-count-overload">0</span></button><button type="button" data-capacity-attention="unscheduled">Unscheduled <span id="capacity-attention-count-unscheduled">0</span></button><button type="button" data-capacity-attention="vendor">Vendor <span id="capacity-attention-count-vendor">0</span></button><button type="button" data-capacity-attention="readiness">Master Data <span id="capacity-attention-count-readiness">0</span></button></div></div><div id="capacity-attention-list" class="capacity-attention-list"><div class="capacity-empty">Memuat risiko kapasitas...</div></div></section>
    <details class="capacity-card capacity-scenario-compare d-none" id="capacity-scenario-comparison-card"><summary><div><h2>Scenario Comparison</h2><p>Bandingkan dua preset hanya jika diperlukan.</p></div></summary><div class="p-3 border-top"><div class="d-flex gap-2 flex-wrap mb-3"><select id="capacity-compare-a" class="form-select form-select-sm"></select><select id="capacity-compare-b" class="form-select form-select-sm"></select><button id="capacity-compare-run" class="btn btn-sm btn-outline-primary" type="button">Bandingkan</button></div><div id="capacity-scenario-comparison"><div class="capacity-empty">Pilih dua preset pada bulan yang sama.</div></div></div></details>
    <section class="capacity-card capacity-heatmap-card">
      <div id="capacity-horizon-insight" class="alert alert-info d-none mx-3 mt-3 mb-0" role="status"></div>
      <div class="capacity-card-head"><div><h2 id="capacity-main-view-title">Capacity Check dari Monthly Production Plan</h2><p id="capacity-main-view-help">Jadwal dan qty mengikuti Monthly Plan; klik mesin–tanggal untuk review beban atau mengatur jam capacity.</p></div><div class="capacity-legend"><span class="available">Available</span><span class="loaded">1–84%</span><span class="high">85–100%</span><span class="overload">Overload</span><span class="unavailable">Unavailable</span></div></div>
      <div id="capacity-material-gate" class="capacity-material-gate d-none"></div>
      <div class="capacity-data-toolbar" aria-label="Filter resource capacity"><label>Cari mesin / line<input id="capacity-resource-search" type="search" autocomplete="off" placeholder="Ketik kode, nama, line, atau spesifikasi..."></label><label>Status<select id="capacity-resource-status"><option value="ALL">Semua status</option><option value="RISK">High + overload</option><option value="OVERLOAD">Overload saja</option><option value="HIGH">High 85–100%</option><option value="LOADED">Ada beban</option><option value="EMPTY">Belum ada beban</option></select></label><label class="capacity-exception-toggle"><input id="capacity-resource-exceptions" type="checkbox"> Hanya exception</label><label>Kerapatan<select id="capacity-resource-density"><option value="comfortable">Nyaman</option><option value="compact">Ringkas</option></select></label><label>Baris<select id="capacity-resource-page-size"><option value="15">15</option><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></label><div class="capacity-resource-paging"><span id="capacity-resource-result" class="capacity-resource-result">0 mesin</span><div class="capacity-resource-pagination"><button id="capacity-resource-prev" type="button" aria-label="Halaman sebelumnya">‹</button><span id="capacity-resource-page">1 / 1</span><button id="capacity-resource-next" type="button" aria-label="Halaman berikutnya">›</button></div></div></div>
      <div id="capacity-loading" class="capacity-loading">Menghitung capacity berdasarkan master process dan machine...</div>
      <div id="capacity-table-view" class="table-responsive d-none"><table class="table capacity-detail-table"><thead><tr><th>Machine</th><th>Line / Type</th><th>Available</th><th>Firm</th><th>Proposed</th><th>Total Load</th><th>Utilization</th><th>Status</th></tr></thead><tbody id="capacity-machine-summary-body"></tbody></table></div>
      <div id="capacity-heatmap-wrap" class="capacity-heatmap-wrap d-none">
        <table id="capacity-machine-heatmap" class="capacity-heatmap"><colgroup id="capacity-heatmap-cols"></colgroup><thead id="capacity-heatmap-head"></thead><tbody id="capacity-heatmap-body"></tbody></table>
        <details class="capacity-vendor-heatmap-section" aria-labelledby="capacity-vendor-heatmap-title">
          <summary><div><b id="capacity-vendor-heatmap-title">Timeline Vendor</b><small>Kirim, proses, dan kembali</small></div><span id="capacity-vendor-timeline-count">0 allocation</span></summary>
          <table id="capacity-vendor-heatmap" class="capacity-heatmap capacity-vendor-heatmap"><colgroup id="capacity-vendor-heatmap-cols"></colgroup><thead id="capacity-vendor-heatmap-head"></thead><tbody id="capacity-vendor-heatmap-body"></tbody></table>
        </details>
      </div>
      <div id="capacity-gantt-view" class="capacity-gantt-view d-none"></div>
      <div id="capacity-calendar-view" class="capacity-calendar-view d-none"></div>
      <div id="capacity-gallery-view" class="list-gallery d-none"></div>
      <div id="capacity-kanban-view" class="list-kanban d-none"></div>
    </section>
    <section class="capacity-card capacity-workbench"><div class="capacity-workbench-header"><div><h2>Detail &amp; Tindak Lanjut</h2><p>Satu area kerja pada satu waktu; jumlah item tetap terlihat pada tab.</p></div><div class="capacity-workbench-tabs" role="tablist"><button class="active" type="button" data-capacity-workbench="schedule">Schedule</button><button type="button" data-capacity-workbench="delivery">Delivery <span id="capacity-workbench-count-delivery">0</span></button><button type="button" data-capacity-workbench="vendor">Vendor <span id="capacity-workbench-count-vendor">0</span></button><button type="button" data-capacity-workbench="unscheduled">Unscheduled <span id="capacity-workbench-count-unscheduled">0</span></button><button type="button" data-capacity-workbench="readiness">Master Data <span id="capacity-workbench-count-readiness">0</span></button><button type="button" data-capacity-workbench="process">Process Load <span id="capacity-workbench-count-process">0</span></button></div></div><div class="capacity-workbench-body">
    <div id="capacity-workbench-toolbar" class="capacity-workbench-toolbar" hidden><input id="capacity-workbench-search" type="search" autocomplete="off" placeholder="Cari pada detail aktif..."><label>Baris<select id="capacity-workbench-page-size"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></label><span id="capacity-workbench-result">0 data</span><div><button id="capacity-workbench-prev" type="button" aria-label="Halaman detail sebelumnya">‹</button><span id="capacity-workbench-page">1 / 1</span><button id="capacity-workbench-next" type="button" aria-label="Halaman detail berikutnya">›</button></div></div>
    <section class="capacity-lower-grid">
      <article id="capacity-allocation-panel" class="capacity-card capacity-workbench-panel" data-capacity-workbench-panel="schedule">
        <div class="capacity-card-head capacity-allocation-head"><div><h2 id="capacity-detail-title">Schedule dari Monthly Plan</h2><p id="capacity-detail-subtitle">Pilih cell untuk melihat beban atau mengatur jam capacity.</p></div><div class="capacity-dialog-section-actions"><button class="capacity-dialog-form-toggle primary" type="button" data-capacity-dialog-section="capacity-cell-form" aria-expanded="false">⚙ Atur Jam Capacity</button><button class="capacity-dialog-form-toggle d-none" type="button" data-capacity-dialog-section="capacity-manual-allocation-form" aria-expanded="false">＋ Allocation manual</button></div></div>
        <form id="capacity-cell-form" class="row g-2 p-3 border-bottom d-none">
          <input id="capacity-cell-machine" type="hidden"><input id="capacity-cell-date" type="hidden">
          <div class="col-12 text-muted small" id="capacity-cell-scope-note">Perubahan hanya berlaku untuk jam capacity mesin dan tanggal ini. Qty, part, proses, tanggal allocation, dan mesin sumber tetap mengikuti Monthly Production Plan.</div>
          <div class="col-md-2"><label class="form-label">Status Hari</label><select id="capacity-cell-status" class="form-select"><option>WORKING</option><option>HOLIDAY</option><option>OVERLOAD</option></select></div>
          <div class="col-md-2"><label class="form-label">Jumlah Shift</label><select id="capacity-cell-shifts" class="form-select"><option value="1">1 Shift</option><option value="2">2 Shift</option><option value="3">3 Shift</option></select></div>
          <div id="capacity-cell-shift-windows" class="col-12"><div class="capacity-daily-shift-grid"><% for (let shift = 1; shift <= 3; shift += 1) { %><label data-daily-shift-window="<%= shift %>">Shift <%= shift %><span><input id="capacity-cell-shift-<%= shift %>-start" class="form-control" type="time"><i>–</i><input id="capacity-cell-shift-<%= shift %>-end" class="form-control" type="time"></span></label><% } %></div></div>
          <div class="col-md-2"><label class="form-label">Lembur Awal</label><input id="capacity-cell-ot-start" class="form-control" type="time"></div>
          <div class="col-md-2"><label class="form-label">Lembur Akhir</label><input id="capacity-cell-ot-end" class="form-control" type="time"></div>
          <div class="col-md-3"><label class="form-label">Alasan / Audit</label><input id="capacity-cell-reason" class="form-control" required minlength="5"></div>
          <div class="col-md-1 d-flex align-items-end"><button class="btn btn-primary w-100" type="submit">Simpan</button></div>
        </form>
        <form id="capacity-manual-allocation-form" class="row g-2 p-3 border-bottom d-none">
          <input id="capacity-manual-allocation-id" type="hidden">
          <div class="col-12"><strong>Draft Allocation MPP</strong><small id="capacity-manual-help" class="d-block text-muted">Tidak perlu MO/WO. Pilih MPP dan qty untuk tanggal yang diklik; tanggal lain boleh kosong.</small></div>
          <div class="col-md-2"><label class="form-label">MPP</label><select id="capacity-manual-plan" class="form-select" required></select></div>
          <div class="col-md-2"><label class="form-label">Tanggal Alokasi</label><input id="capacity-manual-date" class="form-control" type="date" required></div>
          <div class="col-md-2"><label class="form-label">Mesin</label><select id="capacity-manual-machine" class="form-select" required></select></div>
          <div class="col-md-2"><label class="form-label">Dies (Secondary)</label><select id="capacity-manual-dies" class="form-select"><option value="">Tidak diperlukan</option></select></div>
          <div class="col-md-3"><label class="form-label">Part / Process</label><select id="capacity-manual-task" class="form-select" required></select></div>
          <div class="col-md-2"><label class="form-label">Mode</label><select id="capacity-manual-mode" class="form-select"><option value="INHOUSE">In-house</option><option value="VENDOR">Vendor</option></select></div>
          <div class="col-md-2"><label class="form-label">Shift</label><select id="capacity-manual-shift" class="form-select"><option value="1">Shift 1</option><option value="2">Shift 2</option><option value="3">Shift 3</option></select></div>
          <div class="col-md-2"><label class="form-label">Jam Mulai</label><input id="capacity-manual-start" class="form-control" type="time"></div>
          <div class="col-md-2"><label class="form-label">Jam Selesai</label><input id="capacity-manual-end" class="form-control" type="time"></div>
          <div id="capacity-manual-vendor-wrap" class="col-md-2 d-none"><label class="form-label">Vendor</label><select id="capacity-manual-vendor" class="form-select"></select></div>
          <div class="col-md-1"><label class="form-label">Qty</label><input id="capacity-manual-qty" class="form-control" type="number" min="0.001" step="0.001" required></div>
          <div class="col-md-2 d-flex align-items-end gap-1"><button id="capacity-manual-submit" class="btn btn-primary flex-grow-1" type="submit">Alokasikan</button><button id="capacity-manual-cancel-edit" class="btn btn-outline-secondary d-none" type="button">Batal</button></div>
          <div id="capacity-manual-vendor-schedule" class="col-12 d-none">
            <div class="row g-2 rounded border p-2">
              <div class="col-md-3"><label class="form-label">Tanggal Kirim Vendor</label><input id="capacity-manual-vendor-send" class="form-control" type="date"></div>
              <div class="col-md-3"><label class="form-label">Tanggal Kembali</label><input id="capacity-manual-vendor-return" class="form-control" type="date"></div>
              <div class="col-md-3"><label class="form-label">Ekspektasi Qty Kembali</label><input id="capacity-manual-vendor-return-qty" class="form-control" type="number" min="0.001" step="0.001"></div>
              <div class="col-md-3"><label class="form-label">Referensi Lead Time</label><div id="capacity-manual-vendor-leadtime" class="form-control bg-light">Pilih vendor</div></div>
              <div class="col-12 text-muted small">Cycle time BOM tidak dipakai untuk vendor. Jadwal vendor dihitung dari tanggal kirim–kembali dan lead time Vendor Master.</div>
            </div>
          </div>
          <div class="col-12"><div id="capacity-manual-recommendation" class="alert alert-info mb-0 py-2">Pilih MPP dan process untuk melihat rekomendasi kapasitas harian.</div></div>
          <div class="col-12"><label class="form-label">Catatan</label><input id="capacity-manual-notes" class="form-control" placeholder="Prioritas delivery, lot, atau alasan produksi selang-seling"></div>
          <div class="col-12"><label class="form-label">Alasan Override Freeze Fence</label><input id="capacity-manual-freeze-reason" class="form-control" placeholder="Wajib minimal 10 karakter hanya jika tanggal berada dalam freeze fence"><small class="text-muted">Simulation tidak memerlukan override. Production Capacity dekat hari eksekusi dilindungi dari perubahan tanpa alasan.</small></div>
        </form>
        <div class="table-responsive capacity-allocation-table-wrap"><table class="table capacity-detail-table capacity-allocation-table"><thead><tr><th>Sumber</th><th>Referensi</th><th>Part</th><th>Process</th><th>Shift</th><th>Qty</th><th>Load</th><th>Keputusan &amp; Audit Sistem</th></tr></thead><tbody id="capacity-detail-body"><tr><td colspan="8" class="capacity-empty">Belum ada cell dipilih.</td></tr></tbody></table></div>
      </article>
      <article class="capacity-card capacity-readiness-card capacity-workbench-panel" data-capacity-workbench-panel="readiness" hidden>
        <div class="capacity-card-head"><div><h2>Master Data Readiness</h2><p>Validasi process, routing, machine, dan cycle time.</p></div><div class="capacity-readiness-actions"><button id="capacity-use-preset" class="btn btn-sm btn-primary d-none" type="button">Pakai Preset</button><span id="capacity-readiness-badge" class="capacity-readiness-badge">Checking</span></div></div>
        <div id="capacity-readiness-list" class="capacity-readiness-list"></div>
      </article>
    </section>
    <section class="capacity-card capacity-workbench-panel" data-capacity-workbench-panel="vendor" hidden>
      <div class="capacity-card-head"><div><h2>Vendor Process Schedule</h2><p>Jadwal kirim dan kembali vendor per phase. Routing BOM hanya menjadi referensi proses.</p></div></div>
      <div class="table-responsive"><table class="table capacity-detail-table"><thead><tr><th>Kirim</th><th>Kembali</th><th>MPP</th><th>Part / Process</th><th>Vendor</th><th>Qty Kirim</th><th>Ekspektasi Kembali</th><th>Lead Time</th><th>Status</th><th>Aksi</th></tr></thead><tbody id="capacity-vendor-allocation-body"></tbody></table></div>
    </section>
    <section class="capacity-card capacity-workbench-panel" data-capacity-workbench-panel="delivery" hidden>
      <div class="capacity-card-head"><div><h2>Delivery Phase Coverage</h2><p>Blocker berdasarkan draft allocation proses terakhir yang selesai paling lambat pada due date setiap phase.</p></div><span id="capacity-delivery-coverage-badge" class="capacity-readiness-badge">Pilih MPP</span></div>
      <div class="table-responsive"><table class="table capacity-detail-table"><thead><tr><th>Phase</th><th>MPP</th><th>Part</th><th>Tujuan</th><th>Delivery Date</th><th>Target FG Selesai</th><th>Need Kumulatif</th><th>Allocation s/d Due</th><th>Shortage</th><th>Status</th></tr></thead><tbody id="capacity-delivery-coverage-body"><tr><td colspan="10" class="capacity-empty">Belum ada delivery phase pada MPS sumber.</td></tr></tbody></table></div>
    </section>
    <section class="capacity-card capacity-workbench-panel" data-capacity-workbench-panel="unscheduled" hidden>
      <div class="capacity-card-head"><div><h2>Unscheduled Load</h2><p>Demand yang belum bisa ditempatkan karena routing, machine, cycle time, atau kapasitas belum tersedia.</p></div><span id="capacity-unscheduled-count" class="capacity-count">0 item</span></div>
      <div class="table-responsive"><table class="table capacity-detail-table"><thead><tr><th>Source</th><th>Reference</th><th>Part</th><th>Process</th><th>Machine</th><th>Qty</th><th>Minutes</th><th>Reason</th></tr></thead><tbody id="capacity-unscheduled-body"></tbody></table></div>
    </section>
    <section class="capacity-card capacity-workbench-panel" data-capacity-workbench-panel="process" hidden>
      <div class="capacity-card-head"><div><h2>Process Loading Summary</h2><p>Akumulasi firm dan proposed load per routing process pada skenario yang sedang dipilih.</p></div></div>
      <div class="table-responsive"><table class="table capacity-detail-table"><thead><tr><th>Process</th><th>Machine</th><th>Firm</th><th>Proposed</th><th>Total Load</th><th>Qty</th></tr></thead><tbody id="capacity-process-load-body"></tbody></table></div>
    </section>
    </div></section>
  </section>
</main>
<%- include('../partials/footer') %>
