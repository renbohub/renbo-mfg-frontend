  <dialog id="prep-results" aria-labelledby="prep-results-title"><header><div><span class="prep-eyebrow">HASIL EKSPERIMEN</span><h2 id="prep-results-title">Simulasi PPIC Plan Lab</h2></div><button id="prep-close-results" aria-label="Tutup hasil simulasi">✕</button></header><div id="prep-results-body"></div></dialog>
</main>
