<main class="prep-page prep-unified-workbook" data-quantity-formatted="true">
  <header class="prep-heading"><div><span class="prep-eyebrow">PPIC · 4.1</span><h1>PPIC Plan Lab <span class="prep-draft">Readiness &amp; simulasi</span></h1><p>Periksa parameter planning, lalu susun delivery, produksi, dan kedatangan material.</p></div></header>
  <nav class="prep-lab-tabs" aria-label="Halaman PPIC Plan Lab" role="tablist">
    <button id="prep-page-readiness" role="tab" aria-selected="true" aria-controls="prep-readiness-panel" data-lab-page="readiness">01 <span>Master Data Readiness</span></button>
    <button id="prep-page-workbook" role="tab" aria-selected="false" aria-controls="prep-workbook-panel" data-lab-page="workbook" tabindex="-1">02 <span>Worksheet Schedule</span></button>
    <button id="prep-page-capacity" role="tab" aria-selected="false" aria-controls="prep-capacity-panel" data-lab-page="capacity" tabindex="-1">03 <span>Detail Capacity Production</span></button>
    <button id="prep-page-purchase" role="tab" aria-selected="false" aria-controls="prep-purchase-panel" data-lab-page="purchase" tabindex="-1">04 <span>Purchase / Request Material Requirement</span></button>
    <button id="prep-page-vendor" role="tab" aria-selected="false" aria-controls="prep-vendor-panel" data-lab-page="vendor" tabindex="-1">05 <span>Vendor Requirement</span></button>
    <button id="prep-page-daily" role="tab" aria-selected="false" aria-controls="prep-daily-panel" data-lab-page="daily" tabindex="-1">06 <span>Daily Production Simulation</span></button>
    <button id="prep-page-delivery" role="tab" aria-selected="false" aria-controls="prep-delivery-panel" data-lab-page="delivery" tabindex="-1">07 <span>Delivery Schedule</span></button>
    <button id="prep-page-kpi" role="tab" aria-selected="false" aria-controls="prep-kpi-panel" data-lab-page="kpi" tabindex="-1">08 <span>KPI Simulation</span></button>
  </nav>
  <link rel="stylesheet" href="/css/ppic-lab-release.css?v=20260915-release-1">
  <section class="prep-lifecycle" aria-label="Tools PPIC plan">
    <label>Bulan plan <input id="prep-plan-month" type="month" value="<%= initialMonth %>"></label>
    <span id="prep-lock-status" role="status" aria-live="polite">Memuat status bulan…</span>
    <button id="prep-rollback-system" type="button" disabled>Rollback ke hitungan sistem</button>
    <button id="prep-lock-review" class="prep-release-primary" type="button" disabled>Lock &amp; Ajukan ETA</button>
    <button id="prep-eta-review" class="prep-release-primary" type="button" hidden>Review ETA &amp; Perubahan</button>
    <a id="prep-released-link" href="/modules/planning-ppic/released?month=<%= initialMonth %>">PPIC Released Data →</a>
    <span id="prep-global-message" role="status" aria-live="polite" hidden></span>
  </section>
  <dialog id="prep-release-dialog" class="prep-release-dialog" aria-labelledby="prep-release-title">
    <h2 id="prep-release-title">Lock &amp; Ajukan Konfirmasi ETA</h2><div id="prep-release-review" role="status" aria-live="polite"></div>
    <footer><button id="prep-release-cancel" type="button">Tutup</button><button id="prep-release-confirm" type="button" disabled>Lock &amp; ajukan konfirmasi</button></footer>
  </dialog>
  <dialog id="prep-eta-dialog" class="prep-release-dialog prep-eta-dialog" aria-labelledby="prep-eta-title">
    <h2 id="prep-eta-title">Review konfirmasi sebelum release</h2>
    <div id="prep-eta-content" role="status" aria-live="polite"></div>
    <label class="prep-eta-reason">Alasan pengajuan ulang ETA<textarea id="prep-eta-reason" rows="2" placeholder="Isi alasan jika perlu meminta ETA baru"></textarea></label>
    <footer><button id="prep-eta-close" type="button">Tutup</button><button id="prep-eta-resubmit" type="button" disabled>Ajukan Ulang ETA</button><button id="prep-eta-confirm" class="prep-release-primary" type="button" disabled>Confirm Release</button></footer>
  </dialog>
  <section id="prep-confirmation-feedback" class="ppic-eta-feedback" aria-label="Konfirmasi ETA dan perubahan jadwal" hidden></section>
  <section id="prep-readiness-panel" class="prep-readiness" role="tabpanel" aria-labelledby="prep-page-readiness">
    <div id="prep-readiness-message" role="status" aria-live="polite">Memuat kondisi master data…</div>
    <div id="prep-recovery-notice" class="prep-recovery-notice" role="status" hidden><span id="prep-recovery-notice-text"></span><button id="prep-recovery-recheck" type="button">Periksa hasil perbaikan</button></div>
    <section class="prep-workbook prep-readiness-workbook" aria-label="Workbook monitoring master data">
    <header class="prep-sheetbar prep-readiness-heading"><h2 class="prep-workbook-title">Master Data Readiness</h2><div class="prep-readiness-actions prep-sheet-meta"><label>Periode pemeriksaan<input type="month" id="prep-readiness-month" value="<%= initialMonth %>" aria-label="Periode master data readiness"></label><button id="prep-readiness-refresh" type="button">↻ Periksa ulang</button></div></header>
    <div class="prep-sheetbar prep-recovery-toolbar"><div role="group" aria-label="Tampilan monitoring"><button id="prep-view-recovery" type="button" aria-pressed="true">Daftar perbaikan</button><button id="prep-view-overview" type="button" aria-pressed="false">Ringkasan parameter</button></div><span id="prep-recovery-total"></span></div>
    <div class="prep-ribbon prep-readiness-filters">
      <label class="prep-readiness-search">Cari masalah<input id="prep-readiness-search" type="search" placeholder="Part, supplier, BOM, atau parameter…"></label>
      <label>Kategori<select id="prep-readiness-category" aria-label="Filter kategori parameter" data-searchable-disabled><option value="">Semua kategori</option></select></label>
      <label>Proses<select id="prep-readiness-stage" aria-label="Filter proses planning" data-searchable-disabled><option value="">Semua proses</option><option>MPS</option><option>MRP</option><option>MPP</option><option>DPP</option></select></label>
      <label>Kondisi<select id="prep-readiness-status" aria-label="Filter kondisi master" data-searchable-disabled><option value="ATTENTION" selected>Perlu ditangani</option><option value="">Semua kondisi</option><option value="INCOMPLETE">Perlu dilengkapi</option><option value="FALLBACK">Menggunakan fallback</option><option value="EMPTY">Data belum tersedia</option><option value="ERROR">Gagal diperiksa</option><option value="COMPLETE">Lengkap</option><option value="NOT_APPLICABLE">Tidak berlaku</option></select></label>
      <button id="prep-readiness-reset" type="button">Reset filter</button>
    </div>
    <div class="prep-sheet-heading prep-recovery-caption"><strong>Parameter / kondisi</strong><span id="prep-readiness-count"></span><span id="prep-recovery-page-label"></span></div>
    <dialog id="prep-recovery-detail" aria-label="Rincian kondisi dan sumber perbaikan"><button id="prep-recovery-detail-close" type="button" autofocus>Tutup ×</button><div id="prep-recovery-detail-content"></div></dialog>
    <section id="prep-recovery-panel" aria-label="Daftar tindakan perbaikan">
      <div class="prep-recovery-table-wrap" tabindex="0" role="region" aria-label="Tabel tindakan perbaikan"><table class="prep-recovery-table prep-master-grid" data-enterprise-table="off"><thead><tr><th scope="col"><span class="prep-col-letter" aria-hidden="true">A</span>Parameter / kondisi</th><th scope="col"><span class="prep-col-letter" aria-hidden="true">B</span>Part / nama</th><th scope="col"><span class="prep-col-letter" aria-hidden="true">C</span>Part Number</th><th scope="col"><span class="prep-col-letter" aria-hidden="true">D</span>Supplier / BOM</th><th scope="col"><span class="prep-col-letter" aria-hidden="true">E</span>Dampak &amp; sumber</th><th scope="col"><span class="prep-col-letter" aria-hidden="true">F</span>Pengisian master</th></tr></thead><tbody id="prep-recovery-body"><tr><td colspan="6">Memuat daftar perbaikan…</td></tr></tbody></table></div>
      <nav class="prep-recovery-pagination" aria-label="Halaman daftar perbaikan"><button id="prep-recovery-prev" type="button">← Sebelumnya</button><span>15 tindakan per halaman</span><button id="prep-recovery-bottom-recheck" type="button">↻ Periksa ulang</button><button id="prep-recovery-next" type="button">Berikutnya →</button></nav>
    </section>
    <div id="prep-overview-panel" class="prep-readiness-table-wrap" tabindex="0" role="region" aria-label="Tabel kelengkapan master data" hidden><table class="prep-readiness-table prep-master-grid" data-enterprise-table="off"><thead><tr><th scope="col"><span class="prep-col-letter" aria-hidden="true">A</span>Parameter / sumber master</th><th scope="col"><span class="prep-col-letter" aria-hidden="true">B</span>Dibutuhkan oleh</th><th scope="col"><span class="prep-col-letter" aria-hidden="true">C</span>Kondisi</th><th scope="col"><span class="prep-col-letter" aria-hidden="true">D</span>Data lengkap</th><th scope="col"><span class="prep-col-letter" aria-hidden="true">E</span>Penanggung jawab</th><th scope="col"><span class="prep-col-letter" aria-hidden="true">F</span>Tindak lanjut</th></tr></thead><tbody id="prep-readiness-body"><tr><td colspan="6">Memuat pemeriksaan…</td></tr></tbody></table></div>
    </section>
    <details class="prep-summary-details prep-readiness-summary-details"><summary>Ringkasan kelengkapan &amp; proses planning</summary><p class="prep-help">Kondisi dan kelengkapan parameter untuk MPS, MRP, MPP, dan DPP.</p><div class="prep-readiness-summary" id="prep-readiness-summary" aria-label="Ringkasan kelengkapan parameter"></div><div id="prep-readiness-stages" class="prep-readiness-stages" aria-label="Parameter per proses planning"></div></details>
    <div class="prep-recovery-guide"><strong>1. Pilih masalah</strong><span>→</span><strong>2. Isi &amp; simpan di master</strong><span>→</span><strong>3. Kembali &amp; periksa ulang</strong><small>Master dibuka di tab baru. Status hanya berubah setelah hasil pemeriksaan terbaru.</small></div>
    <footer class="prep-readiness-footer"><p id="prep-readiness-scope">Monitoring ini hanya membaca master. Kelengkapan parameter bukan persetujuan rencana atau jaminan jadwal feasible.</p><span id="prep-readiness-checked"></span></footer>
  </section>
  <section id="prep-workbook-panel" role="tabpanel" aria-labelledby="prep-page-workbook" hidden>
  <div id="prep-message" role="status" hidden></div>
  <section class="prep-workbook" aria-label="Worksheet Schedule PPIC Plan Lab">
    <div class="prep-sheetbar"><div role="tablist" aria-label="Sheet preparation"><button role="tab" data-sheet="delivery" aria-selected="true">FG &amp; Child Proses <span id="prep-tab-delivery">0</span></button></div>
      <section class="prep-scenario" aria-label="Skenario persiapan">
        <input id="prep-month" type="month" value="<%= initialMonth %>" aria-label="Periode preparation" title="Periode">
        <input class="prep-name" id="prep-name" maxlength="100" placeholder="Nama eksperimen PPIC" aria-label="Nama skenario">
        <select class="prep-saved" id="prep-scenarios" data-searchable-disabled aria-label="Buka draft tersimpan"><option value="">Skenario baru</option></select>
        <button id="prep-source">Ambil data bulan</button><button id="prep-new">Draft kosong</button>
        <div class="prep-actions" id="prep-workbook-actions" hidden><button id="prep-export">Ekspor Excel</button><button id="prep-simulate" class="prep-blue">Perbarui alokasi</button><button id="prep-save" class="prep-primary">Simpan draft</button></div>
      </section>
    </div>
    <div class="prep-ribbon"><div class="prep-edit-actions"><button id="prep-undo" title="Undo (Ctrl+Z)" aria-label="Undo">↶</button><button id="prep-redo" title="Redo (Ctrl+Y)" aria-label="Redo">↷</button><span class="prep-divider"></span><button id="prep-expand-all">Buka semua FG</button><button id="prep-collapse-all">Tutup semua FG</button><button id="prep-add">＋ Tambah FG</button><button id="prep-delete" data-confirm-delete="off" title="Hapus dari draft; dapat dikembalikan dengan Undo">Hapus baris terpilih</button></div><input id="prep-search" type="search" placeholder="Cari di sheet ini…" aria-label="Cari di sheet aktif"><span id="prep-save-status">Belum tersimpan</span></div>
    <div class="prep-bom-toolbar"><button id="prep-bom-check" type="button" disabled>Cek perubahan BOM</button><button id="prep-bom-apply" type="button" class="prep-blue" hidden>Ambil perubahan BOM</button><button id="prep-vendor-lead-time" type="button" disabled>Lead time vendor</button><button id="prep-reset-demand-adjustment" type="button" disabled>Buffer/shortage: kembali otomatis</button><span id="prep-bom-status" role="status" aria-live="polite">Menunggu hasil BOM…</span><details id="prep-bom-warnings" hidden><summary>Catatan pemeriksaan BOM</summary><p id="prep-bom-warning-text"></p></details></div>
    <div class="prep-demand-legend"><span class="prep-demand-ready">Hijau: siap sebelum delivery</span><span class="prep-demand-tight">Kuning: siap pada hari delivery</span><span class="prep-demand-shortage">Merah: tidak cukup saat delivery</span><span>⚙ Total shortage + buffer · klik sel untuk rincian dan edit · header LIBUR mengikuti Master Working Hours.</span></div>
    <div class="prep-cellbar"><output id="prep-cell-address">—</output><span>Nilai sel</span><input id="prep-cell-value" aria-label="Nilai sel terpilih" placeholder="Pilih sel pada tabel" disabled><span id="prep-cell-label"></span></div>
    <div class="prep-allocation-settings"><a href="/master-data/working-hour-profiles" target="_blank" rel="noopener noreferrer" title="Sumber jam kerja: profil aktif sesuai periode dan prioritas master">Jam kerja: Master Working Hours ↗</a><label>Planned Downtime <input id="prep-planned-downtime" type="text" inputmode="decimal" value="0" aria-label="Planned downtime jam per hari"> jam/hari</label><label>Jeda Antar Proses <input id="prep-process-gap" type="text" inputmode="decimal" value="0" aria-label="Jeda antar proses jam"> jam</label><button id="prep-reset-allocations" type="button">Reset alokasi manual</button><span id="prep-allocation-status" role="status">Belum dihitung</span><details><summary>Catatan alokasi</summary><p>0 berarti tanpa downtime/jeda tambahan. Downtime berlaku per mesin per hari; jeda adalah jam kalender setelah satu lot selesai, termasuk release operasi terakhir sebelum delivery. Jam kerja hanya dari Master Working Hours aktif sesuai periode/prioritas, tidak memerlukan assignment mesin/work center dan tidak mengambil preset kapasitas. Cycle time tetap dari routing WIP. Header tetap per tanggal. Khusus vendor, setiap sel terbagi dua: ▼ hijau di kiri = qty masuk kembali, ▲ merah di kanan = qty keluar ke vendor. Klik ▲ qty keluar untuk mengisi jadwal kirim; ▼ qty masuk dihitung otomatis dari lead time aktif. Klik label lead time pada proses vendor untuk menyesuaikan nilai di workbook atau kembali ke BOM. Override workbook tidak mengubah master dan tetap dipertahankan saat mengambil perubahan BOM. Draft lama berbasis qty masuk tetap dipertahankan sampai qty keluar diedit. Lead time memakai durasi persis satuan BOM (1 DAY = 24 jam), sebagai waktu berlalu, bukan kapasitas harian vendor. Unallocated Qty pada proses = kebutuhan bersih dikurangi qty isian tanggal; pada FG = kebutuhan yang belum ditutup stok/output valid. Tanda ⚠ menunjukkan alokasi belum valid. Edit tanggal menjadi override manual dan tidak ditimpa saat Perbarui alokasi; Reset mengembalikan hitungan otomatis.</p><ul id="prep-allocation-issues"></ul></details></div>
    <div class="prep-sheet-heading"><strong id="prep-sheet-title">Production Schedule</strong><span id="prep-sheet-hint">Klik dua kali untuk edit. Pilih rentang lalu Ctrl+C / Ctrl+V dari Excel.</span><span id="prep-selection-status">Siap</span></div>
    <div id="prep-grid" aria-label="Tabel spreadsheet PPIC"></div>
    <div class="prep-numbering-legend"><strong>Nomor = Proses utama.Cabang.Turunan</strong><span>Utama: 001.000.000 → 002.000.000 → 003.000.000.</span><span>Cabang proses 003: 003.001.000 / 003.002.000. Turunan: 003.001.001, 003.001.002, dst.</span><small>Nomor dimulai ulang per FG dan menunjukkan posisi pada explode, bukan waktu mulai produksi. Level cabang lebih dalam menambah segmen tiga digit. Concurrent Operations = kandidat operasi bersamaan; Precedence Constraint = tunggu semua Predecessor selesai. Alokasi otomatis memakai kapasitas kalender dan cycle time yang tersedia. Vendor dijadwalkan berdasarkan lead time BOM atau override workbook, belum memvalidasi kapasitas harian vendor. Beban jadwal resmi dan tenaga kerja belum diperhitungkan. Ketersediaan material belum membatasi jadwal; kebutuhan pembeliannya ada di tab 04. Qty manual yang bermasalah ditandai, bukan dianggap coverage.</small></div>
  </section>
  <p class="prep-help">Klik dua kali atau Enter untuk edit · Tab / tombol panah untuk berpindah · Ctrl+C / Ctrl+V untuk salin dan tempel qty per tanggal · Vendor: klik ▲ Keluar di kanan untuk edit; ▼ Masuk di kiri otomatis · Koma untuk desimal. Semua perubahan disimpan sebagai draft terpisah.</p>
  <details class="prep-summary-details"><summary>Ringkasan workbook &amp; status explode</summary><section class="prep-metrics" aria-label="Ringkasan workbook"><article><span>FG Delivery Need</span><strong id="prep-delivery-total">—</strong><small>Qty kebutuhan delivery · tidak menjumlahkan child</small></article><article><span>Child proses BOM</span><strong id="prep-tree-count">—</strong><small>In-house / vendor · dihitung otomatis</small></article><article><span>Material Need</span><strong>Lihat tab 04</strong><small>Rekomendasi purchase terpisah dari grid jadwal</small></article><article><span>Status explode</span><strong id="prep-result-status">Belum dihitung</strong><button id="prep-show-result" hidden>Lihat hasil simulasi →</button></article></section></details>
  <details class="prep-source-notes"><summary>Dasar data dan perhitungan</summary><p id="prep-tree-basis">Delivery Need FG → alokasi proses berdasarkan kapasitas. Material Need dilewati.</p><p>H = Current Stock (stok fisik terbaca), I = Unallocated Qty (kebutuhan yang belum tertutup stok usable dan alokasi). Stok reserved/QC tidak dipakai. Stok yang sama tidak dijumlahkan antar baris routing. Alokasi otomatis memperhitungkan jam kerja, cycle time, downtime dan jeda proses; angka manual tetap disimpan sebagai draft dan diperiksa ulang. Data produksi/material draft lama tidak diubah.</p><ul id="prep-source-notes"></ul></details>
  </section>
  <% for (const [view,number,title,description] of [['capacity','03','Detail Capacity Production','Beban = qty × CT Actual BOM + pergantian coil/dies. Kapasitas efektif = jam kerja setelah downtime × 90%.'],['purchase','04','Purchase / Request Material Requirement','Purchase Part dan Material mengikuti jadwal proses tab 02. Material type dan lebar dari BOM/master material. Usulan awal belum dikurangi stok material dan PO terbuka; bukan jumlah pembelian final.'],['vendor','05','Vendor Requirement','Rencana kirim dan terima mengikuti qty keluar vendor di tab 02 serta lead time BOM atau override workbook. Nama PT/vendor dari master vendor pada routing BOM.']]) { %>
  <section id="prep-<%= view %>-panel" class="prep-derived-panel" role="tabpanel" aria-labelledby="prep-page-<%= view %>" hidden>
    <section class="prep-workbook" aria-label="Tabel <%= title %>">
      <header class="prep-sheetbar prep-derived-heading"><h2 class="prep-workbook-title"><%= title %></h2><div class="prep-sheet-meta prep-derived-source"><strong id="prep-<%= view %>-scenario"></strong><button id="prep-<%= view %>-back" type="button">Edit di 02 Worksheet Schedule</button></div></header>
      <div class="prep-ribbon prep-derived-toolbar"><span class="prep-sheet-readonly"><%= view==='capacity'?'Klik persentase atau qty untuk edit draft':'Hanya baca · berubah otomatis saat tab 02 berubah' %></span><% if(view==='capacity') { %><div class="prep-capacity-actions"><button id="prep-capacity-refresh" type="button" title="Baca CT Actual terbaru dari BOM dan hitung ulang kapasitas; alokasi manual tetap dipertahankan">Refresh CT dari BOM</button><button id="prep-capacity-expand" type="button" title="Buka semua mesin pada halaman ini" disabled>Buka semua mesin</button><button id="prep-capacity-collapse" type="button" title="Tutup semua mesin pada halaman ini" disabled>Tutup semua mesin</button></div><% } %><input id="prep-<%= view %>-search" type="search" aria-label="Cari <%= title %>" placeholder="<%= view==='purchase'?'Cari part, material type, lebar, supplier…':'Cari tanggal, part, atau kondisi…' %>" disabled><span id="prep-<%= view %>-status" class="prep-sheet-status" role="status" aria-live="polite">Menunggu sumber tab 02…</span></div>
      <div class="prep-sheet-heading"><strong>Hasil otomatis tab 02</strong><span><%= description %></span></div>
      <% if(view==='capacity') { %><p class="prep-capacity-legend">Mesin: <strong>% kapasitas terpakai</strong> · <span class="prep-capacity-band low">&lt;80% hijau</span> <span class="prep-capacity-band medium">80–&lt;100% kuning</span> <span class="prep-capacity-band high">≥100% merah</span> · Klik % untuk lembur/overlap · Klik qty untuk qty dan pergantian · Buka + untuk qty &amp; beban child part · — belum terverifikasi · Total mesin tetap utuh saat pencarian part.</p><% } %>
      <div class="prep-derived-table-wrap" role="region" tabindex="0" aria-label="Data <%= title %>"><table id="prep-<%= view %>-table" class="prep-derived-table<%= view==='capacity'?' prep-capacity-matrix':'' %>" data-enterprise-table="off"><thead id="prep-<%= view %>-head"></thead><tbody id="prep-<%= view %>-body"></tbody></table></div>
      <% if(view==='capacity') { %><p class="prep-capacity-options-legend" aria-label="Legenda lembur dan overlap"><span><span class="prep-capacity-marker overtime">◷ 1</span> Lembur shift 1</span><span><span class="prep-capacity-marker overtime">◷ 2</span> Lembur shift 2</span><span><span class="prep-capacity-marker overtime">◷ 1+2</span> Lembur shift 1 &amp; 2</span><span><span class="prep-capacity-marker overlap">↔</span> Overlap / kerja saat istirahat</span><span><i class="prep-capacity-legend-holiday" aria-hidden="true"></i> LIBUR · kapasitas 0</span><span>Masuk · pilihan pada draft</span><span>Efisiensi 90%</span></p><% } %>
      <nav class="prep-derived-pagination" aria-label="Halaman <%= title %>"><button id="prep-<%= view %>-prev" type="button" disabled>← Sebelumnya</button><span id="prep-<%= view %>-count"></span><button id="prep-<%= view %>-next" type="button" disabled>Berikutnya →</button></nav>
    </section>
    <details id="prep-<%= view %>-notes" class="prep-derived-notes" hidden><summary id="prep-<%= view %>-notes-count">Catatan sumber</summary><ul id="prep-<%= view %>-warnings"></ul></details>
    <details class="prep-source-notes prep-derived-basis-details"><summary>Dasar data dan perhitungan</summary><p id="prep-<%= view %>-basis" class="prep-derived-basis"></p></details>
    <p class="prep-help">Hasil mengikuti draft aktif, termasuk perubahan belum disimpan. Tidak membuat jadwal resmi, PR/PO, atau reservasi stok.</p>
  </section>
  <% } %>
