<%- include('../partials/head') %>
<link rel="stylesheet" href="/css/ppic-mps-workbench.css?v=20260904-mps-checkpoint-1">
<link rel="stylesheet" href="/css/ppic-mps-workbench-phase-freeze.css?v=20260819-1">
<%- include('../partials/header-modules') %>
<%- include('../partials/module-subnav', { activePage: 'mps' }) %>

<main class="mwb-page ppic-page">
  <header class="mwb-head app-container planning-shared-header">
    <div class="mwb-title-block">
      <span class="mwb-eyebrow">PLANNING PPIC</span>
      <h1>Master Production Schedule</h1>
    </div>
    <div class="mwb-head-actions">
      <label class="mwb-search"><%- include('../partials/icon', { name: 'search' }) %><input id="mwb-search" type="search" placeholder="Cari data PPIC..." autocomplete="off"></label>
      <select id="mwb-status" data-searchable-disabled aria-label="Filter status"><option value="">Semua Status</option></select>
      <a id="mwb-recovery-kanban" class="mwb-outline-action" href="/modules/planning-ppic/mps/recovery-kanban?month=<%= initialMonth %>">Recovery Kanban</a>
      <button id="mwb-density" class="mwb-view-button" type="button" title="Ubah kerapatan tabel">▦</button>
      <button id="mwb-export" class="mwb-outline-action" type="button">↓&nbsp; Export CSV</button>
      <button id="mwb-sync" class="mwb-primary-action" type="button">＋&nbsp; <span class="mwb-sync-full">Buat MPS Production Plan</span><span class="mwb-sync-short">Buat MPS</span></button>
    </div>
  </header>

  <%- include('../partials/ppic-workflow-strip', { currentStage: 'MPS', monthControl: 'mwb-month', dateControl: '' }) %>

  <section class="mwb-period-bar app-container" aria-label="Periode produksi">
    <div class="mwb-period-left">
      <strong>Periode Produksi:</strong>
      <label class="mwb-month-picker"><span aria-hidden="true">▣</span><input id="mwb-month" type="month" value="<%= initialMonth %>"></label>
      <div class="mwb-window-pills" aria-label="Jendela EFD">
        <span id="mwb-pill-m1">M-1</span><i>→</i><span id="mwb-pill-m" class="current">M</span><i>→</i><span id="mwb-pill-mp1" class="lookahead">M+1</span>
      </div>
    </div>
    <span id="mwb-doc-status" class="mwb-doc-status">Memuat</span>
  </section>

  <section class="mwb-efd-window app-container" aria-label="EFD tiga bulan">
    <article><span id="mwb-efd-m1-label">EFD M-1</span><strong id="mwb-efd-m1">0</strong></article>
    <article class="current"><span id="mwb-efd-m-label">EFD M</span><strong id="mwb-efd-m">0</strong></article>
    <article class="lookahead"><span id="mwb-efd-mp1-label">EFD M+1</span><strong id="mwb-efd-mp1">0</strong><small>Look-ahead · acuan buffer</small></article>
    <article class="total"><span>Total EFD Window</span><strong id="mwb-efd-total">0</strong><small id="mwb-efd-rule">Memuat general rule…</small></article>
  </section>

  <section class="mwb-source app-container mwb-aux-data" aria-hidden="true">
    <div><span>REVISION RESMI</span><strong id="mwb-source-title">Memuat MPS…</strong><small id="mwb-source-meta">Angka workbench dibaca dari revision MPS pada demand horizon aktif.</small></div>
    <div class="mwb-legend"><span><i class="free"></i>Free FG</span><span><i class="pegged"></i>Pegged SO</span><span><i class="receipt"></i>Firm receipt</span><span><i class="production"></i>Planned production</span></div>
  </section>

  <section id="mwb-next-state" class="mwb-next-state mwb-status-overview app-container" aria-label="Status workflow MPS" aria-live="polite">
    <div class="mwb-flow-step"><span>1</span><div><small>Status Dokumen MPS</small><strong id="mwb-flow-mps">Memuat…</strong></div></div>
    <i aria-hidden="true">→</i>
    <div class="mwb-flow-step"><span>2</span><div><small>Planning Gates</small><strong id="mwb-flow-gate">Menunggu data</strong></div></div>
    <i aria-hidden="true">→</i>
    <div class="mwb-flow-step"><span>3</span><div><small>Status MRP</small><strong id="mwb-flow-mrp">Belum ada run</strong></div></div>
    <div class="mwb-next-copy"><b id="mwb-next-title">Memeriksa langkah berikutnya…</b><small id="mwb-next-copy"></small><a id="mwb-open-mrp" href="#" hidden>Buka MRP Planning Run</a></div>
  </section>

  <section class="mwb-feasibility-legend app-container" aria-label="Definisi status feasibility MPS">
    <article class="success"><span aria-hidden="true">✓</span><div><strong>Feasible</strong><small>Semua parameter yang berlaku lolos</small></div></article>
    <article class="warning"><span aria-hidden="true">!</span><div><strong>Feasible dengan Risiko</strong><small>Critical check lolos, tetapi terdapat risiko</small></div></article>
    <article class="danger"><span aria-hidden="true">×</span><div><strong>Tidak Feasible</strong><small>Minimal satu critical constraint gagal</small></div></article>
    <article class="neutral"><span aria-hidden="true">?</span><div><strong>Belum Dievaluasi</strong><small>Data critical belum tersedia atau belum dicek</small></div></article>
    <article class="muted"><span aria-hidden="true">—</span><div><strong>Tidak Berlaku</strong><small>Tidak ada parameter schedule yang berlaku</small></div></article>
  </section>

  <section class="mwb-kpis app-container mwb-aux-data" aria-hidden="true">
    <article><span>Gross Demand</span><strong id="mwb-kpi-demand">0</strong><small>FCC + SO efektif</small></article>
    <article><span>Free FG</span><strong id="mwb-kpi-free">0</strong><small>qtyAvailable</small></article>
    <article><span>Pegged Reservation</span><strong id="mwb-kpi-pegged">0</strong><small>SO yang sama saja</small></article>
    <article><span>Firm Receipt</span><strong id="mwb-kpi-receipt">0</strong><small>Open MO due bucket</small></article>
    <article class="buffer"><span>Buffer Prepare</span><strong id="mwb-kpi-buffer">0</strong><small>FCC bulan depan × master %</small></article>
    <article><span>Planned Production</span><strong id="mwb-kpi-production">0</strong><small>Customer + buffer</small></article>
    <article class="risk"><span>Uncovered / Variance</span><strong id="mwb-kpi-risk">0</strong><small id="mwb-kpi-risk-meta">0 line perlu review</small></article>
  </section>

  <section class="mwb-board app-container">
    <header class="mwb-board-meta"><div><span>MPS PRODUCTION PLANNING MATRIX</span><h2 id="mwb-title">Master Production Schedule</h2><p id="mwb-result-meta">Memuat data…</p></div></header>
    <div class="mwb-baseline-toolbar" aria-label="Kontrol Lock MPS dan perubahan PO">
      <div><span>PO+ BASELINE · BUKAN APPROVAL MPS</span><strong id="mwb-baseline-status">Memeriksa baseline PO…</strong><small id="mwb-baseline-meta">PO+ membandingkan PO aktif dengan PO ketika baseline dikunci.</small></div>
      <div class="mwb-baseline-actions"><button id="mwb-lock-mps" class="mwb-outline-action" type="button" disabled>🔒 Lock MPS (PO Baseline)</button><button id="mwb-recalculate" class="mwb-primary-action" type="button" disabled>＋ Generate Delta MPS</button></div>
    </div>
    <div id="mwb-alert" class="mwb-alert" hidden></div>
    <div class="mwb-table-scroll" tabindex="0" aria-label="Matriks MPS, geser horizontal untuk melihat seluruh kolom"><table class="mwb-table mwb-demand-table" data-enterprise-sort="off"><colgroup><col class="c-toggle"><col class="c-pn"><col class="c-name"><col class="c-type"><col class="c-efd"><col class="c-dlv"><col class="c-short"><col class="c-efd-m"><col class="c-po-delta"><col class="c-efd-next"><col class="c-buff-p"><col class="c-buff-q"><col class="c-qty-fg"><col class="c-stock"><col class="c-mps"><col class="c-lt"><col class="c-capacity"><col class="c-load"><col class="c-action"><col class="c-checklist"><col class="c-status"></colgroup><thead><tr class="mwb-group-head"><th colspan="4"></th><th colspan="3" id="mwb-group-m1">M-1</th><th colspan="2" id="mwb-group-m">M</th><th colspan="3" id="mwb-group-mp1" class="mwb-lookahead-group">M+1 · Look-ahead</th><th>Qty/FG</th><th class="stock-group">Current Stock</th><th colspan="4">Production Plan &amp; RCCP</th><th class="mwb-group-action">Aksi</th><th class="mwb-group-checklist">Checklist Penilaian</th><th class="mwb-group-status">Status</th></tr><tr class="mwb-sub-head"><th>▶</th><th>Part Number</th><th>Part Name</th><th>Type</th><th>EFD</th><th>DLV</th><th>Shortage</th><th>EFD</th><th class="mwb-po-delta-head" title="PO aktif dikurangi PO saat Lock MPS">PO+</th><th class="mwb-lookahead-head" title="Demand EFD M+1 ditampilkan langsung sebagai look-ahead">EFD</th><th>Buff%</th><th>Buff Qty</th><th>Qty/FG</th><th>Stock</th><th>MPS Qty</th><th>Lead Time</th><th>Capacity</th><th>Load</th><th aria-label="Aksi">Aksi</th><th title="Stok, kapasitas, supplier/customer, jam kerja, dan buffer">Checklist</th><th>Status</th></tr></thead><tbody id="mwb-body"><tr><td colspan="21" class="mwb-empty">Memuat MPS…</td></tr></tbody></table></div>
    <p class="mwb-formula">Formula: MPS Qty = Shortage(M-1) + EFD(M) + (Buffer% × EFD M+1), dinetkan terhadap available stock dan firm receipt.</p>
    <div class="mwb-action-bar"><p id="mwb-action-note">Catatan: netting, RCCP, delivery feasibility, dan checklist dihitung otomatis saat MPS dibuat atau dihitung ulang.</p><div><button id="mwb-bulk-accept-late" class="mwb-primary-action" type="button" hidden disabled>! Accept Late Semua</button><button id="mwb-confirm-mps" class="mwb-primary-action" type="button" disabled>Approve MPS</button><button id="mwb-run-mrp" class="mwb-outline-action" type="button" disabled>Hitung MRP</button></div></div>
    <footer class="mwb-pagination"><span id="mwb-range">0 data</span><div><label>Baris <select id="mwb-page-size" data-searchable-disabled><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></label><button id="mwb-prev" type="button">Sebelumnya</button><span id="mwb-page-label">Halaman 1 / 1</span><button id="mwb-next" type="button">Berikutnya</button></div></footer>
  </section>
  <nav class="mwb-hidden-links" aria-hidden="true"><a id="mwb-review-link" href="/modules/planning-ppic/demand-planning/monthly-review?month=<%= initialMonth %>"></a><a id="mwb-exception-link" href="/modules/planning-ppic/demand-planning/exception-workbench?month=<%= initialMonth %>"></a></nav>
  <div class="app-container"><%- include('../partials/document-comments', { documentComments: { recordKey: `MPS-WORKBENCH-${initialMonth}`, title: 'Komentar MPS Workbench', variant: 'receipt' } }) %></div>
</main>

<aside id="mwb-drawer" class="mwb-drawer" aria-hidden="true"><div class="mwb-drawer-backdrop" data-close-drawer></div><section class="mwb-drawer-panel" role="dialog" aria-modal="true" aria-labelledby="mwb-drawer-title"><header><div><span>FG NETTING &amp; PHASE PURCHASE SIMULATION</span><h2 id="mwb-drawer-title">Rincian FG</h2><p id="mwb-drawer-meta"></p></div><div class="mwb-drawer-tools" aria-label="Kontrol tampilan netting"><button id="mwb-zoom-out" type="button" aria-label="Perkecil tampilan" title="Perkecil">−</button><button id="mwb-zoom-label" type="button" aria-label="Reset zoom" title="Reset zoom">100%</button><button id="mwb-zoom-in" type="button" aria-label="Perbesar tampilan" title="Perbesar">+</button><button id="mwb-fullscreen" type="button" aria-pressed="false">Fullscreen</button><button class="mwb-drawer-close" type="button" data-close-drawer aria-label="Tutup">×</button></div></header><div id="mwb-drawer-body" class="mwb-drawer-body"></div></section></aside>

<aside id="mwb-gate-drawer" class="mwb-drawer" aria-hidden="true"><div class="mwb-drawer-backdrop" data-close-gate-drawer></div><section class="mwb-drawer-panel mwb-gate-drawer-panel" role="dialog" aria-modal="true" aria-labelledby="mwb-gate-drawer-title"><header><div><span>DELIVERY FEASIBILITY AUDIT</span><h2 id="mwb-gate-drawer-title">Delivery Phase MPS</h2><p id="mwb-gate-drawer-meta"></p></div><button class="mwb-drawer-close" type="button" data-close-gate-drawer aria-label="Tutup">×</button></header><div id="mwb-gate-drawer-body" class="mwb-drawer-body"></div></section></aside>

<aside id="mwb-recovery-drawer" class="mwb-drawer" aria-hidden="true"><div class="mwb-drawer-backdrop" data-close-recovery-drawer></div><section class="mwb-drawer-panel mwb-recovery-drawer-panel" role="dialog" aria-modal="true" aria-labelledby="mwb-recovery-title"><header><div><span>PENANGANAN DELIVERY</span><h2 id="mwb-recovery-title">Keputusan Delivery Phase</h2><p id="mwb-recovery-meta"></p></div><button class="mwb-drawer-close" type="button" data-close-recovery-drawer aria-label="Tutup">×</button></header><div id="mwb-recovery-message" class="mwb-recovery-message" hidden></div><div id="mwb-recovery-body" class="mwb-drawer-body"><div class="mwb-recovery-loading">Memuat kondisi delivery…</div></div></section></aside>

<aside id="mwb-modal" class="mwb-modal" aria-hidden="true"><div class="mwb-modal-backdrop" data-close-modal></div><form id="mwb-modal-form" class="mwb-modal-panel"><header><div><span id="mwb-modal-eyebrow">APPLY PO+ TO PRODUCTION</span><h2 id="mwb-modal-title">Recalculate MPS</h2><p id="mwb-modal-copy">Perubahan PO setelah Lock MPS akan diterapkan ke demand dan production plan.</p></div><button type="button" data-close-modal aria-label="Tutup">×</button></header><div class="mwb-modal-content"><p id="mwb-modal-message"></p><label><input id="mwb-confirm" type="checkbox" required> Saya memahami MPS, RCCP, MRP, dan purchase suggestion terkait mungkin perlu diperiksa ulang.</label></div><footer><button type="button" class="btn btn-outline-secondary" data-close-modal>Batal</button><button id="mwb-modal-submit" class="btn btn-primary" type="submit">Terapkan PO+ &amp; Recalculate</button></footer></form></aside>

<aside id="mwb-action-modal" class="mwb-modal" aria-hidden="true"><div class="mwb-modal-backdrop" data-close-action-modal></div><form id="mwb-action-form" class="mwb-modal-panel"><header><div><span id="mwb-action-eyebrow">NEXT PLANNING GATE</span><h2 id="mwb-action-title">Lanjutkan proses</h2><p id="mwb-action-description"></p></div><button type="button" data-close-action-modal aria-label="Tutup">×</button></header><div class="mwb-modal-content"><p id="mwb-action-message"></p><label><input id="mwb-action-confirm" type="checkbox" required> <span id="mwb-action-confirm-copy">Saya memahami perubahan status dokumen ini.</span></label></div><footer><button type="button" class="btn btn-outline-secondary" data-close-action-modal>Batal</button><button id="mwb-action-submit" class="btn btn-primary" type="submit">Lanjutkan</button></footer></form></aside>

<aside id="mwb-planning-modal" class="mwb-modal" aria-hidden="true"><div class="mwb-modal-backdrop" data-close-planning-modal></div><section class="mwb-modal-panel mwb-planning-panel" role="dialog" aria-modal="true" aria-labelledby="mwb-planning-title"><header><div><span>LOCK MPS · PO+ BASELINE</span><h2 id="mwb-planning-title">Konfirmasi baseline PO</h2><p id="mwb-planning-meta"></p></div><button type="button" data-close-planning-modal aria-label="Tutup">×</button></header><div id="mwb-planning-body" class="mwb-modal-content"></div><footer><button type="button" class="btn btn-outline-secondary" data-close-planning-modal>Batal</button><button id="mwb-planning-confirm" class="btn btn-primary" type="button" hidden>Lock MPS (PO Baseline)</button></footer></section></aside>

<div id="mwb-row-menu" class="mwb-row-menu" role="menu" hidden><button type="button" role="menuitem" data-row-action="buffer"><span>◫</span><b>Edit Buffer Stock</b></button><button type="button" role="menuitem" data-row-action="confirm"><span>✓</span><b>Approve MPS</b></button></div>

<aside id="mwb-formula-modal" class="mwb-modal" aria-hidden="true"><div class="mwb-modal-backdrop" data-close-formula-modal></div><section class="mwb-modal-panel mwb-formula-panel" role="dialog" aria-modal="true" aria-labelledby="mwb-formula-title"><header><div><span>CALCULATION AUDIT</span><h2 id="mwb-formula-title">Formula MPS Qty</h2><p id="mwb-formula-meta"></p></div><button type="button" data-close-formula-modal aria-label="Tutup">×</button></header><div id="mwb-formula-body" class="mwb-modal-content"></div><footer><button type="button" class="btn btn-primary" data-close-formula-modal>Tutup</button></footer></section></aside>

<aside id="mwb-feasibility-modal" class="mwb-modal" aria-hidden="true"><div class="mwb-modal-backdrop" data-close-feasibility-modal></div><section class="mwb-modal-panel mwb-feasibility-panel" role="dialog" aria-modal="true" aria-labelledby="mwb-feasibility-title" aria-describedby="mwb-feasibility-meta"><header><div><span>SCHEDULE FEASIBILITY AUDIT</span><h2 id="mwb-feasibility-title">Checklist Kelayakan Schedule &amp; Delivery</h2><p id="mwb-feasibility-meta">Memuat evaluasi…</p></div><button type="button" data-close-feasibility-modal aria-label="Tutup checklist">×</button></header><div class="mwb-feasibility-tools"><div role="group" aria-label="Filter checklist"><button type="button" class="active" data-feasibility-filter="all">Semua</button><button type="button" data-feasibility-filter="issues">Bermasalah</button></div></div><div id="mwb-feasibility-body" class="mwb-modal-content" aria-live="polite"><div class="mwb-feasibility-loading">Memuat rincian feasibility…</div></div><footer><small id="mwb-feasibility-footer-meta"></small><div><button type="button" class="btn btn-primary" data-close-feasibility-modal>Tutup</button></div></footer></section></aside>

<aside id="mwb-buffer-modal" class="mwb-modal" aria-hidden="true"><div class="mwb-modal-backdrop" data-close-buffer-modal></div><form id="mwb-buffer-form" class="mwb-modal-panel mwb-buffer-panel"><header><div><span>BUFFER STOCK SETTING</span><h2>Edit Buffer Stock</h2><p id="mwb-buffer-part"></p></div><button type="button" data-close-buffer-modal aria-label="Tutup">×</button></header><div class="mwb-modal-content"><label class="mwb-field"><span>Buffer Stock (%)</span><input id="mwb-buffer-percent" type="number" min="0" max="100" step="0.01" required></label><fieldset class="mwb-buffer-modes"><legend>Distribusi buffer ke schedule</legend><label><input type="radio" name="bufferAllocationMode" value="DISTRIBUTE_TO_PHASES"><span><b>Bagikan ke setiap phase</b><small>Buffer dibagi proporsional mengikuti MPS Qty customer pada setiap phase.</small></span></label><label><input type="radio" name="bufferAllocationMode" value="SEPARATE_END_MONTH"><span><b>Batch terpisah akhir bulan</b><small>Buffer menjadi batch produksi sendiri dengan target selesai pada hari terakhir bulan.</small></span></label></fieldset><p id="mwb-buffer-message" class="mwb-buffer-message"></p></div><footer><button type="button" class="btn btn-outline-secondary" data-close-buffer-modal>Batal</button><button id="mwb-buffer-submit" class="btn btn-primary" type="submit">Simpan Buffer</button></footer></form></aside>

<aside id="mwb-rccp-modal" class="mwb-modal" aria-hidden="true"><div class="mwb-modal-backdrop" data-close-rccp-modal></div><section class="mwb-modal-panel mwb-rccp-panel" role="dialog" aria-modal="true" aria-labelledby="mwb-rccp-title"><header><div><span>ROUGH-CUT CAPACITY PLANNING</span><h2 id="mwb-rccp-title">Hasil RCCP Otomatis</h2><p id="mwb-rccp-meta"></p></div><button type="button" data-close-rccp-modal aria-label="Tutup">×</button></header><div class="mwb-modal-content">
  <div id="mwb-rccp-results">
    <div id="mwb-rccp-summary" class="mwb-rccp-summary"></div>
    <div id="mwb-rccp-offset-warning" class="mwb-rccp-offset-warning" hidden></div>
    <section class="mwb-rccp-section"><header><div><small>WEEKLY TIME-PHASED LOAD</small><h3>Capacity M-1 + M</h3></div></header><div id="mwb-rccp-weekly" class="mwb-rccp-table-wrap"></div></section>
    <section class="mwb-rccp-section"><header><div><small>RESOURCE SUMMARY</small><h3>Load per critical resource</h3></div></header><div class="mwb-rccp-table-wrap"><table class="mwb-rccp-table" data-enterprise-table="off"><thead><tr><th>Resource</th><th>Current MPS</th><th>Existing</th><th>Total Load</th><th>Capacity</th><th>Load</th><th>Status</th></tr></thead><tbody id="mwb-rccp-body"><tr><td colspan="7">Belum ada hasil RCCP.</td></tr></tbody></table></div></section>
    <section id="mwb-rccp-recommendations" class="mwb-rccp-section" hidden></section>
    <details class="mwb-rccp-timeline"><summary>View Timeline Detail</summary><div id="mwb-rccp-timeline"></div></details>
    <label id="mwb-rccp-reason-field" class="mwb-rccp-reason" hidden><span>Alasan / acknowledgement</span><textarea id="mwb-rccp-reason" rows="3" placeholder="Wajib diisi untuk menerima warning atau override overload"></textarea></label><div id="mwb-rccp-exceptions" class="mwb-rccp-exceptions" hidden></div>
  </div>
</div><footer id="mwb-rccp-actions"><button type="button" class="btn btn-outline-secondary" data-close-rccp-modal>Kembali ke MPS</button></footer></section></aside>

