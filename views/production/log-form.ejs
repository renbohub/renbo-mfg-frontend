<%- include('../partials/head') %>
<%- include('../partials/header-modules') %>
<%- include('../partials/module-subnav', { activePage: page.slug }) %>
<main class="ops-page app-container production-log-page transaction-form-page">
  <nav class="module-breadcrumb"><a href="/modules/production">Production</a><span>/</span><a href="/modules/production/production-logs">Production Entries</a><span>/</span><b><%= mode === 'edit' ? 'Edit' : 'Buat' %></b></nav>
  <section class="ops-detail-titlebar transaction-command-header">
    <div>
      <p class="ops-eyebrow">Production Entry</p>
      <h1><%= mode === 'edit' ? 'Edit Production Entry' : 'Buat Production Entry' %></h1>
      <p>Pilih mesin terlebih dahulu, lalu pilih Daily Production Schedule yang sudah siap diproduksi.</p>
    </div>
    <div class="ops-title-actions"><button id="production-log-submit" class="btn btn-primary brand-button" type="submit" form="production-log-form">Simpan Production Entry</button><a class="btn btn-outline-secondary" href="/modules/production/production-logs">Kembali ke daftar</a></div>
  </section>

  <div id="production-log-alert" class="alert d-none" role="alert"></div>
  <div id="hmi-master-status" class="alert alert-warning d-none" role="status"></div>
  <form id="production-log-form" class="ops-detail-card production-log-form" data-mode="<%= mode %>" data-record-key="<%= recordKey || '' %>">
    <section class="production-log-section">
      <header class="production-log-section-header module-form-section-title">
        <span class="production-log-step">1</span>
        <div><h2>Pilih pekerjaan</h2><p>Hanya Daily Production Schedule berstatus In Progress yang ditampilkan.</p></div>
        <span class="form-required-note">* Wajib diisi</span>
      </header>
      <div class="ops-detail-fields">
        <label>
          <span>Mesin *</span>
          <select id="machineCode" required>
            <option value="">Memuat mesin...</option>
          </select>
          <small class="form-help">Mesin mengikuti Daily Plan aktif; status kesiapan terlihat pada setiap opsi.</small>
        </label>
        <label>
          <span>Daily Production Schedule *</span>
          <select id="scheduleNumber" required>
            <option value="">Pilih mesin terlebih dahulu</option>
          </select>
          <small class="form-help">Hanya DPS berstatus In Progress yang dapat dibuat Production Entry.</small>
        </label>
      </div>
      <aside id="production-log-schedule-gate" class="production-log-schedule-gate d-none" aria-live="polite"></aside>
      <div id="production-log-plan-summary" class="production-log-plan-summary is-empty">
        <span>Pilih mesin, lalu pilih Daily Production Schedule yang siap diproduksi.</span>
      </div>
      <div class="ops-detail-fields production-reference-fields">
        <label><span>Tanggal *</span><input id="logDate" type="date" required></label>
        <label><span id="production-log-shift-label">Shift *</span><select id="shift" required aria-describedby="production-log-shift-help"><option value="">Pilih shift aktual</option><option value="1">Shift 1</option><option value="2">Shift 2</option><option value="3">Shift 3</option><option value="1A">1A</option><option value="1B">1B</option><option value="2A">2A</option><option value="2B">2B</option><option value="3A">3A</option><option value="3C">3C</option></select><small id="production-log-shift-help" class="form-help" hidden>Jadwal PPIC mencakup satu hari produksi. Pilih shift aktual untuk hasil pada entry ini.</small></label>
        <label><span>MO Reference *</span><input id="moNumber" readonly required></label>
        <label><span>WO Reference</span><input id="woNumber" readonly></label>
        <label><span>Part Code</span><input id="partCode" readonly placeholder="Otomatis dari Daily Plan"></label>
        <label><span>Part Number</span><input id="partNumber" readonly placeholder="Otomatis dari master part"></label>
        <label><span>Part Name</span><input id="partName" readonly placeholder="Otomatis dari master part"></label>
        <label><span>Proses</span><input id="processCode" readonly></label>
        <label><span>Operator *</span><input id="operatorName" autocomplete="name" required placeholder="Nama operator"></label>
        <label><span>Target pada log ini</span><input id="qtyPlanned" type="number" min="0" step="any" readonly></label>
      </div>
    </section>

    <section class="production-log-section">
      <header class="production-log-section-header module-form-section-title">
        <span class="production-log-step">2</span>
        <div><h2>Waktu dan hasil produksi</h2><p>Isi waktu aktual serta jumlah hasil produksi pada log ini.</p></div>
      </header>
      <div class="ops-detail-fields production-result-fields">
        <label><span>Mulai Proses *</span><input id="startTime" type="time" required></label>
        <label><span>Selesai Proses *</span><input id="endTime" type="time" required></label>
        <label class="production-output-field"><span>Qty Produced <small>dari phase coil</small></span><input id="qtyProduced" type="number" min="0" step="any" required readonly value="0"></label>
        <label class="production-reject-field"><span>Qty NG <small>dari phase coil</small></span><input id="qtyReject" type="number" min="0" step="any" readonly value="0"></label>
        <label class="production-good-field"><span>Qty Good <small>otomatis</small></span><input id="qtyGood" type="number" min="0" step="any" value="0" readonly></label>
        <label><span>NG Reason</span><input id="rejectReason" readonly placeholder="Otomatis dari rincian reason per phase"></label>
      </div>
    </section>

    <section class="production-log-section production-coil-section">
      <header class="production-log-section-header production-log-section-head module-form-section-title">
        <span class="production-log-step">3</span>
        <div><h2>Coil / material lot dan phase hasil</h2><p>Satu coil dapat memiliki beberapa phase. Lot produksi otomatis sama selama masih dalam log dan shift yang sama.</p></div>
        <button id="add-coil-phase" class="btn btn-outline-primary btn-sm" type="button">+ Tambah Coil / Phase</button>
      </header>
      <div id="coil-phase-rows" class="production-coil-phase-list"></div>
      <template id="coil-phase-template">
        <article class="production-coil-phase-row">
          <div class="production-downtime-row-head"><strong>Phase <span data-coil-phase-number></span></strong><span class="production-lot-hint">Output lot: otomatis per log/shift</span><button class="btn btn-sm btn-outline-danger" type="button" data-remove-coil-phase>Hapus</button></div>
          <div class="production-coil-phase-grid">
            <label><span>No. Coil</span><input data-coil-number placeholder="Contoh: COIL-01"></label>
            <label><span>Lot Coil / Material *</span><input data-input-lot required placeholder="Lot internal dari Material Issue"></label>
            <label><span>Qty Input</span><input data-coil-input type="number" min="0" step="any" placeholder="0"></label>
            <label><span>Qty OK *</span><input data-coil-good type="number" min="0" step="any" value="0"></label>
            <label><span>Qty NG *</span><input data-coil-reject type="number" min="0" step="any" value="0"></label>
            <label><span>Mulai Phase</span><input data-coil-start type="time"></label>
            <label><span>Selesai Phase</span><input data-coil-end type="time"></label>
            <label class="production-coil-notes"><span>Catatan</span><input data-coil-notes placeholder="Kondisi coil / NG phase"></label>
          </div>
          <section class="production-ng-reasons">
            <header><div><strong>Reason NG Phase</strong><small>Satu phase dapat mempunyai beberapa reason; total qty reason harus sama dengan Qty NG.</small><a href="/master-data/ng-reasons" target="_blank" rel="noopener">Kelola Master NG</a></div><button type="button" class="btn btn-sm btn-outline-primary" data-add-ng-reason>+ Reason NG</button></header>
            <div data-ng-reason-rows></div>
          </section>
        </article>
      </template>
      <template id="ng-reason-row-template">
        <div class="production-ng-reason-row">
          <label><span>Reason HMI *</span><select data-ng-reason-main required><option value="">Pilih reason HMI</option><option value="MANUAL">Input manual</option></select></label>
          <label><span>Sub Reason HMI</span><select data-ng-reason-sub><option value="">Pilih sub reason</option></select></label>
          <label data-ng-manual-wrap><span>Reason Manual</span><input data-ng-reason-manual placeholder="Isi jika master HMI belum tersedia"></label>
          <label><span>Qty NG *</span><input data-ng-reason-qty type="number" min="0.01" step="any" required></label>
          <button type="button" class="btn btn-sm btn-outline-danger" data-remove-ng-reason>Hapus</button>
        </div>
      </template>
    </section>

    <section class="production-log-section production-downtime-section">
      <header class="production-log-section-header production-log-section-head module-form-section-title">
        <span class="production-log-step">4</span>
        <div><h2>Downtime</h2><p>Tambahkan hanya jika ada waktu berhenti selama proses produksi. <a href="/master-data/downtime-reasons" target="_blank" rel="noopener">Kelola Master Downtime</a></p></div>
        <div class="production-downtime-actions">
          <span>Total downtime <strong id="downtime-total">0</strong> menit</span>
          <button id="add-downtime" class="btn btn-outline-primary btn-sm" type="button">+ Tambah Downtime</button>
        </div>
      </header>
      <div id="downtime-rows" class="production-downtime-list"></div>
      <template id="downtime-row-template">
        <article class="production-downtime-row">
          <div class="production-downtime-row-head"><strong>Downtime <span data-downtime-number></span></strong><button class="btn btn-sm btn-outline-danger" type="button" data-remove-downtime>Hapus</button></div>
          <div class="production-downtime-grid">
            <label><span>Reason HMI *</span><select data-downtime-category required><option value="">Pilih reason HMI</option><option value="MANUAL">Input manual</option></select></label>
            <label><span>Sub Reason HMI</span><select data-downtime-sub><option value="">Pilih sub reason</option></select></label>
            <label><span>Mulai</span><input type="time" data-downtime-start></label>
            <label><span>Selesai</span><input type="time" data-downtime-end></label>
            <label><span>Durasi (menit) *</span><input type="number" min="0.1" step="0.1" data-downtime-duration required placeholder="0"></label>
            <label class="production-downtime-reason"><span>Alasan Manual</span><input data-downtime-reason placeholder="Isi jika master HMI belum tersedia"></label>
            <label class="production-downtime-notes"><span>Catatan</span><input data-downtime-notes placeholder="Opsional"></label>
          </div>
        </article>
      </template>
    </section>

    <section class="production-log-section">
      <header class="production-log-section-header module-form-section-title">
        <span class="production-log-step">5</span>
        <div><h2>Release kualitas hasil OK</h2><p>Pilih QC terpisah atau self-check operator. Qty NG tetap wajib melalui judgment QC.</p></div>
      </header>
      <div class="production-quality-choice">
        <label class="production-quality-option">
          <input id="operatorSelfCheck" type="checkbox">
          <span><strong>QC dilakukan operator — lewati antrean QC hasil OK</strong><small>Setelah Production Entry disetujui, sistem membuat bukti QC Accepted dan langsung melepas stok OK. Pilihan serta operator tetap tercatat.</small></span>
        </label>
        <label id="selfCheckNotesWrap" class="production-self-check-notes d-none"><span>Catatan pemeriksaan operator *</span><textarea id="selfCheckNotes" rows="3" placeholder="Contoh: visual, dimensi utama, dan go/no-go gauge sudah OK"></textarea></label>
        <div class="production-quality-route"><b>QC terpisah:</b> Production Entry Approved → QC Hold → QC Release Stock → WIP tersedia / FG Receipt. <b>Self-check:</b> Production Entry Approved → stok OK langsung tersedia.</div>
      </div>
    </section>

    <section class="production-log-section">
      <header class="production-log-section-header module-form-section-title">
        <span class="production-log-step">6</span>
        <div><h2>Catatan dan bukti</h2><p>Tambahkan bukti atau informasi untuk supervisor dan shift berikutnya jika diperlukan.</p></div>
      </header>
      <div class="ops-detail-fields production-notes-fields">
        <label><span>Attachment URL</span><input id="attachmentUrl" type="url" placeholder="https://..."></label>
        <label><span>Keterangan</span><textarea id="notes" rows="3" placeholder="Informasi tambahan untuk supervisor atau shift berikutnya"></textarea></label>
      </div>
    </section>

    <div class="module-form-actions transaction-progress-slot" aria-label="Kelengkapan form"></div>
  </form>
  <%- include('../partials/document-comments', { documentComments: { recordKey: mode === 'edit' ? recordKey : null, showPending: mode !== 'edit', title: 'Komentar Production Entry', variant: 'receipt' } }) %>
</main>
<%- include('../partials/footer') %>
