<%- include('../partials/head') %>
<%- include('../partials/header-modules') %>
<%- include('../partials/module-subnav', { activePage: page.slug }) %>
<main class="ops-page app-container transaction-form-page">
  <nav class="module-breadcrumb"><a href="/modules/<%= module.slug %>"><%= module.label %></a><span>/</span><a href="/modules/<%= module.slug %>/<%= page.slug %>"><%= page.label %></a><span>/</span><b><%= mode === 'edit' ? 'Edit' : 'Buat' %></b></nav>
  <section class="ops-detail-titlebar transaction-command-header">
    <div><p class="ops-eyebrow"><%= module.slug === 'qc' ? 'Quality Control' : 'Production Execution' %></p><h1><%= mode === 'edit' ? 'Edit' : 'Buat' %> <%= page.label %></h1><p>Form operasional terhubung langsung ke validasi, relasi, dan audit trail backend.</p></div>
    <div class="ops-title-actions"><button id="production-shared-submit" class="btn btn-primary brand-button" type="submit" form="production-shared-form">Simpan</button><a class="btn btn-outline-secondary" href="/modules/<%= module.slug %>/<%= page.slug %>">Kembali ke daftar</a></div>
  </section>
  <div id="production-shared-alert" class="alert d-none" role="alert"></div>
  <form id="production-shared-form" class="ops-detail-card">
    <div class="module-form-section-title">Informasi <%= page.label %><span class="form-required-note">* Field wajib</span></div>
    <div id="production-shared-fields" class="ops-detail-fields"></div>
    <div class="module-form-actions transaction-progress-slot" aria-label="Kelengkapan form"></div>
  </form>
  <%- include('../partials/document-comments', { documentComments: { recordKey: mode === 'edit' ? recordKey : null, showPending: mode !== 'edit', title: `Komentar ${page.label}`, variant: 'receipt' } }) %>
</main>
<script id="production-shared-config" type="application/json"><%- JSON.stringify({ module: module.slug, page, mode, recordKey }).replace(/</g, '\\u003c') %></script>
<%- include('../partials/footer') %>
