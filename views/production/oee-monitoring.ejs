<%- include('../partials/head') %>
<link rel="stylesheet" href="/css/oee-monitoring.css?v=20260908-2">
<%- include('../partials/header-modules') %>
<%- include('../partials/module-subnav', { activePage: 'oee-monitoring' }) %>

<main class="oee-page<%= machineId ? ' is-detail' : ' is-wallboard' %>">
  <div class="oee-shell">
    <header class="oee-wallbar" aria-label="Filter monitoring OEE">
      <h1>Monitoring <strong>OEE</strong><span class="oee-title-period">.</span></h1>
      <label class="oee-filter oee-filter--date"><span>Tanggal produksi</span><div><%- include('../partials/icon', { name: 'calendar' }) %><input type="date" id="oee-date" value="<%= initialDate %>" aria-label="Tanggal produksi"></div></label>
      <label class="oee-filter oee-filter--shift"><span>Shift</span><select id="oee-shift" aria-label="Shift produksi"><option value="">Semua shift</option></select></label>
      <label class="oee-filter oee-filter--search"><span>Pencarian mesin</span><div><%- include('../partials/icon', { name: 'search' }) %><input type="search" id="oee-search" placeholder="Cari mesin, part, atau MO…" autocomplete="off"></div></label>
      <button class="oee-demo-button" id="oee-demo" type="button" aria-pressed="false">Lihat contoh</button>
      <button class="oee-wall-action" id="oee-refresh" type="button" title="Perbarui data"><%- include('../partials/icon', { name: 'refresh' }) %><span>Perbarui</span></button>
      <button class="oee-wall-action" id="oee-fullscreen" type="button" aria-label="Layar penuh" title="Layar penuh" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5"/></svg></button>
    </header>

    <div class="oee-data-context"><span class="oee-source" id="oee-source-label">Production log</span><span class="oee-updated" id="oee-updated">Menunggu pembaruan</span></div>
    <div class="oee-alert" id="oee-alert" role="alert" hidden></div>
    <section id="oee-overview" class="oee-overview" aria-labelledby="oee-overview-caption">
      <header class="oee-overview-head">
        <div class="oee-overview-title"><h2 id="oee-overview-caption">Semua mesin <span class="oee-count" id="oee-machine-count">— mesin</span></h2></div>
        <nav class="oee-segments" aria-label="Filter catatan produksi mesin"><button type="button" data-oee-filter="all" class="active" aria-pressed="true">Semua mesin <span data-oee-count="all">—</span></button><button type="button" data-oee-filter="recorded" aria-pressed="false"><i class="oee-dot"></i>Ada catatan <span data-oee-count="recorded">—</span></button><button type="button" data-oee-filter="no-data" aria-pressed="false">Belum ada log <span data-oee-count="no-data">—</span></button></nav>
      </header>
      <div class="oee-machines" id="oee-machines" aria-live="polite"><div class="oee-empty oee-loading"><span class="oee-loading-orbit" aria-hidden="true"></span><h3>Memuat kondisi produksi</h3><p>Menyiapkan ringkasan mesin dan history downtime.</p></div></div>
      <p class="oee-overview-note">Batang: durasi downtime per penyebab · Garis: persentase kumulatif. Pilih mesin untuk membuka detail.</p>
    </section>
    <section id="oee-detail" class="oee-detail" aria-label="Detail kinerja mesin" aria-live="polite" hidden></section>
    <footer class="oee-page-footer"><span>PT. MITSUTOYO INDONESIA</span><span>Production intelligence <i aria-hidden="true">/</i> OEE Monitoring</span></footer>
  </div>
</main>
<script id="oee-config" type="application/json"><%- JSON.stringify({ initialDate, machineId: typeof machineId !== 'undefined' ? machineId : '' }).replace(/</g, '\\u003c') %></script>
<script src="/js/oee-monitoring-model.js?v=20260908-2"></script>
<%- include('../partials/footer') %>
