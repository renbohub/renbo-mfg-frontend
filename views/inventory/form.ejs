<%- include('../partials/head') %>
<%- include('../partials/header-modules') %>
<%- include('../partials/module-subnav', { activePage: page.slug }) %>
<main class="ops-page app-container transaction-form-page">
  <nav class="module-breadcrumb"><a href="/modules/inventory">Inventory</a><span>/</span><a href="/modules/inventory/<%= page.slug %>"><%= page.label %></a><span>/</span><b>Buat</b></nav>
  <section class="ops-detail-titlebar transaction-command-header"><div><p class="ops-eyebrow">Inventory</p><h1>Buat <%= page.label %></h1><p><%= page.slug === 'stock-opname' ? 'Tentukan scope opname. Setelah Mulai Counting, member mengisi rack, lot, part, dan qty melalui form blind count.' : page.slug === 'stock-reservations' ? 'Pilih free stock material lalu alokasikan qty ke satu atau beberapa part number. Tidak perlu menunggu MRP.' : 'Transaksi dicatat dengan audit trail dan validasi saldo/warehouse.' %></p></div><div class="ops-title-actions"><button id="inventory-submit" class="btn btn-primary brand-button" type="submit" form="inventory-form"><%= page.slug === 'stock-movements' ? 'Simpan Semua Movement' : page.slug === 'stock-reservations' ? 'Reserve Stock' : 'Simpan' %></button><a class="btn btn-outline-secondary" href="/modules/inventory/<%= page.slug %>">Kembali ke daftar</a></div></section>
  <div id="inventory-form-alert" class="alert d-none" role="alert"></div>
  <form id="inventory-form" class="ops-detail-card inventory-form-card">
    <div class="module-form-section-title">Informasi <%= page.label %><span class="form-required-note">* Field wajib</span></div>
    <div class="ops-detail-fields">
      <% if (page.slug === 'stock-reservations') { %>
        <label><span>Tanggal Reservation *</span><input id="reservationDate" type="date" required></label>
        <label><span>Expiry Date</span><input id="expiryDate" type="date"></label>
        <label class="span-2"><span>Material & Lokasi Stock *</span><select id="stockBalanceId" required disabled><option value="">Memuat material yang memiliki free stock...</option></select><small>Hanya Material Master dengan free stock lebih dari 0 yang ditampilkan.</small></label>
        <section id="reservation-stock-summary" class="span-2 reservation-mrp-summary d-none" aria-live="polite"></section>
        <label class="span-2"><span>Part Code RAW MATERIAL Terkait *</span><select id="targetPartCode" disabled><option value="">Pilih material terlebih dahulu</option></select><small>Jika hanya ada satu part terkait, part dipilih otomatis. Jika lebih dari satu, pilih tujuan secara manual.</small></label>
        <label><span>Qty untuk Part *</span><input id="allocationQty" type="number" min="0.000001" step="any" disabled></label>
        <div class="span-2 inventory-batch-add"><div><strong>Alokasi material ke part RAW</strong><small>Setiap pilihan dijamin memakai Material Master yang sama dengan stock terpilih.</small></div><button id="reservation-add-line" class="btn btn-outline-primary" type="button" disabled>＋ Tambah Alokasi</button></div>
        <section class="span-2 inventory-batch-panel reservation-requirement-panel">
          <header><div><strong>Daftar Alokasi Part Number</strong><small id="reservation-allocation-help">Total reserve tidak boleh melebihi free stock.</small></div><span id="reservation-allocation-count" class="badge text-bg-light">0 part</span></header>
          <div class="table-responsive"><table class="table align-middle mb-0" data-enterprise-table="off"><thead><tr><th>#</th><th>Part Code</th><th>Part Number</th><th>Part Name</th><th>Qty Reserve</th><th>UOM</th><th></th></tr></thead><tbody id="reservation-allocation-body"><tr><td colspan="7" class="inventory-batch-empty">Belum ada alokasi part number.</td></tr></tbody></table></div>
        </section>
        <label class="span-2"><span>Catatan</span><textarea id="notes" rows="3" placeholder="Tujuan reservasi / catatan PPIC atau Inventory"></textarea></label>
      <% } else if (page.slug === 'stock-movements') { %>
        <label><span>Movement Type *</span><select id="movementType" required><option value="IN">IN</option><option value="OUT">OUT</option><option value="TRANSFER">TRANSFER</option></select><small>Koreksi selisih stok dilakukan melalui <a href="/modules/inventory/stock-opname/new">Stock Opname dan approval supervisor</a>.</small></label>
        <label><span>Input Quantity *</span><select id="inputMode"><option value="DIRECT">Direct sesuai UOM stok</option><option value="MATERIAL_FROM_PART_PCS">Raw Material dari Part PCS</option></select></label>
        <label><span>Warehouse *</span><select id="warehouseCode" required><option value="">Pilih warehouse</option></select></label>
        <label><span>Rack</span><select id="rackCode"><option value="">Tanpa rack</option></select></label>
        <label data-transfer-field><span>Destination Warehouse *</span><select id="destinationWarehouseCode"><option value="">Pilih warehouse tujuan</option></select></label>
        <label data-transfer-field><span>Destination Rack</span><select id="destinationRackCode"><option value="">Tanpa rack</option></select></label>
        <label id="inventory-stock-type-field"><span>Stock Type *</span><select id="stockType" required><option value="">Pilih stock type</option><option value="Material">Material</option><option value="Purchase Part">Purchase Part</option><option value="WIP">WIP</option><option value="Finished Goods">Finished Goods</option></select></label>
        <label id="inventory-item-field"><span id="inventory-item-label">Item *</span><select id="itemCode" required><option value="">Pilih stock type terlebih dahulu</option></select></label>
        <label class="d-none" data-material-piece-field><span>Part Sumber PCS *</span><select id="materialPieceSource"><option value="">Pilih part raw material</option></select></label>
        <label class="d-none" data-material-piece-field><span>Qty Sumber (PCS) *</span><input id="sourceQtyPcs" type="number" min="1" step="1"></label>
        <label><span id="inventory-reference-label">Part Number / Material Type</span><input id="itemReference" readonly></label>
        <label><span id="inventory-name-label">Nama Item</span><input id="itemName" readonly></label>
        <input id="partCode" type="hidden"><input id="partNumber" type="hidden"><input id="partName" type="hidden">
        <input id="materialId" type="hidden"><input id="materialCode" type="hidden"><input id="materialName" type="hidden"><input id="materialType" type="hidden">
        <label><span>Lot Number</span><select id="lotNumber"><option value="">Tanpa lot</option></select></label>
        <label><span id="inventory-uom-label">UOM *</span><select id="uomCode" required><option value="">Pilih UOM</option></select></label>
        <label><span id="inventory-qty-label">Qty *</span><input id="qty" type="number" min="0.000001" step="any" required></label>
        <div id="material-piece-preview" class="inventory-material-conversion-preview alert alert-info mb-0 d-none" data-material-piece-field>Pilih part sumber untuk menghitung PCS x gross weight BOM menjadi stok material KG.</div>
        <label data-adjustment-field><span>Adjustment Type *</span><select id="adjustmentType"><option value="">Pilih adjustment</option><option value="INCREASE">INCREASE</option><option value="DECREASE">DECREASE</option></select></label>
        <label><span>Reference Number</span><input id="referenceNumber" placeholder="GR / MO / WO / dokumen lain"></label>
        <label class="span-2"><span>Catatan</span><textarea id="notes" rows="3"></textarea></label>
        <div class="span-2 inventory-batch-add"><div><strong>Item transaksi</strong><small>Isi item di atas lalu tambahkan ke daftar. Maksimal 100 baris per submit.</small></div><button id="inventory-add-line" class="btn btn-outline-primary" type="button">＋ Tambahkan ke Daftar</button></div>
        <section class="span-2 inventory-batch-panel">
          <header><div><strong>Daftar Stock Movement</strong><small id="inventory-batch-count">0 item siap disimpan</small></div><button id="inventory-clear-lines" class="btn btn-sm btn-outline-secondary" type="button" disabled>Kosongkan</button></header>
          <div class="table-responsive"><table class="table align-middle mb-0" data-enterprise-table="off"><thead><tr><th>#</th><th>Type</th><th>Lokasi</th><th>Stock Type</th><th>Item / Part Number</th><th>Lot</th><th>Qty</th><th>Referensi</th><th></th></tr></thead><tbody id="inventory-batch-body"><tr data-empty><td colspan="9"><div class="inventory-batch-empty">Belum ada item. Isi form lalu klik <b>Tambahkan ke Daftar</b>.</div></td></tr></tbody></table></div>
        </section>
      <% } else { %>
        <label><span>Mode Count *</span><select id="countMode" required><option value="FULL">Full Count</option><option value="CYCLE">Cycle Count</option></select><small>Full mencakup seluruh scope terpilih; Cycle wajib dibatasi rack atau lot.</small></label>
        <label><span>Jenis Inventory *</span><select id="stoType" required><option value="MATERIAL">Material / Purchase Part</option><option value="WIP">WIP / WP / Semi-Finished</option><option value="FG">Finished Goods</option></select></label>
        <label><span>Warehouse *</span><select id="warehouseCode" required><option value="">Pilih warehouse</option></select></label>
        <label><span>Tanggal *</span><input id="stoDate" type="date" required></label>
        <label><span>Jenis Stock</span><select id="stockType" multiple size="4" aria-label="Pilih satu atau beberapa jenis stock"></select><small>Kosongkan untuk seluruh jenis stock yang sesuai.</small></label>
        <label><span>Rack Scope</span><select id="rackCode" multiple size="4" aria-label="Pilih satu atau beberapa rack"></select><small>Kosongkan untuk seluruh rack.</small></label>
        <label class="span-2"><span>Lot Scope</span><input id="lotNumbers" placeholder="Opsional, pisahkan beberapa lot dengan koma"><small>Cycle Count wajib memiliki rack atau lot.</small></label>
        <label><span>Toleransi Qty *</span><input id="toleranceQty" type="number" min="0" step="any" value="0" required></label>
        <label><span>Toleransi Persen *</span><input id="tolerancePercent" type="number" min="0" step="any" value="0" required></label>
        <label class="span-2"><span><input id="includeZeroBalance" type="checkbox" checked> Sertakan balance qty 0</span><small>Berguna untuk menemukan stock fisik pada lokasi yang saldo sistemnya nol.</small></label>
        <div class="span-2 alert alert-info mb-0"><strong>Blind count:</strong> snapshot qty sistem diambil ulang saat <em>Mulai Counting</em>, lalu hanya scope terpilih yang dibekukan. Jenis WP ikut dalam scope WIP.</div>
        <div class="span-2 d-flex align-items-center gap-3"><button id="sto-preview-scope" class="btn btn-outline-primary" type="button">Preview Scope</button><small>Periksa jumlah line, on hand, reserved, QC, serta warning sebelum dokumen dibuat.</small></div>
        <section id="sto-scope-preview" class="span-2 inventory-batch-panel d-none" aria-live="polite"></section>
        <label class="span-2"><span>Catatan</span><textarea id="notes" rows="3"></textarea></label>
      <% } %>
    </div>
    <div class="module-form-actions transaction-progress-slot" aria-label="Kelengkapan form"></div>
  </form>
  <%- include('../partials/document-comments', { documentComments: { recordKey: null, showPending: true, title: `Komentar ${page.label}`, variant: 'receipt' } }) %>
</main>
<script id="inventory-form-config" type="application/json"><%- JSON.stringify({ page: page.slug }).replace(/</g, '\\u003c') %></script>
<%- include('../partials/footer') %>
