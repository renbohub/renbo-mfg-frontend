<%- include('../partials/head') %>
<link rel="stylesheet" href="/css/stock-opname-count.css?v=20260826-multi-member-2">
<link rel="stylesheet" href="/css/stock-opname-scan.css?v=20260908-1">
<%- include('../partials/header-modules') %>
<%- include('../partials/module-subnav', { activePage: page.slug }) %>

<main class="soc-page app-container transaction-form-page">
  <nav class="module-breadcrumb soc-breadcrumb">
    <a href="/modules/inventory">Inventory</a><span>/</span>
    <a href="/modules/inventory/stock-opname">Stock Opname</a><span>/</span>
    <b><%= stoNo %></b>
  </nav>

  <header class="soc-hero planning-shared-header">
    <div>
      <p>INVENTORY · MEMBER COUNT</p>
      <h1>Physical Stock Count</h1>
      <span>Isi jumlah fisik tiap item. Qty sistem tetap disembunyikan selama counting.</span>
    </div>
    <a class="soc-back" href="/modules/inventory/stock-opname/<%= encodeURIComponent(stoNo) %>">← Kembali ke Detail</a>
  </header>

  <div id="sto-count-alert" class="soc-alert d-none" role="alert"></div>
  <section id="sto-count-loading" class="soc-loading"><span></span> Memuat daftar stock…</section>

  <div id="sto-count-page" class="d-none">
    <section class="soc-workbench">
      <div class="soc-toolbar">
        <label class="soc-member-field">
          <span>Sesi Member</span>
          <div class="soc-member-input"><input id="sto-member-name" type="text" maxlength="100" required placeholder="Masukkan nama petugas"><button id="sto-start-session" type="button">Aktifkan</button></div>
        </label>
        <label class="soc-search-field"><span>Cari item</span><input id="sto-item-search" type="search" placeholder="Part number, material, rack, lot…"></label>
        <div class="soc-document-state">
          <small id="sto-count-scope">Memuat scope…</small>
          <b id="sto-count-number"><%= stoNo %></b>
          <em id="sto-round-label">ROUND 1 · COUNTING</em>
        </div>
      </div>

      <section class="soc-scan-panel" aria-label="Scan barcode dan QR stock opname">
        <form id="sto-scan-form"><label for="sto-scan-reference">Scan barcode / QR</label><div><input id="sto-scan-reference" class="form-control" maxlength="512" autocomplete="off" placeholder="Scanner atau ketik part/material code"><button type="submit" class="btn btn-primary">Cari item</button><button id="sto-scan-camera" type="button" class="btn btn-outline-primary">Kamera</button><button id="sto-scan-stop" type="button" class="btn btn-outline-secondary" hidden>Stop</button></div></form>
        <video id="sto-scan-video" autoplay muted playsinline hidden></video>
        <p id="sto-scan-message" role="status" aria-live="polite">Scan memilih item; qty fisik tetap diisi dan disimpan oleh petugas.</p>
        <div id="sto-scan-matches"></div>
        <div class="soc-scan-downloads"><button type="button" class="btn btn-outline-secondary" data-sto-document="labels.pdf">Cetak Label QR</button><button type="button" class="btn btn-outline-secondary" data-sto-document="report.pdf">Laporan PDF Lengkap</button><button type="button" class="btn btn-outline-secondary" data-sto-document="report.xlsx">Laporan Excel Lengkap</button></div>
      </section>

      <div class="soc-progress-strip">
        <div><span>Total Item</span><b id="sto-total-lines">0</b></div>
        <div><span>Sudah Dihitung</span><b id="sto-counted-lines">0</b></div>
        <div><span>Belum Dihitung</span><b id="sto-remaining-lines">0</b></div>
        <div><span>Kontribusi Saya</span><b id="sto-my-lines">0</b></div>
        <div class="soc-progress-meter"><span id="sto-count-progress">0 / 0 dihitung</span><div><i id="sto-progress-bar"></i></div></div>
      </div>

      <form id="sto-count-form" class="soc-matrix-form">
        <div class="soc-team-strip">
          <div id="sto-count-filters" class="soc-filter-tabs" role="group" aria-label="Filter daftar hitung">
            <button type="button" data-count-filter="UNCOUNTED" class="is-active">Belum Dihitung <b id="sto-filter-uncounted">0</b></button>
            <button type="button" data-count-filter="MINE">Hitungan Saya <b id="sto-filter-mine">0</b></button>
            <button type="button" data-count-filter="ALL">Semua Item <b id="sto-filter-all">0</b></button>
          </div>
          <div id="sto-member-roster" class="soc-member-roster" aria-label="Member yang sudah berkontribusi"></div>
          <button id="sto-refresh-progress" class="soc-refresh" type="button">↻ Refresh</button>
        </div>
        <div class="soc-table-scroll">
          <table class="soc-table" data-enterprise-table="off">
            <colgroup>
              <col class="soc-col-no"><col class="soc-col-item"><col class="soc-col-name"><col class="soc-col-type">
              <col class="soc-col-rack"><col class="soc-col-lot"><col class="soc-col-qty"><col class="soc-col-status">
            </colgroup>
            <thead>
              <tr class="soc-group-head"><th colspan="3">ITEM IDENTITY</th><th colspan="3">LOCATION</th><th colspan="2">PHYSICAL COUNT</th></tr>
              <tr><th>#</th><th>Material / Part Number</th><th>Part Name</th><th>Type</th><th>Rack</th><th>Lot</th><th>Qty Fisik</th><th>Status</th></tr>
            </thead>
            <tbody id="sto-count-rows"></tbody>
          </table>
        </div>

        <div class="soc-action-bar">
          <p id="sto-action-note"><b>Aktifkan sesi member</b> untuk mulai mengisi item yang belum dihitung.</p>
          <div>
            <button id="sto-save-counts" class="soc-secondary-action" type="submit" disabled>Simpan Hitungan</button>
            <button id="sto-finish-counting" class="soc-primary-action" type="button" disabled>Selesai Counting</button>
          </div>
        </div>
      </form>
    </section>

    <details id="sto-found-panel" class="soc-found-panel">
      <summary><span><b>＋ Stock tidak ada di daftar</b><small>Gunakan Found Stock hanya bila item fisik benar-benar belum tercatat.</small></span><em>FOUND STOCK</em></summary>
      <form id="sto-found-form" class="soc-found-form">
        <div class="soc-found-grid">
          <label><span>Jenis Stock *</span><select id="sto-found-stock-type" required></select></label>
          <label><span>Identitas *</span><select id="sto-found-identity-kind"><option value="MATERIAL">Material</option><option value="PART">Part</option></select></label>
          <label data-found-material><span>Material Code *</span><input id="sto-found-material-code"></label>
          <label data-found-material><span>Material Name</span><input id="sto-found-material-name"></label>
          <label data-found-material><span>Material Type</span><input id="sto-found-material-type"></label>
          <label data-found-part class="d-none"><span>Part Code / Part No *</span><input id="sto-found-part-code"></label>
          <label data-found-part class="d-none"><span>Part Name *</span><input id="sto-found-part-name"></label>
          <label><span>Rack</span><input id="sto-found-rack"></label>
          <label><span>Lot Number</span><input id="sto-found-lot"></label>
          <label><span>UOM *</span><input id="sto-found-uom" required placeholder="PCS / KG"></label>
          <label><span>Qty Fisik *</span><input id="sto-found-actual" type="number" min="0" step="any" required></label>
          <label class="soc-span-2"><span>Alasan *</span><textarea id="sto-found-reason" rows="2" required placeholder="Mengapa stock ini belum tercatat?"></textarea></label>
        </div>
        <div class="soc-found-actions"><button type="submit">Tambahkan Found Stock</button></div>
      </form>
    </details>

    <section id="sto-completed-state" class="soc-completed d-none">
      <span>✓</span><div><b>Counting sudah dikirim</b><p>Hasil sedang menunggu pemeriksaan checker.</p></div>
      <a href="/modules/inventory/stock-opname/<%= encodeURIComponent(stoNo) %>">Buka Detail & Approval</a>
    </section>
  </div>
  <%- include('../partials/document-comments', { documentComments: { recordKey: stoNo, title: 'Komentar Stock Opname Counting', variant: 'receipt' } }) %>
</main>

<script id="sto-count-config" type="application/json"><%- JSON.stringify({ stoNo }).replace(/</g, '\\u003c') %></script>
<%- include('../partials/footer') %>
