<%- include('../partials/head') %>
<%- include('../partials/header-master') %>
<main class="entity-page">
  <section class="entity-toolbar app-container"><div class="entity-title"><span>Master Data</span><b>/</b><strong>Master Formula</strong></div><div class="toolbar-search"><input id="formula-search" type="search" placeholder="Cari formula..."></div><select id="formula-module" class="form-select"><option value="">Semua module</option><option>planning</option><option>sales</option><option>capacity</option><option>engineering</option><option>inventory</option><option>production</option></select><button id="new-formula" class="btn btn-primary brand-button">Tambah Formula</button></section>
  <div id="formula-alert" class="alert d-none mx-4 mt-3"></div>
  <section class="table-shell entity-table-shell"><table class="table align-middle" id="formula-table"><thead><tr><th>Module</th><th>Key</th><th>Nama</th><th>Expression</th><th>Version</th><th>Status</th><th>Aksi</th></tr></thead><tbody></tbody></table></section>
</main>
<div class="modal fade" id="formula-modal" tabindex="-1"><div class="modal-dialog modal-lg"><form class="modal-content" id="formula-form"><div class="modal-header"><h5 class="modal-title">Master Formula</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" id="formula-id"><div class="row g-3"><div class="col-md-4"><label class="form-label">Module</label><input class="form-control" id="formula-module-input" required></div><div class="col-md-4"><label class="form-label">Formula Key</label><input class="form-control" id="formula-key" required></div><div class="col-md-4"><label class="form-label">Code</label><input class="form-control" id="formula-code" required></div><div class="col-12"><label class="form-label">Nama</label><input class="form-control" id="formula-name" required></div><div class="col-12"><label class="form-label">Expression</label><textarea class="form-control font-monospace" id="formula-expression" rows="3" required></textarea><small class="text-muted">Operator: + - * / %, fungsi: min, max, round, ceil, floor, abs. Tidak memakai eval.</small></div><div class="col-12"><label class="form-label">Variables JSON</label><textarea class="form-control font-monospace" id="formula-variables" rows="2">{}</textarea></div><div class="col-12"><label class="form-label">Deskripsi</label><textarea class="form-control" id="formula-description" rows="2"></textarea></div><div class="col-12"><label class="form-check"><input class="form-check-input" type="checkbox" id="formula-active" checked> Aktif</label></div></div><div id="formula-simulation" class="small mt-3"></div></div><div class="modal-footer"><button type="button" id="simulate-formula" class="btn btn-outline-secondary">Uji Formula</button><button class="btn btn-primary" type="submit">Simpan</button></div></form></div></div>
<%- include('../partials/footer') %>
