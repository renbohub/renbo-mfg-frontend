<%- include('../partials/head') %>
<%- include('../partials/header-master') %>
<main class="entity-form-page">
  <div class="form-page-heading app-container">
    <div><a href="/master-data/<%= config.slug %>"><%= config.label %></a><span>/</span><strong><%= mode === 'create' ? 'Tambah Baru' : 'Edit Data' %></strong></div>
    <h1><%= mode === 'create' ? 'Tambah' : 'Edit' %> <%= config.singular %></h1>
    <p>Lengkapi field sesuai struktur database dan validasi backend.</p>
  </div>
  <form id="entity-form" class="entity-form-card" enctype="multipart/form-data" novalidate>
    <div id="form-alert" class="alert alert-danger d-none" role="alert"></div>
    <% let lastSection = ''; config.fields.forEach((item) => { const section = item.section || 'Informasi Utama'; if (section !== lastSection) { if (lastSection) { %></div></section><% } %><section class="form-section <%= section === 'Transaction Permissions' || section === 'Lot Tracking' ? 'permission-section' : '' %>"><h2><span></span><%= section %></h2><div class="form-grid"><% lastSection = section; } %>
      <div class="form-field <%= ['textarea','json','file'].includes(item.type) ? 'field-wide' : '' %>">
        <% if (item.type === 'checkbox') { %>
          <label class="check-field"><input class="form-check-input" type="checkbox" name="<%= item.name %>" <%= item.defaultChecked || item.name === 'isActive' || item.name === 'isPrimary' ? 'checked' : '' %>><span><%= item.label %></span></label>
        <% } else { %>
          <label class="form-label" for="field-<%= item.name %>"><%= item.label %><% if (item.required || (mode === 'create' && item.requiredOnCreate)) { %><em>*</em><% } %></label>
          <% if (item.type === 'textarea' || item.type === 'json') { %>
            <textarea class="form-control" id="field-<%= item.name %>" name="<%= item.name %>" rows="<%= item.type === 'json' ? 5 : 3 %>" <%= item.required ? 'required' : '' %>></textarea>
          <% } else if (item.type === 'select') { %>
            <select class="form-select" id="field-<%= item.name %>" name="<%= item.name %>" <%= item.multiple ? 'multiple' : '' %> <%= item.required ? 'required' : '' %>><% if (!item.multiple) { %><option value="">Pilih <%= item.label.toLowerCase() %></option><% } %><% (item.options || []).forEach(opt => { %><option value="<%= opt.value %>"><%= opt.label %></option><% }) %></select>
          <% } else if (item.type === 'lookup') { %>
            <select class="form-select lookup-select" id="field-<%= item.name %>" name="<%= item.name %>" data-lookup="<%= item.lookup.entity %>" data-value-key="<%= item.lookup.valueKey %>" data-label-key="<%= item.lookup.labelKey %>" data-show-value="<%= item.showValue ? 'true' : 'false' %>" <%= item.multiple ? 'multiple' : '' %> <%= item.required ? 'required' : '' %>><option value="">Memuat <%= item.label.toLowerCase() %>...</option></select>
          <% } else if (item.type === 'file') { %>
            <input class="form-control" id="field-<%= item.name %>" name="<%= item.name %>" type="file" <%= item.multiple ? 'multiple' : '' %> <%= item.accept ? `accept="${item.accept}"` : '' %> <%= mode === 'create' && item.requiredOnCreate ? 'required' : '' %>>
          <% } else { %>
            <input class="form-control" id="field-<%= item.name %>" name="<%= item.name %>" type="<%= item.type %>" <%= item.step ? `step="${item.step}"` : '' %> <%= typeof item.min !== 'undefined' ? `min="${item.min}"` : '' %> <%= item.required ? 'required' : '' %>>
          <% } %>
          <% if (item.help) { %><small class="form-help"><%= item.help %></small><% } %>
        <% } %>
      </div>
    <% }); if (lastSection) { %></div></section><% } %>
    <div class="form-actions"><a class="btn btn-light" href="/master-data/<%= config.slug %>">Batal</a><button id="save-button" class="btn btn-primary brand-button" type="submit"><span>Simpan</span><i class="spinner-border spinner-border-sm d-none"></i></button></div>
  </form>
</main>
<script id="entity-config" type="application/json"><%- JSON.stringify({ config, mode, recordId, recordKey }).replace(/</g, '\\u003c') %></script>
<%- include('../partials/footer') %>
