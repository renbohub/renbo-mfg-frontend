<%- include('../partials/head') %>
<%- include('../partials/header-master') %>
<main class="entity-page">
  <section class="entity-toolbar app-container">
    <div class="enterprise-page-heading"><span>Master Data</span><h1><%= config.label %></h1><p><%= config.description || 'Kelola referensi data yang digunakan lintas proses ERP.' %></p></div>
    <div class="toolbar-search"><%- include('../partials/icon', { name: 'search' }) %><input id="entity-search" type="search" placeholder="Cari <%= config.singular.toLowerCase() %>..."></div>
    <select id="deleted-filter" class="form-select deleted-filter" aria-label="Status data"><option value="false">Data aktif</option><option value="true">Data terhapus</option></select>
    <div class="toolbar-spacer"></div>
    <%- include('../partials/view-switcher') %>
    <button id="bulk-delete" class="btn btn-outline-danger d-none">Hapus terpilih</button>
    <div class="dropdown enterprise-more-actions">
      <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">More Actions</button>
      <div class="dropdown-menu dropdown-menu-end">
        <button id="export-data-xlsx" class="dropdown-item">Export XLSX</button>
        <button id="export-data-pdf" class="dropdown-item">Export PDF</button>
        <div class="dropdown-divider"></div>
        <button id="download-import-template" class="dropdown-item">Download Template Import</button>
        <button id="open-import-master" class="dropdown-item">Import dari Excel</button>
      </div>
    </div>
    <a class="btn btn-primary brand-button" href="/master-data/<%= config.slug %>/new"><%- include('../partials/icon', { name: 'plus' }) %> Tambah Baru</a>
  </section>
  <div id="entity-alert" class="alert alert-warning mx-4 mt-3 d-none" role="alert"></div>
  <section id="entity-list-root" class="table-shell entity-table-shell">
    <div class="list-table-view">
    <table id="entity-table" class="table align-middle w-100">
      <thead><tr><th><input id="select-all" class="form-check-input" type="checkbox" aria-label="Pilih semua"></th><% config.columns.forEach(col => { %><th><%= col.label %></th><% }) %><th>KELENGKAPAN</th><th>AKSI</th></tr></thead>
    </table></div><div class="list-gallery is-hidden" aria-live="polite"></div>
  </section>
</main>
<div class="modal fade" id="master-import-modal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable"><div class="modal-content">
    <div class="modal-header"><div><small class="text-uppercase text-primary fw-bold">Master Data Import</small><h2 class="modal-title fs-5">Import <%= config.label %></h2></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button></div>
    <div class="modal-body">
      <div class="alert alert-info"><strong>Gunakan template resmi.</strong> Lookup relasi memakai code, name, atau number—bukan UUID database. Data diperiksa sebelum disimpan.</div>
      <div class="d-flex flex-wrap align-items-end gap-3">
        <label class="form-label flex-grow-1 mb-0"><span>File Excel</span><input id="master-import-file" class="form-control mt-1" type="file" accept=".xlsx,.xls,.csv"></label>
        <button id="master-import-preview" class="btn btn-outline-primary" type="button">Preview &amp; Validasi</button>
      </div>
      <div id="master-import-summary" class="mt-3"></div>
      <div class="table-responsive mt-3"><table class="table table-sm align-middle" data-enterprise-table="off"><thead id="master-import-head"></thead><tbody id="master-import-body"><tr><td class="text-muted">Pilih file lalu jalankan preview.</td></tr></tbody></table></div>
    </div>
    <div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Batal</button><button id="master-import-submit" class="btn btn-primary" type="button" disabled>Import Baris Valid</button></div>
  </div></div>
</div>
<script id="entity-config" type="application/json"><%- JSON.stringify(config).replace(/</g, '\\u003c') %></script>
<% if (config.monthlyPricing) { %><script src="/js/monthly-pricing.js?v=20260908-inheritance-1"></script><% } %>
<%- include('../partials/footer') %>
